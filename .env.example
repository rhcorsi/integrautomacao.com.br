# Cloudflare Pages env vars — copy to .env locally to test the contact form
# In production, set these in CF Pages → Settings → Environment Variables.

# Public (exposed to client; goes into the HTML)
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets (never exposed to the client)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_EMAIL_TO=comercial@integrautomacao.com.br
CONTACT_EMAIL_FROM=noreply@forms.integrautomacao.com.br

# Build
NODE_VERSION=22
