# Cloudflare Pages env vars — copy to .env locally to test contact/newsletter forms
# In production, set these in CF Pages → Settings → Environment Variables.

# Public (exposed to client; goes into the HTML). Required for the
# production form; if missing, the form renders as unavailable.
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only values (never exposed to the client). Keep API keys encrypted in
# Cloudflare Pages; NEWSLETTER_CONFIRMATION_ORIGIN is non-secret but must be
# HTTPS and environment-specific.
TURNSTILE_SECRET_KEY=
RESEND_TRANSACTIONAL_API_KEY=
RESEND_SEND_API_KEY=
RESEND_CONTACTS_API_KEY=
NEWSLETTER_CONFIRMATION_ORIGIN=
# Required newsletter list model (current Resend Contacts + Segments API)
RESEND_SEGMENT_ID=
# Required preference record for explicit newsletter opt-in
RESEND_TOPIC_ID=
CONTACT_EMAIL_TO=comercial@integrautomacao.com.br
CONTACT_EMAIL_FROM=noreply@forms.integrautomacao.com.br

# Build
NODE_VERSION=22.23.2

# NEWSLETTER_DB is a D1 binding declared in wrangler.jsonc, not an env string.
