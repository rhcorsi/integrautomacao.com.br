{
  "name": "integrautomacao",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.9.8",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "test": "npm run test:workers && npm run test:node && npm run test:ui",
    "test:workers": "vitest run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "audit:routes": "node scripts/verifyRoutes.cjs",
    "audit:redirects": "node scripts/verifyRedirects.cjs",
    "audit:deploy-policy": "node scripts/verifyDeploymentPolicy.mjs .",
    "audit:terminology": "node scripts/verifyTechnicalTerminology.cjs",
    "audit:prose": "node scripts/verifyAllProse.cjs",
    "audit:utf8": "node scripts/verifyUtf8.cjs",
    "audit:faqs": "node scripts/checkTechCatalogFaqs.cjs",
    "audit:html": "node scripts/auditEditorialHtml.cjs",
    "audit:seo": "node scripts/verifySeoOutput.mjs dist",
    "audit:deps:high": "npm audit --audit-level=high",
    "audit:deps": "npm run audit:deps:high && npm audit",
    "audit:editorial": "npm run build && npm run audit:routes && npm run audit:redirects && npm run audit:terminology && npm run audit:prose && npm run audit:utf8 && npm run audit:faqs && npm run audit:html",
    "pages:dev": "wrangler pages dev dist",
    "types:generate": "wrangler types --env preview functions/types.d.ts --include-runtime=false",
    "types:check": "wrangler types --env preview functions/types.d.ts --include-runtime=false --check"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/lucide": "1.2.124",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.2.4",
    "astro-icon": "1.2.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260820.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.2",
    "happy-dom": "20.11.6",
    "typescript": "^5.7.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  }
}
