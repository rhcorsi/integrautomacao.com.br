{
  "name": "integrautomacao",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "test": "vitest run",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "audit:routes": "node scripts/verifyRoutes.cjs",
    "audit:redirects": "node scripts/verifyRedirects.cjs",
    "audit:terminology": "node scripts/verifyTechnicalTerminology.cjs",
    "audit:prose": "node scripts/verifyAllProse.cjs",
    "audit:utf8": "node scripts/verifyUtf8.cjs",
    "audit:faqs": "node scripts/checkTechCatalogFaqs.cjs",
    "audit:html": "node scripts/auditEditorialHtml.cjs",
    "audit:editorial": "npm run build && npm run audit:routes && npm run audit:redirects && npm run audit:terminology && npm run audit:prose && npm run audit:utf8 && npm run audit:faqs && npm run audit:html",
    "pages:dev": "wrangler pages dev dist",
    "types:generate": "wrangler types functions/types.d.ts --include-runtime=false",
    "types:check": "wrangler types functions/types.d.ts --include-runtime=false --check"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.120",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.5",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
