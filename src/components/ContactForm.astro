---
import { COMPANY } from "@/utils/site";
import { resolveTurnstileSiteKey } from "@/utils/turnstile";

const turnstileSiteKey = resolveTurnstileSiteKey(
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
);
const hasTurnstile = turnstileSiteKey.length > 0;
---

{hasTurnstile && (
  <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
)}

<form
  id="contact-form"
  data-contact-form
  data-turnstile-ready={hasTurnstile ? "true" : "false"}
  method="POST"
  action="/api/contact"
  class="grid gap-5"
>
  <p class="text-xs text-integra-gray-500">
    Campos marcados com <span class="font-semibold text-integra-red-700">*</span> são obrigatórios.
  </p>
  <div class="grid gap-2">
    <label for="cf-name" class="text-sm font-medium text-integra-gray-900">
      Nome completo <span class="text-integra-red" aria-hidden="true">*</span>
    </label>
    <input
      id="cf-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      minlength="2"
      maxlength="120"
      class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
    />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="grid gap-2">
      <label for="cf-email" class="text-sm font-medium text-integra-gray-900">
        E-mail corporativo <span class="text-integra-red" aria-hidden="true">*</span>
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        maxlength="180"
        class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
      />
    </div>
    <div class="grid gap-2">
      <label for="cf-phone" class="text-sm font-medium text-integra-gray-900">
        Telefone
      </label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        maxlength="40"
        class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
      />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="grid gap-2">
      <label for="cf-company" class="text-sm font-medium text-integra-gray-900">
        Empresa
      </label>
      <input
        id="cf-company"
        name="company"
        type="text"
        autocomplete="organization"
        maxlength="120"
        class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
      />
    </div>
    <div class="grid gap-2">
      <label for="cf-subject" class="text-sm font-medium text-integra-gray-900">
        Tipo de contato
      </label>
      <select
        id="cf-subject"
        name="subject"
        data-contact-subject
        class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
      >
        <option value="triagem">Triagem técnica inicial</option>
        <option value="diagnostico">Diagnóstico de engenharia</option>
        <option value="portfolio">Portfólio técnico sob NDA</option>
        <option value="plantpax">PlantPAx</option>
        <option value="factorytalk">FactoryTalk</option>
        <option value="redes-cyber">Redes Industriais / IEC 62443</option>
        <option value="migracao-plc">Migração de PLC legado</option>
        <option value="modernizacao-scada">Modernização de SCADA</option>
        <option value="dados-industriais">Dados industriais / Historian</option>
        <option value="infraestrutura-ot">Infraestrutura OT</option>
        <option value="parceria">Parceria / fornecedor</option>
        <option value="conteudo">Conteúdo técnico / evento</option>
        <option value="outro">Outro</option>
      </select>
    </div>
  </div>

  <div class="grid gap-2">
    <label for="cf-message" class="text-sm font-medium text-integra-gray-900">
      Contexto do contato <span class="text-integra-red" aria-hidden="true">*</span>
    </label>
    <p id="cf-message-help" class="text-xs leading-relaxed text-integra-gray-500">
      Se for um projeto, informe planta ou setor, sistema atual, principal risco e janela desejada. Não inclua senhas, backups ou dados sensíveis neste formulário.
    </p>
    <textarea
      id="cf-message"
      name="message"
      required
      rows="5"
      minlength="20"
      maxlength="4000"
      aria-describedby="cf-message-help"
      class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900 resize-y"
    ></textarea>
  </div>

  <!-- Ciência sobre o tratamento descrito na política, não opt-in de marketing. -->
  <label class="flex items-start gap-3 text-sm text-integra-gray-700">
    <input
      type="checkbox"
      name="lgpd"
      required
      value="1"
      class="mt-1 size-4 rounded border-integra-gray-300 text-integra-red-700 focus:ring-integra-red"
    />
    <span>
      Li e estou ciente do tratamento dos meus dados descrito na
      <a
        href="/politica-privacidade/"
        class="font-semibold text-integra-red-700 underline underline-offset-2 hover:text-integra-red-700"
      >
        Política de Privacidade
      </a> da Integra. Este contato não autoriza comunicações de marketing. <span class="text-integra-red" aria-hidden="true">*</span>
    </span>
  </label>

  <!-- Contexto de origem preservado para qualificar o atendimento. -->
  <input type="hidden" name="sourcePage" value="" data-contact-source-page />
  <input type="hidden" name="sourceLabel" value="" data-contact-source-label />
  <input type="hidden" name="cta" value="" data-contact-cta />

  <!-- Honeypot, bots fill this; humans don't see it -->
  <div aria-hidden="true" class="hidden">
    <label>
      Não preencha:
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <!-- Cloudflare Turnstile -->
  {hasTurnstile ? (
    <div
      class="cf-turnstile"
      data-sitekey={turnstileSiteKey}
      data-theme="light"
      data-action="contact-form"
    />
  ) : (
    <div
      role="alert"
      class="rounded-md border border-integra-red/30 bg-integra-red/5 p-4 text-sm leading-relaxed text-integra-gray-800"
    >
      <p class="font-semibold text-integra-gray-900">
        Formulário temporariamente indisponível.
      </p>
      <p class="mt-1">
        A verificação de segurança não foi carregada. Escreva para
        <a
          href={`mailto:${COMPANY.email}`}
          class="font-semibold text-integra-red-700 underline underline-offset-2 hover:text-integra-red-700"
        >
          {COMPANY.email}
        </a>
        ou ligue para {COMPANY.phones[0].display}.
      </p>
      <p class="mt-2 font-mono text-[11px] uppercase tracking-wider text-integra-red-700">
        Configuração ausente: PUBLIC_TURNSTILE_SITE_KEY.
      </p>
    </div>
  )}

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between pt-2">
    <p
      id="cf-status"
      role="status"
      aria-live="polite"
      class="text-sm text-integra-gray-700 min-h-[1.25rem]"
    ></p>
    <button
      type="submit"
      disabled={!hasTurnstile}
      class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-integra-white bg-integra-red hover:bg-integra-red-700 disabled:opacity-50 disabled:cursor-not-allowed rounded-md transition-colors"
    >
      Enviar contexto
      <span aria-hidden="true">→</span>
    </button>
  </div>
</form>

{hasTurnstile && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
)}

<script>
  interface ContactContext {
    cta?: string;
    createdAt?: number;
    expiresAt?: number;
    label?: string;
    page?: string;
  }

  interface TurnstileWindow extends Window {
    turnstile?: { reset: (container?: string | HTMLElement) => void };
  }

  const CONTACT_CONTEXT_KEY = "integra:contact-context";
  const CONTACT_CONTEXT_TTL_MS = 30 * 60 * 1_000;
  const contactForms =
    document.querySelectorAll<HTMLFormElement>("[data-contact-form]");

  const subjectLabels = new Map([
    ["triagem", "Triagem técnica inicial"],
    ["diagnostico", "Diagnóstico de engenharia"],
    ["portfolio", "Portfólio técnico sob NDA"],
    ["plantpax", "PlantPAx"],
    ["factorytalk", "FactoryTalk"],
    ["factorytalk-view-se", "FactoryTalk View SE"],
    ["redes-cyber", "Redes Industriais / IEC 62443"],
    ["migracao-plc", "Migração de PLC legado"],
    ["migracao-slc500", "Migração de SLC 500"],
    ["modernizacao-scada", "Modernização de SCADA"],
    ["pi-system", "PI System / dados industriais"],
    ["data-centers-industriais", "Data Centers Industriais"],
    ["acucar-e-etanol", "Automação para Açúcar e Etanol"],
    ["automacao-maringa", "Automação Industrial em Maringá"],
    ["automacao-parana", "Automação Industrial no Paraná"],
    ["servicos-automacao", "Serviços de automação industrial"],
    ["programacao-clp", "Programação de CLP"],
    ["comissionamento-industrial", "Comissionamento industrial"],
    ["catalogo-tecnico", "Catálogo técnico"],
    ["tecnologias-multivendor", "Tecnologias multivendor"],
    ["certificacoes", "Certificações e parcerias"],
    ["case-similar", "Case técnico similar"],
    ["blog", "Sugestão de conteúdo técnico"],
    ["greenfield", "Projeto greenfield"],
    ["integrador", "Integração de sistemas"],
    ["parceria", "Parceria / fornecedor"],
    ["conteudo", "Conteúdo técnico / evento"],
    ["outro", "Outro"],
  ]);

  const limit = (value: string | null | undefined, max: number) =>
    (value ?? "").trim().slice(0, max);

  const consumeStoredContactContext = (): ContactContext => {
    try {
      const value = sessionStorage.getItem(CONTACT_CONTEXT_KEY);
      sessionStorage.removeItem(CONTACT_CONTEXT_KEY);
      if (!value) return {};

      const parsed: unknown = JSON.parse(value);
      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
        return {};
      }
      const createdAt = "createdAt" in parsed ? parsed.createdAt : undefined;
      const expiresAt = "expiresAt" in parsed ? parsed.expiresAt : undefined;
      const now = Date.now();
      if (
        typeof createdAt !== "number" ||
        !Number.isFinite(createdAt) ||
        typeof expiresAt !== "number" ||
        !Number.isFinite(expiresAt) ||
        createdAt > now + 60_000 ||
        now - createdAt > CONTACT_CONTEXT_TTL_MS ||
        expiresAt < now ||
        expiresAt > createdAt + CONTACT_CONTEXT_TTL_MS
      ) {
        return {};
      }
      const context: ContactContext = { createdAt, expiresAt };
      if ("page" in parsed && typeof parsed.page === "string") {
        context.page = parsed.page;
      }
      if ("label" in parsed && typeof parsed.label === "string") {
        context.label = parsed.label;
      }
      if ("cta" in parsed && typeof parsed.cta === "string") {
        context.cta = parsed.cta;
      }
      return context;
    } catch {
      return {};
    }
  };

  const storedContext = consumeStoredContactContext();

  const labelFromSlug = (value: string) =>
    value
      .replace(/^\/+|\/+$/g, "")
      .split(/[\/-]+/)
      .filter(Boolean)
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(" ");

  const referrerContext = (): ContactContext => {
    if (!document.referrer) return { page: "", label: "Acesso direto" };

    try {
      const referrer = new URL(document.referrer);
      if (referrer.origin === window.location.origin) {
        return {
          page: `${referrer.pathname}${referrer.hash}`,
          label:
            referrer.pathname === "/"
              ? "Página inicial"
              : labelFromSlug(referrer.pathname),
        };
      }
      return {
        page: referrer.hostname,
        label: `Referência externa: ${referrer.hostname}`,
      };
    } catch {
      return { page: "", label: "Acesso direto" };
    }
  };

  const setStatus = (
    status: HTMLElement | null,
    message: string,
    tone: "error" | "info" | "success" = "info",
  ) => {
    if (!status) return;
    status.setAttribute("role", tone === "error" ? "alert" : "status");
    status.setAttribute(
      "aria-live",
      tone === "error" ? "assertive" : "polite",
    );
    status.textContent = message;
    status.classList.remove("text-integra-red-700", "text-emerald-700");
    if (tone === "error") status.classList.add("text-integra-red-700");
    if (tone === "success") status.classList.add("text-emerald-700");
  };

  const responseMessage = (value: unknown): string | undefined => {
    if (
      typeof value !== "object" ||
      value === null ||
      !("message" in value) ||
      typeof value.message !== "string"
    ) {
      return undefined;
    }
    return value.message;
  };

  for (const form of contactForms) {
    const status = form.querySelector<HTMLElement>('[role="status"]');
    const submitBtn =
      form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const subjectCandidate = form.querySelector("[data-contact-subject]");
    const subjectSelect =
      subjectCandidate instanceof HTMLSelectElement ? subjectCandidate : null;
    const sourcePageInput =
      form.querySelector<HTMLInputElement>("[data-contact-source-page]");
    const sourceLabelInput =
      form.querySelector<HTMLInputElement>("[data-contact-source-label]");
    const ctaInput =
      form.querySelector<HTMLInputElement>("[data-contact-cta]");

    const applyContactContext = () => {
      const params = new URL(window.location.href).searchParams;
      const referrer = referrerContext();
      const requestedSubject = limit(params.get("assunto"), 50)
        .toLowerCase()
        .replace(/[^a-z0-9-]/g, "");

      if (requestedSubject && subjectSelect) {
        let option = Array.from(subjectSelect.options).find(
          (candidate) => candidate.value === requestedSubject,
        );
        if (!option) {
          option = document.createElement("option");
          option.value = requestedSubject;
          option.textContent =
            subjectLabels.get(requestedSubject) ??
            `Tema técnico: ${labelFromSlug(requestedSubject)}`;
          subjectSelect.add(option);
        }
        subjectSelect.value = requestedSubject;
      }

      if (sourcePageInput) {
        sourcePageInput.value = limit(
          params.get("sourcePage") || storedContext.page || referrer.page,
          300,
        );
      }
      if (sourceLabelInput) {
        sourceLabelInput.value = limit(
          params.get("sourceLabel") || storedContext.label || referrer.label,
          160,
        );
      }
      if (ctaInput) {
        ctaInput.value = limit(params.get("cta") || storedContext.cta, 160);
      }
    };

    applyContactContext();

    form.addEventListener(
      "invalid",
      () => {
        setStatus(
          status,
          "Preencha os campos obrigatórios antes de enviar.",
          "error",
        );
      },
      true,
    );

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        setStatus(
          status,
          "Preencha os campos obrigatórios antes de enviar.",
          "error",
        );
        return;
      }

      const formData = new FormData(form);
      if (formData.get("website")) {
        setStatus(status, "Mensagem enviada.", "success");
        form.reset();
        applyContactContext();
        return;
      }

      if (!formData.get("cf-turnstile-response")) {
        setStatus(
          status,
          form.querySelector(".cf-turnstile")
            ? "Aguarde a verificação de segurança e tente novamente."
            : "Formulário temporariamente indisponível: a verificação de segurança não carregou. Use o e-mail comercial@integrautomacao.com.br.",
          "error",
        );
        return;
      }

      submitBtn?.setAttribute("disabled", "true");
      setStatus(status, "Enviando...", "info");

      try {
        const payload: Record<string, string> = {};
        for (const [key, value] of formData.entries()) {
          if (typeof value === "string") payload[key] = value;
        }
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          setStatus(
            status,
            "Contexto recebido. Nosso prazo-alvo de retorno inicial é de 1 dia útil.",
            "success",
          );
          form.reset();
          applyContactContext();
          return;
        }

        const data: unknown = await response.json().catch(() => null);
        setStatus(
          status,
          responseMessage(data) ??
            "Não foi possível enviar agora. Tente novamente em instantes ou escreva para comercial@integrautomacao.com.br.",
          "error",
        );
      } catch (error) {
        console.error(error);
        setStatus(
          status,
          "Erro de rede. Tente novamente ou escreva para comercial@integrautomacao.com.br.",
          "error",
        );
      } finally {
        submitBtn?.removeAttribute("disabled");
        (window as TurnstileWindow).turnstile?.reset();
      }
    });
  }
</script>
