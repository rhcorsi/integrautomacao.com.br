---
import { COMPANY } from "@/utils/site";
import { resolveTurnstileSiteKey } from "@/utils/turnstile";

const turnstileSiteKey = resolveTurnstileSiteKey(
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
);
const hasTurnstile = turnstileSiteKey.length > 0;
---

{hasTurnstile && (
  <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
)}

<form
  id="contact-form"
  data-contact-form
  data-turnstile-ready={hasTurnstile ? "true" : "false"}
  method="POST"
  action="/api/contact"
  class="grid gap-5"
>
  <p class="text-xs text-integra-gray-500">
    Campos marcados com <span class="font-semibold text-integra-red-700">*</span> são obrigatórios.
  </p>
  <div class="grid gap-2">
    <label for="cf-name" class="text-sm font-medium text-integra-gray-900">
      Nome completo <span class="text-integra-red" aria-hidden="true">*</span>
    </label>
    <input
      id="cf-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      minlength="2"
      maxlength="120"
      class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
    />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="grid gap-2">
      <label for="cf-email" class="text-sm font-medium text-integra-gray-900">
        E-mail corporativo <span class="text-integra-red" aria-hidden="true">*</span>
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        maxlength="180"
        class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
      />
    </div>
    <div class="grid gap-2">
      <label for="cf-phone" class="text-sm font-medium text-integra-gray-900">
        Telefone
      </label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        maxlength="40"
        class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
      />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="grid gap-2">
      <label for="cf-company" class="text-sm font-medium text-integra-gray-900">
        Empresa
      </label>
      <input
        id="cf-company"
        name="company"
        type="text"
        autocomplete="organization"
        maxlength="120"
        class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
      />
    </div>
    <div class="grid gap-2">
      <label for="cf-subject" class="text-sm font-medium text-integra-gray-900">
        Tipo de contato
      </label>
      <select
        id="cf-subject"
        name="subject"
        data-contact-subject
        class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
      >
        <option value="triagem">Triagem técnica inicial</option>
        <option value="diagnostico">Diagnóstico de engenharia</option>
        <option value="portfolio">Portfólio técnico sob NDA</option>
        <option value="plantpax">PlantPAx</option>
        <option value="factorytalk">FactoryTalk</option>
        <option value="redes-cyber">Redes Industriais / IEC 62443</option>
        <option value="migracao-plc">Migração de PLC legado</option>
        <option value="modernizacao-scada">Modernização de SCADA</option>
        <option value="dados-industriais">Dados industriais / Historian</option>
        <option value="infraestrutura-ot">Infraestrutura OT</option>
        <option value="parceria">Parceria / fornecedor</option>
        <option value="conteudo">Conteúdo técnico / evento</option>
        <option value="outro">Outro</option>
      </select>
    </div>
  </div>

  <div class="grid gap-2">
    <label for="cf-message" class="text-sm font-medium text-integra-gray-900">
      Contexto do contato <span class="text-integra-red" aria-hidden="true">*</span>
    </label>
    <p id="cf-message-help" class="text-xs leading-relaxed text-integra-gray-500">
      Se for um projeto, informe planta ou setor, sistema atual, principal risco e janela desejada. Não inclua senhas, backups ou dados sensíveis neste formulário.
    </p>
    <textarea
      id="cf-message"
      name="message"
      required
      rows="5"
      minlength="20"
      maxlength="4000"
      aria-describedby="cf-message-help"
      class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900 resize-y"
    ></textarea>
  </div>

  <!-- Ciência sobre o tratamento descrito na política, não opt-in de marketing. -->
  <label class="flex items-start gap-3 text-sm text-integra-gray-700">
    <input
      type="checkbox"
      name="lgpd"
      required
      value="1"
      class="mt-1 size-4 rounded border-integra-gray-300 text-integra-red-700 focus:ring-integra-red"
    />
    <span>
      Li e estou ciente do tratamento dos meus dados descrito na
      <a
        href="/politica-privacidade/"
        class="font-semibold text-integra-red-700 underline underline-offset-2 hover:text-integra-red-700"
      >
        Política de Privacidade
      </a> da Integra. Este contato não autoriza comunicações de marketing. <span class="text-integra-red" aria-hidden="true">*</span>
    </span>
  </label>

  <!-- Contexto de origem preservado para qualificar o atendimento. -->
  <input type="hidden" name="sourcePage" value="" data-contact-source-page />
  <input type="hidden" name="sourceLabel" value="" data-contact-source-label />
  <input type="hidden" name="cta" value="" data-contact-cta />

  <!-- Honeypot, bots fill this; humans don't see it -->
  <div aria-hidden="true" class="hidden">
    <label>
      Não preencha:
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <!-- Cloudflare Turnstile -->
  {hasTurnstile ? (
    <div
      class="cf-turnstile"
      data-sitekey={turnstileSiteKey}
      data-theme="light"
      data-action="contact-form"
    />
  ) : (
    <div
      role="alert"
      class="rounded-md border border-integra-red/30 bg-integra-red/5 p-4 text-sm leading-relaxed text-integra-gray-800"
    >
      <p class="font-semibold text-integra-gray-900">
        Formulário temporariamente indisponível.
      </p>
      <p class="mt-1">
        A verificação de segurança não foi carregada. Escreva para
        <a
          href={`mailto:${COMPANY.email}`}
          class="font-semibold text-integra-red-700 underline underline-offset-2 hover:text-integra-red-700"
        >
          {COMPANY.email}
        </a>
        ou ligue para {COMPANY.phones[0].display}.
      </p>
      <p class="mt-2 font-mono text-[11px] uppercase tracking-wider text-integra-red-700">
        Configuração ausente: PUBLIC_TURNSTILE_SITE_KEY.
      </p>
    </div>
  )}

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between pt-2">
    <p
      id="cf-status"
      role="status"
      aria-live="polite"
      class="text-sm text-integra-gray-700 min-h-[1.25rem]"
    ></p>
    <button
      type="submit"
      disabled={!hasTurnstile}
      class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-integra-white bg-integra-red hover:bg-integra-red-700 disabled:opacity-50 disabled:cursor-not-allowed rounded-md transition-colors"
    >
      Enviar contexto
      <span aria-hidden="true">→</span>
    </button>
  </div>
</form>

{hasTurnstile && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
)}

<script is:inline type="module" src="/scripts/contact-form.js"></script>
