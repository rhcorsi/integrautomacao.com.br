---
/**
 * Painel "sala de controle": diagrama de planta animado para o hero escuro.
 * Dados pulsam do campo (N0-1) até o corporativo (N4-5) atravessando a IDMZ,
 * em CSS puro (offset-path), sem JavaScript. Com prefers-reduced-motion o
 * diagrama permanece estático e completo. Tags de instrumento no padrão
 * ISA-5.1 (TT = transmissor de temperatura, FT = vazão, XV = válvula).
 */

// Caminhos dos conduítes, usados no desenho e na animação dos pulsos.
const P1 = "M140 538 V470 H180 V446";
const P2 = "M280 538 V470 H230 V446";
const P3 = "M420 538 V470 H270 V446";
const P4 = "M180 398 V366 H132 V334";
const P5 = "M230 398 V366 H284 V334";
const P6 = "M132 286 V240";
const P7 = "M436 286 V240";
const P8 = "M280 180 V136";
const PHMI = "M300 422 H340";
const PHIST = "M352 310 H368";

const pulses = [
  { path: P1, dur: "3.4s", delay: "0s" },
  { path: P2, dur: "3.4s", delay: "1.2s" },
  { path: P3, dur: "3.4s", delay: "2.3s" },
  { path: P4, dur: "3s", delay: "0.7s" },
  { path: P5, dur: "3s", delay: "1.9s" },
  { path: P6, dur: "2.6s", delay: "1s" },
  { path: P7, dur: "2.6s", delay: "2.1s" },
  { path: P8, dur: "2.6s", delay: "1.5s" },
];

const mono = "'JetBrains Mono Variable', ui-monospace, monospace";
const sans = "'Inter Variable', ui-sans-serif, system-ui, sans-serif";

const bandStroke = "#e4e4e4";
const bandFill = "#fafafa";
const nodeFill = "#ffffff";
const nodeStroke = "#c9c9c9";
const wire = "#c9c9c9";
const label = "#4a4a4a";
const labelDim = "#666666";
const white = "#1a1a1a";
const pulse = "#e30613";
const otLine = "#003a5d";
const otText = "#003a5d";
---

<div class="overflow-hidden rounded-xl border border-integra-gray-200 bg-integra-white shadow-xl">
  {/* Barra de título do painel, estilo estação de supervisão */}
  <div class="flex items-center justify-between border-b border-integra-gray-200 bg-integra-gray-50 px-4 py-2.5">
    <p class="font-mono text-[10px] uppercase tracking-widest text-integra-gray-500">
      Supervisão · visão geral da planta
    </p>
    <p class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-emerald-700">
      <span class="apd-status inline-block size-1.5 rounded-full bg-emerald-500"></span>
      operacional
    </p>
  </div>

  <svg
    viewBox="0 0 560 612"
    role="img"
    aria-labelledby="apd-title apd-desc"
    class="h-auto w-full"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="apd-title">Fluxo de dados da planta, do campo ao corporativo</title>
    <desc id="apd-desc">
      Diagrama animado em camadas: instrumentos de campo alimentam o
      controlador ControlLogix, que alimenta os servidores SCADA redundantes
      e o Historian; os dados atravessam a IDMZ por conduíte controlado até
      o ambiente corporativo. Pulsos indicam o fluxo de dados subindo pelas
      camadas.
    </desc>

    <defs>
      <filter id="apd-glow" x="-80%" y="-80%" width="260%" height="260%">
        <feGaussianBlur stdDeviation="2.4" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    {/* ── Bandas de zona ─────────────────────────────────────────── */}
    <rect x="40" y="56" width="480" height="94" rx="10" fill={bandFill} stroke={bandStroke}></rect>
    <text x="56" y="76" font-family={mono} font-size="9" letter-spacing="1.5" fill={labelDim}>N4-5 · CORPORATIVO</text>

    <rect x="40" y="180" width="480" height="60" rx="10" fill="rgba(0,58,93,0.04)" stroke={otLine} stroke-dasharray="5 4" stroke-opacity="0.45"></rect>

    <rect x="40" y="264" width="480" height="84" rx="10" fill={bandFill} stroke={bandStroke}></rect>
    <text x="56" y="281" font-family={mono} font-size="9" letter-spacing="1.5" fill={labelDim}>N3 · SUPERVISÃO E DADOS</text>

    <rect x="40" y="376" width="480" height="84" rx="10" fill={bandFill} stroke={bandStroke}></rect>
    <text x="56" y="393" font-family={mono} font-size="9" letter-spacing="1.5" fill={labelDim}>N2 · CONTROLE</text>

    <rect x="40" y="488" width="480" height="108" rx="10" fill={bandFill} stroke={bandStroke}></rect>
    <text x="56" y="505" font-family={mono} font-size="9" letter-spacing="1.5" fill={labelDim}>N0-1 · CAMPO · INSTRUMENTAÇÃO</text>

    {/* ── Conduítes ──────────────────────────────────────────────── */}
    <g fill="none" stroke={wire} stroke-width="1.5">
      <path d={P1}></path>
      <path d={P2}></path>
      <path d={P3}></path>
      <path d={P4}></path>
      <path d={P5}></path>
      <path d={P6}></path>
      <path d={P7}></path>
      <path d={P8}></path>
      <path d={PHMI}></path>
      <path d={PHIST}></path>
    </g>

    {/* ── Corporativo ────────────────────────────────────────────── */}
    <rect x="180" y="92" width="200" height="44" rx="8" fill={nodeFill} stroke={nodeStroke}></rect>
    <text x="280" y="112" font-family={sans} font-size="13" font-weight="600" fill={white} text-anchor="middle">ERP · BI · nuvem</text>
    <text x="280" y="127" font-family={mono} font-size="8.5" fill={labelDim} text-anchor="middle">camada de decisão</text>

    {/* ── IDMZ ───────────────────────────────────────────────────── */}
    <g transform="translate(196, 198)">
      <rect width="26" height="16" rx="2.5" fill="none" stroke={otText} stroke-width="1.2"></rect>
      <line x1="2" y1="5.5" x2="24" y2="5.5" stroke={otText} stroke-width="0.8"></line>
      <line x1="2" y1="10.5" x2="24" y2="10.5" stroke={otText} stroke-width="0.8"></line>
      <line x1="9" y1="0.5" x2="9" y2="5.5" stroke={otText} stroke-width="0.8"></line>
      <line x1="17" y1="5.5" x2="17" y2="10.5" stroke={otText} stroke-width="0.8"></line>
    </g>
    <text x="232" y="210" font-family={mono} font-size="10" letter-spacing="1.5" fill={otText}>IDMZ · CONDUÍTE CONTROLADO</text>
    <text x="232" y="226" font-family={mono} font-size="8.5" fill="#4a6d85">sem caminho direto TI ⇄ chão de fábrica</text>

    {/* ── Supervisão ─────────────────────────────────────────────── */}
    {[
      { x: 64, name: "SCADA A", sub: "redundante" },
      { x: 216, name: "SCADA B", sub: "redundante" },
      { x: 368, name: "Historian", sub: "dados de processo" },
    ].map((n) => (
      <g>
        <rect x={n.x} y="286" width="136" height="48" rx="8" fill={nodeFill} stroke={nodeStroke}></rect>
        <text x={n.x + 68} y="308" font-family={sans} font-size="13" font-weight="600" fill={white} text-anchor="middle">{n.name}</text>
        <text x={n.x + 68} y="324" font-family={mono} font-size="8.5" fill={labelDim} text-anchor="middle">{n.sub}</text>
      </g>
    ))}

    {/* ── Controle ───────────────────────────────────────────────── */}
    <rect x="120" y="398" width="180" height="48" rx="8" fill={nodeFill} stroke={nodeStroke}></rect>
    <text x="210" y="420" font-family={sans} font-size="13" font-weight="600" fill={white} text-anchor="middle">ControlLogix · PAC</text>
    <text x="210" y="436" font-family={mono} font-size="8.5" fill={labelDim} text-anchor="middle">controle de processo</text>

    <rect x="340" y="398" width="120" height="48" rx="8" fill={nodeFill} stroke={nodeStroke}></rect>
    <text x="400" y="420" font-family={sans} font-size="13" font-weight="600" fill={white} text-anchor="middle">HMI local</text>
    <text x="400" y="436" font-family={mono} font-size="8.5" fill={labelDim} text-anchor="middle">operação</text>

    {/* ── Campo ──────────────────────────────────────────────────── */}
    {[
      { x: 140, tag: "TT-101" },
      { x: 280, tag: "FT-202" },
      { x: 420, tag: "XV-303" },
    ].map((s) => (
      <g>
        <circle class="apd-ring" cx={s.x} cy="556" r="18" fill="none" stroke={pulse} stroke-width="1" opacity="0.6"></circle>
        <circle cx={s.x} cy="556" r="18" fill={nodeFill} stroke={nodeStroke}></circle>
        <circle class="apd-status" cx={s.x} cy="556" r="4" fill={pulse}></circle>
        <text x={s.x} y="590" font-family={mono} font-size="9.5" fill={label} text-anchor="middle">{s.tag}</text>
      </g>
    ))}

    {/* ── Pulsos de dados (CSS offset-path; invisíveis sem animação) ── */}
    {pulses.map((p) => (
      <circle
        class="apd-dot"
        r="3"
        fill={pulse}
        filter="url(#apd-glow)"
        style={`--apd-path: path('${p.path}'); --apd-dur: ${p.dur}; --apd-delay: ${p.delay};`}
      ></circle>
    ))}
    {/* Comando descendo: supervisão -> controlador */}
    <circle
      class="apd-dot apd-dot-down"
      r="3"
      fill="#4a4a4a"
      filter="url(#apd-glow)"
      style={`--apd-path: path('${P4}'); --apd-dur: 3.8s; --apd-delay: 2.8s;`}
    ></circle>
  </svg>
</div>

<style>
  .apd-dot {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .apd-dot {
      offset-path: var(--apd-path);
      offset-rotate: 0deg;
      animation: apd-flow var(--apd-dur, 3s) linear infinite;
      animation-delay: var(--apd-delay, 0s);
    }
    .apd-dot-down {
      animation-direction: reverse;
    }
    .apd-ring {
      animation: apd-ping 3.2s ease-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    .apd-status {
      animation: apd-blink 2.4s ease-in-out infinite;
    }
  }

  @keyframes apd-flow {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  @keyframes apd-ping {
    0% {
      transform: scale(0.65);
      opacity: 0.7;
    }
    75% {
      transform: scale(1.45);
      opacity: 0;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }

  @keyframes apd-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>
