---
import { COMPANY } from "@/utils/site";
import { resolveTurnstileSiteKey } from "@/utils/turnstile";

const turnstileSiteKey = resolveTurnstileSiteKey(
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
);
const hasTurnstile = turnstileSiteKey.length > 0;
---

{hasTurnstile && (
  <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
)}

<form
  id="newsletter-form"
  data-newsletter-form
  data-contact-email={COMPANY.email}
  data-turnstile-ready={hasTurnstile ? "true" : "false"}
  method="POST"
  action="/api/newsletter"
  class="grid gap-5"
>
  <p class="text-xs text-integra-gray-500">
    Campos marcados com <span class="font-semibold text-integra-red">*</span> são obrigatórios.
  </p>
  <div class="grid gap-2">
    <label for="nl-name" class="text-sm font-medium text-integra-gray-900">
      Nome <span class="text-integra-red" aria-hidden="true">*</span>
    </label>
    <input
      id="nl-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      minlength="2"
      maxlength="120"
      class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/40 text-integra-gray-900"
    />
  </div>

  <div class="grid gap-2">
    <label for="nl-email" class="text-sm font-medium text-integra-gray-900">
      E-mail <span class="text-integra-red" aria-hidden="true">*</span>
    </label>
    <input
      id="nl-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      maxlength="180"
      class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/40 text-integra-gray-900"
    />
  </div>

  <!-- LGPD opt-in -->
  <label class="flex items-start gap-3 text-sm text-integra-gray-700">
    <input
      type="checkbox"
      name="lgpd"
      required
      value="1"
      class="mt-1 size-4 rounded border-integra-gray-300 text-integra-red-700 focus:ring-integra-red"
    />
    <span>
      Concordo em receber a newsletter Integra Ação e com o tratamento dos meus
      dados conforme a
      <a
        href="/politica-privacidade/"
        class="font-semibold text-integra-red-700 underline underline-offset-2 hover:text-integra-red-700"
      >
        Política de Privacidade
      </a>. Posso cancelar a inscrição a qualquer momento. <span class="text-integra-red" aria-hidden="true">*</span>
    </span>
  </label>

  <!-- Honeypot -->
  <div aria-hidden="true" class="hidden">
    <label>
      Não preencha:
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <!-- Cloudflare Turnstile. Fallback oculto revelado se o api.js for
       bloqueado (ad-blocker) — ver ContactForm. -->
  {hasTurnstile ? (
    <>
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-theme="light"
        data-action="newsletter-form"
      />
      <div
        data-turnstile-fallback
        hidden
        role="alert"
        class="rounded-md border border-integra-red/30 bg-integra-red/5 p-4 text-sm leading-relaxed text-integra-gray-800"
      >
        <p class="font-semibold text-integra-gray-900">
          Verificação de segurança bloqueada pelo navegador.
        </p>
        <p class="mt-1">
          Desative o bloqueador de conteúdo para este site ou escreva para
          <a
            href={`mailto:${COMPANY.email}?subject=Inscri%C3%A7%C3%A3o%20newsletter%20Integra%20A%C3%A7%C3%A3o`}
            class="font-semibold text-integra-red-700 underline underline-offset-2 hover:text-integra-red-700"
          >
            {COMPANY.email}
          </a>
          para inscrição manual.
        </p>
      </div>
    </>
  ) : (
    <div
      role="alert"
      class="rounded-md border border-integra-red/30 bg-integra-red/5 p-4 text-sm leading-relaxed text-integra-gray-800"
    >
      <p class="font-semibold text-integra-gray-900">
        Inscrição temporariamente indisponível.
      </p>
      <p class="mt-1">
        A verificação de segurança não foi carregada. Escreva para
        <a
          href={`mailto:${COMPANY.email}?subject=Inscri%C3%A7%C3%A3o%20newsletter%20Integra%20A%C3%A7%C3%A3o`}
          class="font-semibold text-integra-red-700 underline underline-offset-2 hover:text-integra-red-700"
        >
          {COMPANY.email}
        </a>
        para inscrição manual.
      </p>
    </div>
  )}

  {/* Sem JavaScript o fetch não roda e a API só aceita JSON. */}
  <noscript>
    <div class="rounded-md border border-integra-gray-300 bg-integra-gray-50 p-4 text-sm leading-relaxed text-integra-gray-800">
      <p class="font-semibold text-integra-gray-900">
        A inscrição exige JavaScript.
      </p>
      <p class="mt-1">
        Escreva para
        <a
          href={`mailto:${COMPANY.email}?subject=Inscri%C3%A7%C3%A3o%20newsletter%20Integra%20A%C3%A7%C3%A3o`}
          class="font-semibold text-integra-red-700 underline underline-offset-2"
        >
          {COMPANY.email}
        </a>
        para inscrição manual.
      </p>
    </div>
  </noscript>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between pt-2">
    <p
      id="nl-status"
      data-form-status
      role="status"
      aria-live="polite"
      class="text-sm text-integra-gray-700 min-h-[1.25rem]"
    ></p>
    <button
      type="submit"
      disabled={!hasTurnstile}
      class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-integra-white bg-integra-red hover:bg-integra-red-700 disabled:opacity-50 disabled:cursor-not-allowed rounded-md transition-colors"
    >
      Inscrever-se
      <span aria-hidden="true">→</span>
    </button>
  </div>
</form>

<script>
  import {
    FORM_FETCH_TIMEOUT_MS,
    ensureTurnstileScript,
    networkErrorMessage,
    responseMessage,
    setFormStatus,
    turnstileRendered,
    watchTurnstileBlocked,
    type TurnstileWindow,
  } from "@/utils/webform";

  const newsletterForms =
    document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]");

  // Carrega o api.js uma única vez (deduplicado entre contato e newsletter).
  if (
    document.querySelector(
      '[data-newsletter-form][data-turnstile-ready="true"]',
    )
  ) {
    ensureTurnstileScript();
  }

  for (const form of newsletterForms) {
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submitBtn =
      form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const contactEmail =
      form.dataset.contactEmail ?? "comercial@integrautomacao.com.br";

    // Ad-blocker bloqueia challenges.cloudflare.com: revela o fallback.
    watchTurnstileBlocked(form, () => {
      const container = form.querySelector<HTMLElement>(".cf-turnstile");
      const fallback = form.querySelector<HTMLElement>(
        "[data-turnstile-fallback]",
      );
      if (container) container.hidden = true;
      if (fallback) fallback.hidden = false;
    });

    form.addEventListener(
      "invalid",
      () => {
        setFormStatus(
          status,
          "Preencha os campos obrigatórios antes de enviar.",
          "error",
        );
      },
      true,
    );

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        setFormStatus(
          status,
          "Preencha os campos obrigatórios antes de enviar.",
          "error",
        );
        return;
      }

      const formData = new FormData(form);
      if (formData.get("website")) {
        setFormStatus(status, "Inscrição registrada.", "success");
        form.reset();
        return;
      }

      if (!formData.get("cf-turnstile-response")) {
        // Widget renderizado = desafio em andamento; sem iframe = bloqueado.
        setFormStatus(
          status,
          turnstileRendered(form)
            ? "Aguarde a verificação de segurança e tente novamente."
            : `A verificação de segurança não carregou (bloqueador de conteúdo?). Escreva para ${contactEmail}.`,
          "error",
        );
        return;
      }

      submitBtn?.setAttribute("disabled", "true");
      setFormStatus(status, "Processando…", "info");

      try {
        const payload: Record<string, string> = {};
        for (const [key, value] of formData.entries()) {
          if (typeof value === "string") payload[key] = value;
        }
        const response = await fetch("/api/newsletter", {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
          signal: AbortSignal.timeout(FORM_FETCH_TIMEOUT_MS),
        });

        if (response.ok) {
          setFormStatus(
            status,
            "Inscrição confirmada. Você receberá as próximas edições publicadas.",
            "success",
          );
          form.reset();
          return;
        }

        const data: unknown = await response.json().catch(() => null);
        setFormStatus(
          status,
          responseMessage(data) ??
            `Não foi possível inscrever agora. Tente novamente em instantes ou escreva para ${contactEmail}.`,
          "error",
        );
      } catch (error) {
        console.error(error);
        setFormStatus(status, networkErrorMessage(contactEmail), "error");
      } finally {
        submitBtn?.removeAttribute("disabled");
        (window as TurnstileWindow).turnstile?.reset();
      }
    });
  }
</script>
