---
import { COMPANY } from "@/utils/site";
import { resolveTurnstileSiteKey } from "@/utils/turnstile";

const turnstileSiteKey = resolveTurnstileSiteKey(
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
);
const hasTurnstile = turnstileSiteKey.length > 0;
---

{hasTurnstile && (
  <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
)}

<form
  id="newsletter-form"
  data-newsletter-form
  data-turnstile-ready={hasTurnstile ? "true" : "false"}
  method="POST"
  action="/api/newsletter"
  class="grid gap-5"
>
  <p class="text-xs text-integra-gray-500">
    Campos marcados com <span class="font-semibold text-integra-red-700">*</span> são obrigatórios.
  </p>
  <div class="grid gap-2">
    <label for="nl-name" class="text-sm font-medium text-integra-gray-900">
      Nome <span class="text-integra-red" aria-hidden="true">*</span>
    </label>
    <input
      id="nl-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      minlength="2"
      maxlength="120"
      class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
    />
  </div>

  <div class="grid gap-2">
    <label for="nl-email" class="text-sm font-medium text-integra-gray-900">
      E-mail <span class="text-integra-red" aria-hidden="true">*</span>
    </label>
    <input
      id="nl-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      maxlength="180"
      class="px-4 py-3 rounded-md border border-integra-gray-300 bg-integra-white focus:outline-none focus:border-integra-gray-900 focus:ring-2 focus:ring-integra-red/20 text-integra-gray-900"
    />
  </div>

  <!-- LGPD opt-in -->
  <label class="flex items-start gap-3 text-sm text-integra-gray-700">
    <input
      type="checkbox"
      name="lgpd"
      required
      value="1"
      class="mt-1 size-4 rounded border-integra-gray-300 text-integra-red-700 focus:ring-integra-red"
    />
    <span>
      Concordo em receber a newsletter Integra Ação e com o tratamento dos meus
      dados conforme a
      <a
        href="/politica-privacidade/"
        class="font-semibold text-integra-red-700 underline underline-offset-2 hover:text-integra-red-700"
      >
        Política de Privacidade
      </a>. Posso cancelar a inscrição a qualquer momento. <span class="text-integra-red" aria-hidden="true">*</span>
    </span>
  </label>

  <!-- Honeypot -->
  <div aria-hidden="true" class="hidden">
    <label>
      Não preencha:
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <!-- Cloudflare Turnstile -->
  {hasTurnstile ? (
    <div
      class="cf-turnstile"
      data-sitekey={turnstileSiteKey}
      data-theme="light"
      data-action="newsletter-form"
    />
  ) : (
    <div
      role="alert"
      class="rounded-md border border-integra-red/30 bg-integra-red/5 p-4 text-sm leading-relaxed text-integra-gray-800"
    >
      <p class="font-semibold text-integra-gray-900">
        Inscrição temporariamente indisponível.
      </p>
      <p class="mt-1">
        A verificação de segurança não foi carregada. Escreva para
        <a
          href={`mailto:${COMPANY.email}?subject=Inscri%C3%A7%C3%A3o%20newsletter%20Integra%20A%C3%A7%C3%A3o`}
          class="font-semibold text-integra-red-700 underline underline-offset-2 hover:text-integra-red-700"
        >
          {COMPANY.email}
        </a>
        para inscrição manual.
      </p>
    </div>
  )}

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between pt-2">
    <p
      id="nl-status"
      role="status"
      aria-live="polite"
      class="text-sm text-integra-gray-700 min-h-[1.25rem]"
    ></p>
    <button
      type="submit"
      disabled={!hasTurnstile}
      class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-integra-white bg-integra-red hover:bg-integra-red-700 disabled:opacity-50 disabled:cursor-not-allowed rounded-md transition-colors"
    >
      Inscrever-se
      <span aria-hidden="true">→</span>
    </button>
  </div>
</form>

{hasTurnstile && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
)}

<script>
  interface NewsletterTurnstileWindow extends Window {
    turnstile?: { reset: (container?: string | HTMLElement) => void };
  }

  const newsletterForms =
    document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]");

  const setNewsletterStatus = (
    status: HTMLElement | null,
    message: string,
    tone: "error" | "info" | "success" = "info",
  ) => {
    if (!status) return;
    status.setAttribute("role", tone === "error" ? "alert" : "status");
    status.setAttribute(
      "aria-live",
      tone === "error" ? "assertive" : "polite",
    );
    status.textContent = message;
    status.classList.remove("text-integra-red-700", "text-emerald-700");
    if (tone === "error") status.classList.add("text-integra-red-700");
    if (tone === "success") status.classList.add("text-emerald-700");
  };

  const responseMessage = (value: unknown): string | undefined => {
    if (
      typeof value !== "object" ||
      value === null ||
      !("message" in value) ||
      typeof value.message !== "string"
    ) {
      return undefined;
    }
    return value.message;
  };

  for (const form of newsletterForms) {
    const status = form.querySelector<HTMLElement>('[role="status"]');
    const submitBtn =
      form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener(
      "invalid",
      () => {
        setNewsletterStatus(
          status,
          "Preencha os campos obrigatórios antes de enviar.",
          "error",
        );
      },
      true,
    );

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        setNewsletterStatus(
          status,
          "Preencha os campos obrigatórios antes de enviar.",
          "error",
        );
        return;
      }

      const formData = new FormData(form);
      if (formData.get("website")) {
        setNewsletterStatus(status, "Inscrição registrada.", "success");
        form.reset();
        return;
      }

      if (!formData.get("cf-turnstile-response")) {
        setNewsletterStatus(
          status,
          form.querySelector(".cf-turnstile")
            ? "Aguarde a verificação de segurança e tente novamente."
            : "Inscrição temporariamente indisponível: a verificação de segurança não carregou. Use o e-mail comercial@integrautomacao.com.br.",
          "error",
        );
        return;
      }

      submitBtn?.setAttribute("disabled", "true");
      setNewsletterStatus(status, "Processando…", "info");

      try {
        const payload: Record<string, string> = {};
        for (const [key, value] of formData.entries()) {
          if (typeof value === "string") payload[key] = value;
        }
        const response = await fetch("/api/newsletter", {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          setNewsletterStatus(
            status,
            "Inscrição confirmada. Você receberá as próximas edições publicadas.",
            "success",
          );
          form.reset();
          return;
        }

        const data: unknown = await response.json().catch(() => null);
        setNewsletterStatus(
          status,
          responseMessage(data) ??
            "Não foi possível inscrever agora. Tente novamente em instantes ou escreva para comercial@integrautomacao.com.br.",
          "error",
        );
      } catch (error) {
        console.error(error);
        setNewsletterStatus(
          status,
          "Erro de rede. Tente novamente ou escreva para comercial@integrautomacao.com.br.",
          "error",
        );
      } finally {
        submitBtn?.removeAttribute("disabled");
        (window as NewsletterTurnstileWindow).turnstile?.reset();
      }
    });
  }
</script>
