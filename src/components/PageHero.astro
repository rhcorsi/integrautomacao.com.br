---
/**
 * PageHero.astro — cabeçalho padrão das páginas internas.
 *
 * Cabeçalho claro com tipografia de marca, linha lateral de acento e
 * breadcrumb visual sincronizado com o JSON-LD. Vermelho é o acento padrão;
 * azul-OT permanece reservado a temas de cibersegurança.
 *
 * Uso simples:
 *   <PageHero eyebrow="Blog técnico" title="..." breadcrumbLeaf="Blog" />
 * Com coluna lateral:
 *   <PageHero ...><ManualReference slot="aside" ... /></PageHero>
 * Conteúdo extra (badges, CTAs) vai no slot default, após a descrição.
 */
import Breadcrumbs from "@/components/Breadcrumbs.astro";

interface Props {
  eyebrow: string;
  /** Título em texto puro. Para títulos com trechos em destaque, use o
      slot name="title" (o prop torna-se apenas fallback). */
  title?: string;
  description?: string;
  /** Acento da seção: red (padrão) ou ot (cibersegurança/redes). */
  accent?: "red" | "ot";
  /** Folha curta do breadcrumb visual — usar o mesmo valor do
      breadcrumbLeaf passado ao BaseLayout. */
  breadcrumbLeaf?: string;
  variant?: "compact" | "editorial" | "solution";
}

const {
  eyebrow,
  title,
  description,
  accent = "red",
  breadcrumbLeaf,
  variant = "editorial",
} = Astro.props;

const hasAside = Astro.slots.has("aside");
const eyebrowColor = accent === "ot" ? "text-integra-ot" : "text-integra-red-700";
---

<section class="relative isolate overflow-hidden border-b border-integra-gray-200 bg-integra-gray-100">
  <div class:list={["pointer-events-none absolute inset-y-0 left-0 w-1", accent === "ot" ? "bg-integra-ot" : "bg-integra-red"]} aria-hidden="true"></div>

  <div class:list={["container-fluid", variant === "compact" ? "py-7 lg:py-10" : variant === "solution" ? "py-12 lg:py-16" : "py-10 lg:py-14"]}>
    {breadcrumbLeaf && <Breadcrumbs leaf={breadcrumbLeaf} />}

    <div
      class:list={[
        "grid gap-10",
        hasAside && "lg:grid-cols-[0.95fr_1.05fr] lg:items-end",
      ]}
    >
      <div>
        <p
          class:list={[
            "mb-3 text-xs font-sans uppercase tracking-widest",
            eyebrowColor,
          ]}
        >
          {eyebrow}
        </p>
        <h1 class:list={["max-w-4xl font-extrabold tracking-tight text-integra-gray-900", variant === "compact" ? "text-3xl sm:text-4xl" : "text-4xl sm:text-5xl"]}>
          <slot name="title">{title}</slot>
        </h1>
        {description && (
          <p class:list={["max-w-3xl leading-relaxed text-integra-gray-700", variant === "compact" ? "mt-4 text-base" : "mt-5 text-lg lg:text-xl"]}>
            {description}
          </p>
        )}
        <slot />
      </div>

      {hasAside && (
        <div>
          <slot name="aside" />
        </div>
      )}
    </div>
  </div>
</section>
