---
interface Props {
  title?: string;
  items: string[];
  /** When true, render as compact two-column grid */
  twoColumn?: boolean;
}

const { title = "O que você recebe", items, twoColumn = false } = Astro.props;
---

<section class="my-10">
  <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-5">
    {title}
  </h3>
  <ul
    class:list={[
      "space-y-2.5",
      twoColumn && "sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-2.5 sm:space-y-0",
    ]}
  >
    {items.map((item) => (
      <li class="flex items-start gap-3 text-sm text-integra-gray-900">
        <span
          class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-integra-gray-900 text-integra-white text-[10px]"
          aria-hidden="true"
        >
          ✓
        </span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</section>
