---
interface Props {
  title?: string;
  description?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  variant?: "light" | "dark";
}

const {
  title = "Quer avaliar o próximo passo com a engenharia?",
  description = "A triagem inicial verifica contexto, aderência e próximo passo. Quando o caso exige levantamento ou diagnóstico documentado, o escopo é definido separadamente antes do início.",
  primaryCta = { href: "/contato?assunto=triagem", label: "Solicitar triagem técnica" },
  secondaryCta = { href: "/cases", label: "Ver cases" },
  variant = "dark",
} = Astro.props;

const isDark = variant === "dark";

const withContactContext = (
  item: { href: string; label: string },
  sourceLabel: string,
) => {
  if (!item.href.startsWith("/contato")) return item.href;

  const url = new URL(item.href, Astro.url);
  if (!url.searchParams.has("sourcePage")) {
    url.searchParams.set("sourcePage", Astro.url.pathname.slice(0, 300));
  }
  if (!url.searchParams.has("sourceLabel")) {
    url.searchParams.set("sourceLabel", sourceLabel.slice(0, 160));
  }
  if (!url.searchParams.has("cta")) {
    url.searchParams.set("cta", item.label.slice(0, 160));
  }

  return `${url.pathname}?${url.searchParams.toString()}${url.hash}`;
};

const primaryHref = withContactContext(primaryCta, title);
const secondaryHref = secondaryCta
  ? withContactContext(secondaryCta, title)
  : undefined;
---

<section
  class:list={[
    "border-y",
    isDark
      ? "bg-integra-gray-950 border-integra-gray-950"
      : "bg-integra-gray-50 border-integra-gray-200",
  ]}
>
  <div class="container-fluid py-16 lg:py-20 grid gap-8 lg:grid-cols-3 lg:items-center">
    <div class="lg:col-span-2">
      <h2
        class:list={[
          "text-2xl font-semibold sm:text-3xl",
          isDark ? "text-integra-white" : "text-integra-gray-900",
        ]}
      >
        {title}
      </h2>
      <p
        class:list={[
          "mt-4 text-base leading-relaxed lg:text-lg max-w-2xl",
          isDark ? "text-integra-gray-300" : "text-integra-gray-700",
        ]}
      >
        {description}
      </p>
    </div>
    <div class="flex flex-col sm:flex-row lg:flex-col gap-3 lg:items-end lg:justify-self-end">
      <a
        href={primaryHref}
        class="inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-semibold text-integra-white bg-integra-red hover:bg-integra-red-700 rounded-md transition-colors"
      >
        {primaryCta.label}
        <span aria-hidden="true">→</span>
      </a>
      {secondaryCta && (
        <a
          href={secondaryHref}
          class:list={[
            "inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-semibold rounded-md transition-colors",
            isDark
              ? "text-integra-white border border-integra-gray-700 hover:border-integra-white"
              : "text-integra-gray-900 border border-integra-gray-300 hover:border-integra-gray-900",
          ]}
        >
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>
