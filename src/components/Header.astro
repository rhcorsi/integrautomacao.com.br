---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import logoColorido from "@/assets/logos/Colorido.png";
import EmailLink from "@/components/EmailLink.astro";
import { NAV, MEGA_MENUS, COMPANY, type MegaMenu } from "@/utils/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");

const phoneCommercial = COMPANY.phones[0];

// Build dynamic mega-menus for Cases and Blog from content collections.
// Static list-based, so the header re-renders on every page (Astro caches
// the import); no extra round trips at runtime.
const recentCases = (await getCollection("cases", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

const allEventos = (await getCollection("eventos", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const dynamicMegas: Record<string, MegaMenu> = {
  "/cases": {
    intro: { title: "Ver todos os cases", href: "/cases" },
    columns: [
      {
        title: "Cases publicados",
        links: recentCases.length > 0
          ? recentCases.map((c) => ({
              href: `/cases/${c.slug}/`,
              label: c.data.title,
              description: c.data.sector,
            }))
          : [{ href: "/cases", label: "Cases sendo publicados gradualmente" }],
      },
      {
        title: "Setores com cases",
        links: Array.from(
          new Set(recentCases.map((c) => c.data.sector)),
        )
          .slice(0, 5)
          .map((s) => ({
            href: "/setores",
            label: s,
          })),
      },
    ],
    promo: {
      eyebrow: "Sob NDA",
      title: "Portfólio detalhado em reunião técnica",
      description:
        "Apresentamos cases não publicados em reunião, mediante acordo de confidencialidade quando o projeto exigir.",
      cta: { href: "/contato?assunto=portfolio", label: "Solicitar portfólio" },
    },
    quickLinks: [
      { href: "/solucoes", label: "Ver soluções" },
      { href: "/setores", label: "Por setor industrial" },
      { href: "/certificacoes", label: "Certificações" },
      { href: "/contato?assunto=portfolio", label: "Solicitar portfólio sob NDA" },
    ],
  },

  "/blog": {
    intro: { title: "Ver todos os artigos", href: "/blog" },
    columns: [
      {
        title: "Artigos recentes",
        links: recentPosts.length > 0
          ? recentPosts.map((p) => ({
              href: `/blog/${p.slug}/`,
              label: p.data.title,
              description: p.data.tags.slice(0, 2).join(" · "),
            }))
          : [{ href: "/blog", label: "Em breve" }],
      },
      {
        title: "Integra Ação",
        links: [
          {
            href: "/integra-acao/",
            label: "Hub Integra Ação",
            description: "Marca guarda-chuva de conteúdo técnico",
          },
          {
            href: "/integra-acao/newsletter/",
            label: "Newsletter mensal",
            description: "Inscrever-se · curadoria técnica em PT-BR",
          },
          {
            href: "/integra-acao/webinar/",
            label: "Webinars técnicos",
            description: "Sessões mensais · 45-60 min · com Q&A",
          },
          {
            href: "/eventos/",
            label: "Eventos presenciais",
            description: "Onde a equipe Integra esteve recentemente",
          },
        ],
      },
      {
        title: "Eventos",
        links: allEventos.length > 0
          ? [
              ...allEventos.map((e) => ({
                href: `/eventos/${e.slug}/`,
                label: e.data.title,
                description: e.data.dateLabel,
              })),
              { href: "/eventos", label: "Ver todos os eventos →" },
            ]
          : [{ href: "/eventos", label: "Ver todos os eventos" }],
      },
    ],
    promo: {
      eyebrow: "Sugira um tema",
      title: "Tem uma dúvida técnica de planta?",
      description:
        "Sugestões de artigos vindas de quem está em campo são bem-vindas, frequentemente viram pauta.",
      cta: { href: "/contato?assunto=blog", label: "Sugerir tema" },
    },
    quickLinks: [
      { href: "/integra-acao/newsletter/", label: "Inscrever-se na newsletter" },
      { href: "/integra-acao/", label: "Hub Integra Ação" },
      { href: "/eventos", label: "Ver eventos presenciais" },
      { href: "/rss.xml", label: "RSS feed" },
    ],
  },
};

const allMegas: Record<string, MegaMenu> = {
  ...MEGA_MENUS,
  ...dynamicMegas,
};
---

<header class="sticky top-0 z-50 bg-integra-white shadow-sm">
  <!-- Top utility bar -->
  <div class="hidden lg:block bg-integra-gray-50 border-b border-integra-gray-200">
    <div class="container-fluid flex h-9 items-center justify-between text-xs">
      <div class="flex items-center gap-1.5 text-integra-gray-600">
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="font-mono uppercase tracking-wider text-[11px]">Maringá-PR · Atuação nacional</span>
      </div>
      <nav aria-label="Links secundários" class="flex items-center divide-x divide-integra-gray-300">
        <a href="/empresa#timeline" class="px-3 text-integra-gray-700 hover:text-integra-gray-900 transition-colors">Sobre</a>
        <a href={COMPANY.social.linkedin} rel="noopener noreferrer" class="px-3 text-integra-gray-700 hover:text-integra-gray-900 transition-colors">LinkedIn</a>
        <EmailLink email={COMPANY.email} class="px-3 text-integra-gray-700 hover:text-integra-gray-900 transition-colors">{COMPANY.email}</EmailLink>
        <a href={`tel:${phoneCommercial.value.replace(/\s+/g, "")}`} class="pl-3 text-integra-gray-900 font-medium hover:text-integra-red-700 transition-colors">{phoneCommercial.display}</a>
      </nav>
    </div>
  </div>

  <!-- Main header bar -->
  <div class="border-b border-integra-gray-200">
    <div class="container-fluid flex h-20 items-center gap-8 lg:h-28">
      <a
        href="/"
        class="flex items-center gap-2 shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-integra-red rounded-sm"
        aria-label="Página inicial Integra Automação Industrial"
      >
        <Image
          src={logoColorido}
          alt="Integra Automação Industrial"
          class="h-16 w-auto lg:h-20"
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 480px, 320px"
          loading="eager"
          decoding="async"
        />
      </a>

      <nav class="hidden min-[1440px]:flex items-center gap-1 ml-auto" aria-label="Principal">
        {NAV.map(({ href, label }) => {
          const mega = allMegas[href];
          if (!mega) {
            return (
              <a
                href={href}
                class:list={[
                  "px-3 py-2 text-[13px] font-bold uppercase tracking-wider rounded-md transition-colors",
                  isActive(href)
                    ? "text-integra-red-700"
                    : "text-integra-gray-900 hover:text-integra-red-700",
                ]}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            );
          }
          // Item with mega-menu
          const menuIntro = {
            title: label === "Blog" ? "Ver tudo no Blog" : `Ver tudo em ${label}`,
            href: mega.intro?.href ?? href,
          };
          return (
            <div class="group/menu">
              <a
                href={href}
                class:list={[
                  "inline-flex items-center gap-1 px-3 py-2 text-[13px] font-bold uppercase tracking-wider rounded-md transition-colors",
                  "group-hover/menu:text-integra-red-700 group-focus-within/menu:text-integra-red-700",
                  isActive(href)
                    ? "text-integra-red-700"
                    : "text-integra-gray-900 hover:text-integra-red-700",
                ]}
                aria-current={isActive(href) ? "page" : undefined}
                aria-haspopup="true"
                aria-expanded="false"
              >
                {label}
                <svg class="size-3.5 opacity-60 transition-transform group-hover/menu:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              {/* Bridge: keeps the full-width menu open while the cursor leaves the nav item. */}
              <div
                class="fixed inset-x-0 top-[7rem] z-[59] h-9 invisible pointer-events-none group-hover/menu:visible group-hover/menu:pointer-events-auto group-focus-within/menu:visible group-focus-within/menu:pointer-events-auto"
                aria-hidden="true"
              />
              <div
                class:list={[
                  "fixed inset-x-0 top-[9.25rem] z-[60]",
                  "invisible opacity-0 -translate-y-1 pointer-events-none transition-all duration-150",
                  "group-hover/menu:visible group-hover/menu:opacity-100 group-hover/menu:translate-y-0 group-hover/menu:pointer-events-auto",
                  "group-focus-within/menu:visible group-focus-within/menu:opacity-100 group-focus-within/menu:translate-y-0 group-focus-within/menu:pointer-events-auto",
                ]}
              >
                <div class="relative border-y border-integra-gray-200 bg-integra-white shadow-2xl">
                  {/* "Ver tudo em X" CTA, top-right corner, stays fixed above scroll area */}
                  <a
                    href={menuIntro.href}
                    class="absolute top-4 right-6 lg:right-10 xl:right-12 z-20 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono uppercase tracking-widest text-integra-gray-900 hover:text-integra-white bg-integra-gray-50 hover:bg-integra-red border border-integra-gray-200 hover:border-integra-red rounded-full transition-colors"
                  >
                    {menuIntro.title} <span aria-hidden="true">→</span>
                  </a>
                  {/* Scrollable inner area, capped at ~36rem to keep all popups visually consistent.
                      On shorter viewports, falls back to viewport height minus header + chrome. */}
                  <div class="overflow-y-auto max-h-[min(36rem,calc(100vh-13rem))]">
                  <div class:list={[
                    "container-wide grid gap-8 py-8",
                    mega.promo ? "xl:grid-cols-[minmax(0,1fr)_22rem]" : "grid-cols-1",
                  ]}>
                    <div class="grid gap-x-10 gap-y-8 [grid-template-columns:repeat(auto-fit,minmax(13rem,1fr))]">
                      {mega.columns.map((col) => (
                        <div>
                          <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-4">
                            {col.title}
                          </p>
                          <ul class="space-y-3">
                            {col.links.map((link) => (
                              <li>
                                <a
                                  href={link.href}
                                  class="group/link block hover:text-integra-red-700"
                                >
                                  <span class="text-sm font-medium text-integra-gray-900 group-hover/link:text-integra-red-700 transition-colors">
                                    {link.label}
                                  </span>
                                  {link.description && (
                                    <span class="block text-xs text-integra-gray-500 mt-0.5">
                                      {link.description}
                                    </span>
                                  )}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                    {mega.promo && (
                      <aside class="border-l border-integra-gray-200 pl-8">
                        <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
                          {mega.promo.eyebrow}
                        </p>
                        {mega.promo.imageSrc && (
                          <img
                            src={mega.promo.imageSrc}
                            alt=""
                            class="h-12 w-auto mb-4"
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                        <h3 class="text-base font-semibold text-integra-gray-900 mb-2 leading-snug">
                          {mega.promo.title}
                        </h3>
                        <p class="text-sm leading-relaxed text-integra-gray-700 mb-4">
                          {mega.promo.description}
                        </p>
                        <a
                          href={mega.promo.cta.href}
                          class="inline-flex items-center gap-1.5 text-sm font-semibold text-integra-red-700 hover:text-integra-red-700"
                        >
                          {mega.promo.cta.label}
                          <span aria-hidden="true">→</span>
                        </a>
                      </aside>
                    )}
                  </div>
                  </div> {/* /scrollable inner area */}
                  {mega.quickLinks && mega.quickLinks.length > 0 && (
                    <div class="bg-integra-gray-50 border-t border-integra-gray-200">
                      <div class="container-wide py-3 flex flex-wrap items-center gap-x-8 gap-y-2">
                        {mega.quickLinks.map((q) => (
                          <a
                            href={q.href}
                            class="text-sm font-medium text-integra-gray-900 hover:text-integra-red-700 transition-colors"
                          >
                            {q.label} <span aria-hidden="true">→</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </nav>

      <a
        href="/contato"
        class="hidden min-[1440px]:inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-integra-white bg-integra-red hover:bg-integra-red-700 rounded-md transition-colors shrink-0"
      >
        Falar com especialista
        <span aria-hidden="true">→</span>
      </a>

      <button
        type="button"
        class="min-[1440px]:hidden ml-auto p-2 -mr-2 text-integra-gray-700 hover:text-integra-gray-900"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg
          class="block h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
            data-icon-open
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
            class="hidden"
            data-icon-close
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav: absolutely positioned beneath the header bar, scrollable when content overflows. -->
  <nav
    id="mobile-nav"
    class="min-[1440px]:hidden hidden absolute inset-x-0 top-full max-h-[calc(100vh-5rem)] overflow-y-auto overscroll-contain border-t border-integra-gray-200 bg-integra-white shadow-lg"
    aria-label="Principal (mobile)"
  >
    <div class="container-default py-4 pb-8 grid gap-1">
      {NAV.map(({ href, label }) => {
        const mega = allMegas[href];
        if (!mega) {
          return (
            <a
              href={href}
              class:list={[
                "px-3 py-2.5 text-sm font-bold uppercase tracking-wider rounded-md transition-colors",
                isActive(href)
                  ? "text-integra-red-700 bg-integra-red/5"
                  : "text-integra-gray-900 hover:bg-integra-gray-100",
              ]}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          );
        }
        return (
          <details class="group">
            <summary class:list={[
              "flex items-center justify-between px-3 py-2.5 text-sm font-bold uppercase tracking-wider rounded-md cursor-pointer list-none",
              isActive(href)
                ? "text-integra-red-700 bg-integra-red/5"
                : "text-integra-gray-900 hover:bg-integra-gray-100",
            ]}>
              <span>{label}</span>
              <svg class="size-4 opacity-60 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="pl-4 pb-2 space-y-3 mt-1">
              <a href={href} class="block px-3 py-2 text-sm font-semibold text-integra-red-700">Ver tudo →</a>
              {mega.columns.map((col) => (
                <div>
                  <p class="px-3 text-xs font-mono uppercase tracking-widest text-integra-gray-500 mt-2 mb-1">
                    {col.title}
                  </p>
                  {col.links.map((link) => (
                    <a href={link.href} class="block px-3 py-1.5 text-sm text-integra-gray-700 hover:text-integra-red-700">
                      {link.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </details>
        );
      })}
      <a
        href="/contato"
        class="mt-3 inline-flex items-center justify-center gap-2 px-4 py-3 text-base font-semibold text-integra-white bg-integra-red hover:bg-integra-red-700 rounded-md"
      >
        Falar com especialista
      </a>
    </div>
  </nav>
</header>

<script is:inline type="module" src="/scripts/header-menu.js"></script>
