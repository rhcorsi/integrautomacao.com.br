---
/**
 * Data/intervalo de eventos com <time datetime> para início E fim.
 *
 * Regra editorial do projeto (audit:html): toda data do JSON-LD do evento
 * (startDate/endDate) precisa ter um <time datetime> visível correspondente
 * cujo texto seja a data completa ("1 de outubro de 2025"). Por isso este
 * componente NÃO colapsa ranges no mesmo mês — o colapso ("1–2 de outubro")
 * só é usado em cards sem schema vinculado (formatEventDateRange).
 */
import { formatEventDate, isoEventDate } from "@/utils/eventDate";

interface Props {
  startDate: Date;
  endDate?: Date;
}

const { startDate, endDate = startDate } = Astro.props;
const isRange = isoEventDate(startDate) !== isoEventDate(endDate);
---

<time datetime={isoEventDate(startDate)}>{formatEventDate(startDate)}</time>
{isRange && (
  <>
    <span aria-hidden="true"> a </span>
    <span class="sr-only">até </span>
    <time datetime={isoEventDate(endDate)}>{formatEventDate(endDate)}</time>
  </>
)}
