---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { publicSourceFor } from "@/data/sourceRegistry";

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  source: string;
  caption: string;
  theme?: "light" | "dark" | "ot";
  loading?: "lazy" | "eager";
}

const {
  image,
  alt,
  eyebrow = "Referência técnica pública",
  title,
  source,
  caption,
  theme = "light",
  loading = "lazy",
} = Astro.props;

const dark = theme === "dark";
const eyebrowColor = theme === "ot" ? "text-integra-ot" : "text-integra-red-700";
const publicSource = publicSourceFor(source);
---

<figure
  class:list={[
    "overflow-hidden rounded-lg border shadow-xl",
    dark
      ? "border-white/10 bg-integra-gray-950 text-integra-white"
      : "border-integra-gray-200 bg-integra-white text-integra-gray-900",
  ]}
>
  <div class={dark ? "bg-integra-gray-950 p-4" : "bg-integra-gray-50 p-4"}>
    <p
      class:list={[
        "mb-2 font-mono text-[11px] uppercase tracking-widest",
        dark ? "text-integra-red-300" : eyebrowColor,
      ]}
    >
      {eyebrow}
    </p>
    <p class:list={["text-base font-semibold leading-snug", dark ? "text-white" : "text-integra-gray-900"]}>
      {title}
    </p>
  </div>

  <div class:list={[
    "flex aspect-[16/9] items-center justify-center",
    dark ? "bg-white" : "bg-integra-white",
  ]}>
    <Image
      src={image}
      alt={alt}
      widths={[800, 1200, 1600, 2000]}
      sizes="(min-width: 1024px) 800px, 100vw"
      loading={loading}
      fetchpriority={loading === "eager" ? "high" : undefined}
      decoding="async"
      class="h-full w-full object-contain"
    />
  </div>

  <figcaption
    class:list={[
      "space-y-2 border-t p-4 text-xs leading-relaxed",
      dark
        ? "border-white/10 text-white/65"
        : "border-integra-gray-200 text-integra-gray-600",
    ]}
  >
    <p>{caption}</p>
    <p class:list={["font-mono uppercase tracking-wider", dark ? "text-white/80" : "text-integra-gray-700"]}>
      Fonte: {source}
      {publicSource && (
        <>
          {" · "}
          <a
            href={publicSource.href}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2 hover:no-underline"
          >
            abrir fonte primária
          </a>
          {` · acesso em ${publicSource.accessedAt}`}
        </>
      )}
    </p>
  </figcaption>
</figure>
