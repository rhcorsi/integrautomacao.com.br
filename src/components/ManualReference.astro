---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { publicSourceFor } from "@/data/sourceRegistry";
import { randomUUID } from "node:crypto";

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  source: string;
  caption: string;
  theme?: "light" | "dark" | "ot";
  loading?: "lazy" | "eager";
  /** Ajustar ao tamanho real de exibição do card no layout — o default
      (~800px de coluna) superfete imagens em grids de 2-3 colunas. */
  sizes?: string;
  /** Candidatos de largura; alinhar com `sizes`. */
  widths?: number[];
}

const {
  image,
  alt,
  eyebrow = "Referência técnica pública",
  title,
  source,
  caption,
  theme = "light",
  loading = "lazy",
  sizes = "(min-width: 1024px) 800px, 100vw",
  widths = [800, 1200, 1600, 2000],
} = Astro.props;

const dark = theme === "dark";
const eyebrowColor = theme === "ot" ? "text-integra-ot" : "text-integra-red-700";
const publicSource = publicSourceFor(source);
const dialogTitleId = `figure-${randomUUID()}`;
---

<figure
  data-manual-reference="true"
  class:list={[
    "overflow-hidden rounded-sm border border-t-2 shadow-none",
    dark
      ? "brand-dark border-white/25 border-t-integra-red bg-integra-gray-950 text-integra-white"
      : "border-integra-gray-200 border-t-integra-red bg-integra-white text-integra-gray-900",
  ]}
>
  <div class={dark ? "bg-integra-gray-950 p-4" : "bg-integra-gray-50 p-4"}>
    <p
      class:list={[
        "mb-2 font-sans text-[11px] uppercase tracking-widest",
        dark ? "text-integra-gray-100" : eyebrowColor,
      ]}
    >
      {eyebrow}
    </p>
    <p class:list={["text-base font-semibold leading-snug", dark ? "text-white" : "text-integra-gray-900"]}>
      {title}
    </p>
  </div>

  {/* Fundo branco mesmo no tema dark: os manuais têm fundo claro e
      precisam de palco neutro para leitura. */}
  <div class="flex aspect-[16/9] items-center justify-center bg-integra-white">
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === "eager" ? "high" : undefined}
      decoding="async"
      class="h-full w-full object-contain"
    />
  </div>

  <a
    data-figure-open
    href={image.src}
    aria-label={`Ampliar figura: ${title}`}
    class:list={["flex min-h-11 items-center justify-between border-t px-4 py-3 text-sm font-semibold underline underline-offset-4", dark ? "border-white/10 text-white" : "border-integra-gray-200 text-integra-red-700"]}
  >
    Ampliar figura <span aria-hidden="true">↗</span>
  </a>
  <dialog aria-labelledby={dialogTitleId} class="manual-dialog" data-pagefind-ignore>
    <div class="manual-dialog-heading">
      <p id={dialogTitleId}>{title}</p>
      <button type="button" data-figure-close autofocus>Fechar <span aria-hidden="true">×</span></button>
    </div>
    <div class="manual-dialog-image" tabindex="0" role="region" aria-label="Figura completa; role para consultar os detalhes">
      <img src={image.src} alt={alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
    </div>
    <div class="manual-dialog-caption">
      <p>{caption}</p>
      <p>Fonte: {source}{publicSource && <> · <a href={publicSource.href} target="_blank" rel="noopener noreferrer">{publicSource.linkLabel}</a></>}</p>
    </div>
  </dialog>
  <figcaption
    class:list={[
      "space-y-2 border-t p-4 text-xs leading-relaxed",
      dark
        ? "border-white/10 text-white/65"
        : "border-integra-gray-200 text-integra-gray-600",
    ]}
  >
    <p>{caption}</p>
    <p class:list={["font-sans uppercase tracking-wider", dark ? "text-white/80" : "text-integra-gray-700"]}>
      Fonte: {source}
      {publicSource && (
        <>
          {" · "}
          {/* aria-label com a fonte: vários cards na mesma página compartilham
              o mesmo linkLabel — sem ele, links idênticos levariam a destinos
              diferentes (falha de práticas recomendadas do Lighthouse). */}
          <a
            href={publicSource.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${publicSource.linkLabel} — ${source}`}
            class="underline underline-offset-2 hover:no-underline"
          >
            {publicSource.linkLabel}
          </a>
          {` · acesso em ${publicSource.accessedAt}`}
        </>
      )}
    </p>
  </figcaption>

</figure>

<script>
  import { initManualFigures } from "@/scripts/manualFigures";
  initManualFigures();
</script>
<style>
  .manual-dialog { width: min(96vw, 100rem); max-width: 96vw; max-height: 94dvh; padding: 0; margin: auto; border: 1px solid var(--color-integra-gray-300); border-radius: .125rem; background: white; color: var(--color-integra-gray-900); --focus-color: var(--color-integra-red); }
  .manual-dialog::backdrop { background: rgb(0 0 0 / .75); }
  .manual-dialog-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid var(--color-integra-gray-200); background: var(--color-integra-gray-100); font-weight: 600; }
  .manual-dialog-heading button { flex-shrink: 0; min-height: 44px; padding: .5rem 1rem; border: 1px solid var(--color-integra-gray-500); border-radius: .125rem; cursor: pointer; }
  .manual-dialog-image { overflow: auto; max-height: 65dvh; background: white; }
  .manual-dialog-image img { display: block; width: auto; max-width: none; min-width: 100%; height: auto; }
  .manual-dialog-caption { padding: 1rem; font-size: .8rem; line-height: 1.6; }
  .manual-dialog-caption a { text-decoration: underline; text-underline-offset: .2em; }
</style>
