---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  heroImage?: ImageMetadata;
  heroAlt?: string;
  /** "dark" transforma o hero em painel de sala de controle. */
  variant?: "light" | "dark";
  /** Linha de status mono no rodapé do hero (fatos verificáveis). */
  statusLine?: string;
}

const {
  eyebrow = "Engenharia com Integridade",
  title,
  highlight,
  description,
  primaryCta = { href: "/contato/", label: "Falar com especialista" },
  secondaryCta = { href: "/solucoes/", label: "Ver soluções" },
  heroImage,
  heroAlt = "",
  variant = "light",
  statusLine,
} = Astro.props;

const dark = variant === "dark";

const primaryHref = primaryCta.href;
const secondaryHref = secondaryCta.href;
---

<section
  class:list={[
    "brand-hero relative isolate overflow-hidden border-b",
    dark
      ? "brand-dark border-integra-gray-800 bg-premium-dark text-integra-white"
      : "border-integra-gray-200 bg-integra-gray-100",
  ]}
>
  <div class="hero-line pointer-events-none absolute inset-x-0 top-8 -z-10 border-t" aria-hidden="true"></div>
  <div class="pointer-events-none absolute right-0 bottom-0 -z-10 h-32 w-4 bg-integra-red lg:h-2/3 lg:w-6" aria-hidden="true"></div>

  <div class="container-fluid py-12 lg:py-20">
    <div
      class="grid gap-10 items-center lg:grid-cols-[1.08fr_0.92fr] lg:gap-12"
    >
      <div>
        <p
          class:list={[
            "inline-flex items-center gap-3 border-l-2 px-3 py-1.5 text-[11px] font-sans uppercase tracking-wider mb-6",
            dark
              ? "border-integra-red text-integra-gray-100"
              : "border-integra-red text-integra-gray-700",
          ]}
        >
          <span class="size-1.5 bg-integra-red" aria-hidden="true"></span>
          {eyebrow}
        </p>
        <h1
          class:list={[
            "text-4xl font-extrabold tracking-tight sm:text-5xl xl:text-6xl leading-[1.08]",
            dark ? "text-white" : "text-integra-gray-900",
          ]}
        >
          {title}{" "}
          {highlight && (
            <span class:list={["block sm:inline", dark ? "text-integra-gray-100" : "text-integra-red"]}>{highlight}</span>
          )}
        </h1>
        <p
          class:list={[
            "mt-8 text-lg leading-relaxed max-w-xl lg:text-xl",
            dark ? "text-integra-gray-300" : "text-integra-gray-700",
          ]}
        >
          {description}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={primaryHref}
            class:list={[
              "group inline-flex items-center gap-2 px-7 py-3.5 text-sm font-semibold rounded-sm transition-colors",
              "text-integra-white bg-integra-red hover:bg-integra-red-700",
            ]}
          >
            {primaryCta.label}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a
            href={secondaryHref}
            class:list={[
              "inline-flex items-center gap-2 px-7 py-3.5 text-sm font-semibold rounded-sm transition-colors border",
              dark
                ? "text-white border-white/25 hover:border-white/60"
                : "text-integra-gray-900 bg-integra-white border-integra-gray-300 hover:border-integra-gray-900",
            ]}
          >
            {secondaryCta.label}
          </a>
        </div>
        <slot />
        {statusLine && (
          <p
            class:list={[
              "mt-6 font-sans text-[11px] uppercase tracking-wider",
              dark ? "text-integra-gray-400" : "text-integra-gray-500",
            ]}
          >
            <span
              aria-hidden="true"
              class={dark ? "text-integra-white" : "text-integra-red-700"}
            >//</span>
            {" "}{statusLine}
          </p>
        )}
      </div>

      <slot name="media">
        {heroImage && (
          <div class="relative">
            <div class="relative overflow-hidden rounded-sm shadow-sm ring-1 ring-integra-gray-900/10 bg-integra-white">
              <Image
                src={heroImage}
                alt={heroAlt}
                widths={[800, 1200, 1600, 2000]}
                sizes="(min-width: 1024px) 800px, 100vw"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-auto object-contain aspect-[16/9]"
              />
            </div>
          </div>
        )}
      </slot>
    </div>
  </div>
</section>

<style>
  .hero-line { border-color: var(--color-integra-gray-300); }
  .brand-dark .hero-line { border-color: rgb(243 240 241 / .18); }
  .brand-dark :global(form[role="search"] label) { color: var(--color-integra-gray-100); }
  .brand-dark :global(form[role="search"] input) { color: var(--color-integra-gray-900); }
  .brand-dark :global(form[role="search"] input:focus-visible) { outline-color: var(--color-integra-red); }
</style>
