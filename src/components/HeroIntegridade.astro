---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  heroImage?: ImageMetadata;
  heroAlt?: string;
  /** "dark" transforma o hero em painel de sala de controle. */
  variant?: "light" | "dark";
  /** Linha de status mono no rodapé do hero (fatos verificáveis). */
  statusLine?: string;
}

const {
  eyebrow = "Engenharia com Integridade",
  title,
  highlight,
  description,
  primaryCta = { href: "/contato/", label: "Falar com especialista" },
  secondaryCta = { href: "/solucoes/", label: "Ver soluções" },
  heroImage,
  heroAlt = "",
  variant = "light",
  statusLine,
} = Astro.props;

const dark = variant === "dark";
const gridColor = dark ? "rgba(255,255,255,0.06)" : "var(--color-integra-gray-900)";
const hatchColor = dark ? "rgba(227,6,19,0.16)" : "rgba(227,6,19,0.08)";

const primaryHref = primaryCta.href;
const secondaryHref = secondaryCta.href;
---

<section
  class:list={[
    "relative overflow-hidden border-b",
    dark
      ? "border-integra-gray-800 bg-premium-dark text-integra-white"
      : "border-integra-gray-200 bg-integra-white",
  ]}
>
  <div
    class:list={[
      "pointer-events-none absolute inset-0 -z-10",
      dark ? "opacity-100" : "opacity-[0.04]",
    ]}
    aria-hidden="true"
    style={`background-image: linear-gradient(${gridColor} 1px, transparent 1px), linear-gradient(90deg, ${gridColor} 1px, transparent 1px); background-size: 64px 64px;`}
  >
  </div>
  <div
    class:list={[
      "pointer-events-none absolute right-0 top-0 -z-10 h-full w-1/3 border-l",
      dark ? "border-white/5" : "border-integra-gray-200/70",
    ]}
    aria-hidden="true"
    style={`background-image: linear-gradient(135deg, ${hatchColor} 0, ${hatchColor} 1px, transparent 1px, transparent 18px);`}
  >
  </div>

  <div class="container-fluid py-20 lg:py-28">
    <div
      class="grid gap-12 items-center lg:grid-cols-[1.1fr_1fr] lg:gap-16"
    >
      <div>
        <p
          class:list={[
            "inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-mono uppercase tracking-widest mb-8",
            dark
              ? "border-white/15 bg-white/5 text-integra-gray-300"
              : "border-integra-gray-200 bg-integra-gray-50 text-integra-gray-700",
          ]}
        >
          <span class="hero-status-dot size-1.5 rounded-full bg-integra-red"></span>
          {eyebrow}
        </p>
        <h1
          class:list={[
            "text-5xl font-semibold tracking-tight sm:text-6xl lg:text-7xl",
            dark ? "text-white" : "text-integra-gray-900",
          ]}
        >
          {title}{" "}
          {highlight && (
            <span class="text-integra-red">{highlight}</span>
          )}
        </h1>
        <p
          class:list={[
            "mt-8 text-lg leading-relaxed max-w-xl lg:text-xl",
            dark ? "text-integra-gray-300" : "text-integra-gray-700",
          ]}
        >
          {description}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={primaryHref}
            class:list={[
              "group inline-flex items-center gap-2 px-7 py-3.5 text-sm font-semibold rounded-md transition-colors",
              dark
                ? "text-integra-white bg-integra-red hover:bg-integra-red-700"
                : "text-integra-white bg-integra-gray-900 hover:bg-integra-black",
            ]}
          >
            {primaryCta.label}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a
            href={secondaryHref}
            class:list={[
              "inline-flex items-center gap-2 px-7 py-3.5 text-sm font-semibold rounded-md transition-colors border",
              dark
                ? "text-white border-white/25 hover:border-white/60"
                : "text-integra-gray-900 bg-integra-white border-integra-gray-300 hover:border-integra-gray-900",
            ]}
          >
            {secondaryCta.label}
          </a>
        </div>
        {statusLine && (
          <p
            class:list={[
              "mt-10 font-mono text-xs uppercase tracking-widest",
              dark ? "text-integra-gray-500" : "text-integra-gray-500",
            ]}
          >
            <span
              aria-hidden="true"
              class={dark ? "text-integra-red-300" : "text-integra-red-700"}
            >//</span>
            {" "}{statusLine}
          </p>
        )}
      </div>

      <slot name="media">
        {heroImage && (
          <div class="relative">
            <div class="relative overflow-hidden rounded-lg shadow-2xl ring-1 ring-integra-gray-900/10 bg-integra-white">
              <Image
                src={heroImage}
                alt={heroAlt}
                widths={[800, 1200, 1600, 2000]}
                sizes="(min-width: 1024px) 800px, 100vw"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-auto object-contain aspect-[16/9]"
              />
            </div>
          </div>
        )}
      </slot>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-status-dot {
      animation: hero-blink 2.4s ease-in-out infinite;
    }
  }
  @keyframes hero-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>
