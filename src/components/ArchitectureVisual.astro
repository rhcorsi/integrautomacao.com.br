---
interface Props {
  variant?: "hero" | "plantpax" | "factorytalk" | "ot" | "data" | "migration" | "industrial";
  title?: string;
  caption?: string;
  theme?: "light" | "dark" | "ot";
}

const {
  variant = "hero",
  title,
  caption,
  theme = variant === "ot" ? "ot" : "light",
} = Astro.props;

const isDark = theme === "dark" || theme === "ot";

const copy = {
  hero: {
    eyebrow: "Arquitetura Integrada",
    title: title ?? "Controle, supervisão, dados e segurança no mesmo mapa",
    caption:
      caption ??
      "Diagrama autoral baseado em práticas públicas de arquitetura industrial, redes CPwE, PlantPAx e FactoryTalk.",
  },
  plantpax: {
    eyebrow: "PlantPAx DCS",
    title: title ?? "Referência de arquitetura PlantPAx por camadas",
    caption:
      caption ??
      "A Integra dimensiona cada camada antes da engenharia: controladores, servidores, supervisão, historian, alarmes e handover.",
  },
  factorytalk: {
    eyebrow: "FactoryTalk Suite",
    title: title ?? "Suíte integrada para supervisão, ativos, dados e operação",
    caption:
      caption ??
      "O desenho mostra como View SE, Optix, Batch, Historian, AssetCentre e ThinManager deixam de ser ilhas e passam a operar com governança comum.",
  },
  ot: {
    eyebrow: "CPwE · IEC 62443",
    title: title ?? "Segmentação OT com zonas, conduítes e IDMZ",
    caption:
      caption ??
      "Modelo autoral inspirado em Purdue/CPwE: cada zona tem regras claras de acesso, tráfego permitido e responsabilidades de segurança.",
  },
  data: {
    eyebrow: "PI System · AVEVA",
    title: title ?? "Da tag bruta ao contexto operacional confiável",
    caption:
      caption ??
      "Dados industriais só viram decisão quando têm qualidade, contexto, templates e governança de mudança.",
  },
  migration: {
    eyebrow: "Modernização PLC",
    title: title ?? "Migração faseada de PLC5/SLC500 para Logix",
    caption:
      caption ??
      "A modernização é planejada por risco operacional: inventário, espelho, testes, cutover e suporte pós-startup.",
  },
  industrial: {
    eyebrow: "Planta crítica",
    title: title ?? "Governança técnica para operação contínua",
    caption:
      caption ??
      "Visão sintética de como arquitetura, documentação e suporte reduzem risco operacional em ambientes 24/7.",
  },
}[variant];

const nodeBase =
  "rounded-md border px-3 py-2 text-xs leading-snug shadow-sm backdrop-blur-sm";
const nodeTone = isDark
  ? "border-white/15 bg-white/8 text-white"
  : "border-integra-gray-200 bg-integra-white text-integra-gray-800";
const mutedTone = isDark ? "text-white/65" : "text-integra-gray-500";
const lineTone = isDark ? "bg-white/20" : "bg-integra-gray-300";
---

<figure
  class:list={[
    "relative overflow-hidden rounded-lg border p-4 shadow-xl",
    isDark
      ? "border-white/10 bg-integra-gray-950 text-integra-white"
      : "border-integra-gray-200 bg-integra-gray-50 text-integra-gray-900",
  ]}
>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.05]"
    aria-hidden="true"
    style="background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(90deg, currentColor 1px, transparent 1px); background-size: 28px 28px;"
  >
  </div>

  <div class="relative">
    <header class="mb-4 flex items-start justify-between gap-4">
      <div>
        <p
          class:list={[
            "mb-1 font-mono text-[11px] uppercase tracking-widest",
            theme === "ot" ? "text-sky-200" : "text-integra-red",
          ]}
        >
          {copy.eyebrow}
        </p>
        <h3
          class:list={[
            "max-w-xl text-base font-semibold leading-snug",
            isDark ? "text-white" : "text-integra-gray-900",
          ]}
        >
          {copy.title}
        </h3>
      </div>
      <span
        class:list={[
          "hidden rounded-sm border px-2 py-1 font-mono text-[10px] uppercase tracking-widest sm:inline-flex",
          isDark
            ? "border-white/15 text-white/55"
            : "border-integra-gray-300 text-integra-gray-500",
        ]}
      >
        Integra
      </span>
    </header>

    {
      variant === "hero" && (
        <div class="space-y-3">
          <div class={`${nodeBase} ${nodeTone}`}>
            <div class="flex items-center justify-between gap-3">
              <strong>Enterprise / ERP / BI</strong>
              <span class={`font-mono text-[10px] uppercase ${mutedTone}`}>
                decisão
              </span>
            </div>
          </div>
          <div class={`mx-auto h-5 w-px ${lineTone}`} />
          <div class="grid gap-3 md:grid-cols-[1fr_auto_1fr]">
            <div class={`${nodeBase} ${nodeTone}`}>
              <strong>Historians e dados</strong>
              <p class={`mt-1 ${mutedTone}`}>PI / AVEVA · AF Templates · qualidade de tags</p>
            </div>
            <div class="flex items-center justify-center">
              <span class="rounded-sm bg-integra-red px-2 py-1 font-mono text-[10px] uppercase tracking-widest text-white">
                IDMZ
              </span>
            </div>
            <div class={`${nodeBase} ${nodeTone}`}>
              <strong>Governança OT</strong>
              <p class={`mt-1 ${mutedTone}`}>IEC 62443 · logs · acesso remoto controlado</p>
            </div>
          </div>
          <div class={`mx-auto h-5 w-px ${lineTone}`} />
          <div class="grid gap-3 md:grid-cols-3">
            {["FactoryTalk View SE", "PlantPAx Library", "AssetCentre"].map((label) => (
              <div class={`${nodeBase} ${nodeTone}`}>
                <strong>{label}</strong>
                <p class={`mt-1 ${mutedTone}`}>padrão · auditoria · operação</p>
              </div>
            ))}
          </div>
          <div class={`mx-auto h-5 w-px ${lineTone}`} />
          <div class="grid gap-3 md:grid-cols-4">
            {["ControlLogix", "Drives", "Instrumentos", "Redes DLR/PRP"].map((label) => (
              <div class={`${nodeBase} ${nodeTone}`}>
                <strong>{label}</strong>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      variant === "plantpax" && (
        <div class="space-y-4">
          <div class="grid gap-3 sm:grid-cols-3">
            {[
              ["PASS / PASS-C", "servidor de aplicação e serviços"],
              ["OWS / EWS", "operação e engenharia"],
              ["Historian", "dados de processo contextualizados"],
            ].map(([label, desc]) => (
              <div class={`${nodeBase} ${nodeTone}`}>
                <strong>{label}</strong>
                <p class={`mt-1 ${mutedTone}`}>{desc}</p>
              </div>
            ))}
          </div>
          <div class="rounded-md border border-integra-red/40 bg-integra-red/10 p-3">
            <div class="grid gap-3 sm:grid-cols-4">
              {["HMI Objects", "Alarmes", "Faceplates", "Templates"].map((label) => (
                <span class="rounded-sm bg-integra-red px-2 py-1 text-center font-mono text-[10px] uppercase tracking-wider text-white">
                  {label}
                </span>
              ))}
            </div>
          </div>
          <div class="grid gap-3 sm:grid-cols-[1fr_1fr_1fr]">
            {[
              ["Controlador P", "lógica de processo e biblioteca"],
              ["EtherNet/IP", "rede de controle com segmentação"],
              ["I/O e campo", "motores, válvulas, instrumentos"],
            ].map(([label, desc]) => (
              <div class={`${nodeBase} ${nodeTone}`}>
                <strong>{label}</strong>
                <p class={`mt-1 ${mutedTone}`}>{desc}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      variant === "factorytalk" && (
        <div class="grid gap-3 md:grid-cols-2">
          {[
            ["View SE / Optix", "supervisão, telas, mobilidade industrial"],
            ["Batch", "receitas, fases, equipamentos e ISA-88"],
            ["Historian", "coleta, retenção e consulta de dados"],
            ["AssetCentre", "auditoria, backup e versionamento"],
            ["ThinManager", "clientes industriais e acesso por função"],
            ["Services Platform", "Directory, Security, Policy, Activation"],
          ].map(([label, desc]) => (
            <div class={`${nodeBase} ${nodeTone}`}>
              <strong>{label}</strong>
              <p class={`mt-1 ${mutedTone}`}>{desc}</p>
            </div>
          ))}
        </div>
      )
    }

    {
      variant === "ot" && (
        <div class="space-y-3">
          {[
            ["L5/L4", "Enterprise", "ERP · AD · internet · e-mail"],
            ["L3.5", "IDMZ", "jump server · historian mirror · patch staging"],
            ["L3/L2", "Industrial Zone", "SCADA · Historian · engineering · servers"],
            ["L1/L0", "Cell/Area", "PLCs · I/O · drives · safety · instruments"],
          ].map(([level, label, desc], i) => (
            <div class="grid gap-2 sm:grid-cols-[72px_1fr]">
              <span class="flex items-center justify-center rounded-sm border border-sky-200/25 bg-sky-300/10 px-2 py-2 font-mono text-xs text-sky-100">
                {level}
              </span>
              <div class={`${nodeBase} ${nodeTone}`}>
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <strong>{label}</strong>
                  {i === 1 && (
                    <span class="rounded-sm bg-integra-red px-2 py-0.5 font-mono text-[10px] uppercase text-white">
                      conduíte controlado
                    </span>
                  )}
                </div>
                <p class={`mt-1 ${mutedTone}`}>{desc}</p>
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      variant === "data" && (
        <div class="space-y-3">
          {[
            ["01", "Coleta", "OPC UA · interfaces · buffers · timestamp"],
            ["02", "Qualidade", "validação, compressão, exceção e perda"],
            ["03", "Contexto", "AF Templates · ativos · hierarquia da planta"],
            ["04", "Consumo", "dashboards, eventos, manutenção e produção"],
          ].map(([n, label, desc]) => (
            <div class="grid gap-3 sm:grid-cols-[44px_1fr]">
              <span class="flex items-center justify-center rounded-sm bg-integra-red font-mono text-xs font-semibold text-white">
                {n}
              </span>
              <div class={`${nodeBase} ${nodeTone}`}>
                <strong>{label}</strong>
                <p class={`mt-1 ${mutedTone}`}>{desc}</p>
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      variant === "migration" && (
        <div class="grid gap-3 sm:grid-cols-5">
          {[
            ["Inventário", "I/O, lógica, rede, riscos"],
            ["Espelho", "ambiente de testes e compatibilidade"],
            ["Conversão", "lógica, tags, telas e alarmes"],
            ["Cutover", "janela, rollback, SAT"],
            ["Suporte", "start-up e handover"],
          ].map(([label, desc], i) => (
            <div class={`${nodeBase} ${nodeTone}`}>
              <span class="mb-2 block font-mono text-[10px] uppercase tracking-widest text-integra-red">
                0{i + 1}
              </span>
              <strong>{label}</strong>
              <p class={`mt-1 ${mutedTone}`}>{desc}</p>
            </div>
          ))}
        </div>
      )
    }

    {
      variant === "industrial" && (
        <div class="grid gap-3 sm:grid-cols-2">
          {[
            ["Risco", "parada, segurança, obsolescência, auditoria"],
            ["Método", "arquitetura, engenharia, implantação, validação"],
            ["Evidência", "FAT/SAT, as-built, data book, treinamento"],
            ["Suporte", "evolução, manutenção e governança de mudanças"],
          ].map(([label, desc]) => (
            <div class={`${nodeBase} ${nodeTone}`}>
              <strong>{label}</strong>
              <p class={`mt-1 ${mutedTone}`}>{desc}</p>
            </div>
          ))}
        </div>
      )
    }

    <figcaption
      class:list={[
        "mt-4 border-t pt-3 text-xs leading-relaxed",
        isDark
          ? "border-white/10 text-white/55"
          : "border-integra-gray-200 text-integra-gray-500",
      ]}
    >
      {copy.caption}
    </figcaption>
  </div>
</figure>
