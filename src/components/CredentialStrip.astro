---
interface Credential {
  label: string;
  /** Optional sub-label, e.g. badge level */
  sub?: string;
}

interface Props {
  credentials?: Credential[];
  title?: string;
}

const {
  title = "Credenciais e tecnologias atendidas",
  credentials = [
    { label: "Rockwell Automation", sub: "Partner Network" },
    { label: "PlantPAx", sub: "DCS Partner" },
    { label: "Telit Cinterion", sub: "TC deviceWISE" },
    { label: "FactoryTalk Suite" },
    { label: "Siemens", sub: "TIA / WinCC / PCS 7" },
    { label: "Elipse E3" },
    { label: "Schneider Electric", sub: "EcoStruxure" },
    { label: "ISA / IEC 62443" },
    { label: "ISA-88 / ISA-95" },
    { label: "Cisco Networking", sub: "Industrial IoT" },
  ],
} = Astro.props;
---

<section class="border-y border-integra-gray-200 bg-integra-gray-50">
  <div class="container-fluid py-10 lg:py-12">
    <p
      class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-6"
    >
      {title}
    </p>
    <ul
      class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-4"
    >
      {
        credentials.map(({ label, sub }) => (
          <li class="flex flex-col">
            <span class="text-sm font-semibold text-integra-gray-900">
              {label}
            </span>
            {sub && (
              <span class="text-xs font-mono uppercase tracking-wider text-integra-gray-500 mt-0.5">
                {sub}
              </span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-xs text-integra-gray-500 italic">
      Parcerias formais e tecnologias atendidas são separadas com transparência. Consulte a página de
      <a
        href="/certificacoes"
        class="font-semibold text-integra-red underline decoration-integra-red/40 underline-offset-2 hover:decoration-integra-red"
        >Certificações</a
      > para detalhes.
    </p>
  </div>
</section>
