---
interface Credential {
  label: string;
  /** Optional sub-label, e.g. program or product family. */
  sub?: string;
  kind?: "Parceria formal" | "Capacidade do programa" | "Certificação" | "Tecnologia atendida" | "Referência aplicada";
}

interface Props {
  credentials?: Credential[];
  title?: string;
}

const {
  title = "Parcerias, certificações e tecnologias atendidas",
  credentials = [
    { label: "Rockwell Automation", sub: "Partner Network", kind: "Parceria formal" },
    { label: "PlantPAx DCS", sub: "Certified", kind: "Capacidade do programa" },
    { label: "Telit Cinterion", sub: "TC deviceWISE", kind: "Parceria formal" },
    { label: "FactoryTalk Suite", kind: "Tecnologia atendida" },
    { label: "Siemens", sub: "TIA / WinCC / PCS 7", kind: "Tecnologia atendida" },
    { label: "Elipse E3", kind: "Tecnologia atendida" },
    { label: "Schneider Electric", sub: "EcoStruxure", kind: "Tecnologia atendida" },
    { label: "ISA / IEC 62443", kind: "Referência aplicada" },
    { label: "ISA-88 / ISA-95", kind: "Referência aplicada" },
    { label: "Cisco Networking", sub: "Industrial IoT", kind: "Tecnologia atendida" },
  ],
} = Astro.props;
---

<section class="border-y border-integra-gray-200 bg-integra-gray-50">
  <div class="container-fluid py-10 lg:py-12">
    <p
      class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-6"
    >
      {title}
    </p>
    <ul
      class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-4"
    >
      {
        credentials.map(({ label, sub, kind }) => (
          <li class="flex flex-col border-l-2 border-integra-gray-200 pl-3">
            {kind && (
              <span class="mb-1 text-[10px] font-mono uppercase tracking-wider text-integra-red-700">
                {kind}
              </span>
            )}
            <span class="text-sm font-semibold text-integra-gray-900">
              {label}
            </span>
            {sub && (
              <span class="text-xs font-mono uppercase tracking-wider text-integra-gray-500 mt-0.5">
                {sub}
              </span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-xs text-integra-gray-500 italic">
      O tipo de vínculo está identificado em cada item. Consulte a página de
      <a
        href="/certificacoes/"
        class="font-semibold text-integra-red-700 underline decoration-integra-red/40 underline-offset-2 hover:decoration-integra-red"
        >Certificações</a
      > para detalhes.
    </p>
  </div>
</section>
