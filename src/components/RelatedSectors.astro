---
import SectionHeader from "@/components/SectionHeader.astro";

interface SectorLink {
  href: string;
  label: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  items: SectorLink[];
}

const { title, description, items } = Astro.props;
---

<section class="border-b border-integra-gray-200 bg-integra-white">
  <div class="container-fluid py-20">
    <SectionHeader
      eyebrow="Aplicações por setor"
      title={title}
      description={description}
      accent={true}
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <a
          href={item.href}
          class="group rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-6 transition-colors hover:border-integra-gray-900"
        >
          {/* Eyebrow decorativo: idêntico em todos os cards, vira ruído em
              leitores de tela dentro de um link por card. */}
          <p
            class="mb-3 flex items-center justify-between font-mono text-xs uppercase tracking-widest text-integra-red-700"
            aria-hidden="true"
          >
            Setor industrial
            <span class="text-integra-gray-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-integra-red-700">↗</span>
          </p>
          <h3 class="text-lg font-semibold text-integra-gray-900">{item.label}</h3>
          <p class="mt-3 text-sm leading-relaxed text-integra-gray-600">
            {item.description}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
