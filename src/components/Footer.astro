---
import { Image } from "astro:assets";
import logoColorido from "@/assets/logos/Colorido.png";
import EmailLink from "@/components/EmailLink.astro";
import { SITE, COMPANY } from "@/utils/site";

const year = new Date().getFullYear();
const phoneCommercial = COMPANY.phones[0];
const phoneWhatsApp = COMPANY.phones.find((p) => p.whatsapp)!;

const columns = [
  {
    title: "Empresa",
    links: [
      { href: "/empresa", label: "Sobre a Integra" },
      { href: "/empresa#timeline", label: "História" },
      { href: "/certificacoes", label: "Certificações" },
      { href: "/contato", label: "Contato" },
    ],
  },
  {
    title: "Soluções",
    links: [
      { href: "/solucoes/plantpax", label: "PlantPAx" },
      { href: "/solucoes/factorytalk", label: "FactoryTalk Suite" },
      { href: "/solucoes/redes-iec-62443", label: "Redes & IEC 62443" },
      { href: "/solucoes", label: "Todas as soluções" },
    ],
  },
  {
    title: "Setores",
    links: [
      { href: "/setores", label: "Açúcar e Etanol" },
      { href: "/setores", label: "Agronegócio" },
      { href: "/setores", label: "Alimentos e Bebidas" },
      { href: "/setores", label: "Saneamento" },
      { href: "/setores", label: "Ver todos" },
    ],
  },
  {
    title: "Conteúdo",
    links: [
      { href: "/cases", label: "Cases" },
      { href: "/blog", label: "Blog técnico" },
      { href: "/rss.xml", label: "RSS feed" },
      { href: COMPANY.social.linkedin, label: "LinkedIn", external: true },
    ],
  },
];

const legalLinks = [
  { href: "/politica-privacidade", label: "Política de privacidade" },
  { href: "/uso-de-cookies", label: "Uso de cookies" },
];
---

<footer class="relative bg-integra-white border-t border-integra-gray-200">
  <!-- Top: brand + 4 navigation columns -->
  <div class="container-fluid py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4 space-y-6">
        <Image
          src={logoColorido}
          alt={SITE.name}
          class="h-12 w-auto"
          widths={[200, 320]}
          sizes="200px"
          loading="lazy"
          decoding="async"
        />
        <p class="text-sm leading-relaxed text-integra-gray-700 max-w-sm">
          Engenharia e integração de sistemas industriais para plantas
          críticas. Arquitetura, padronização, segurança operacional e
          governança técnica de longo prazo.
        </p>
        <div
          class="flex flex-wrap gap-x-3 gap-y-2 text-xs font-mono uppercase tracking-wider text-integra-gray-500"
        >
          <span>Maringá-PR</span>
          <span aria-hidden="true">·</span>
          <span>Atuação nacional</span>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <a
            href={COMPANY.social.linkedin}
            rel="noopener noreferrer"
            class="inline-flex size-9 items-center justify-center rounded-full text-integra-gray-700 hover:text-integra-red hover:bg-integra-gray-100 transition-colors"
            aria-label="LinkedIn"
          >
            <svg
              class="size-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              />
            </svg>
          </a>
          <EmailLink
            email={COMPANY.email}
            class="inline-flex size-9 items-center justify-center rounded-full text-integra-gray-700 hover:text-integra-red hover:bg-integra-gray-100 transition-colors"
            ariaLabel="E-mail"
          >
            <svg
              class="size-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-2 11H5a2 2 0 01-2-2V7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2z"
              />
            </svg>
          </EmailLink>
          <a
            href={`https://wa.me/${phoneWhatsApp.value.replace(/[^\d]/g, "")}`}
            rel="noopener noreferrer"
            class="inline-flex size-9 items-center justify-center rounded-full text-integra-gray-700 hover:text-integra-red hover:bg-integra-gray-100 transition-colors"
            aria-label="WhatsApp"
          >
            <svg
              class="size-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"
              />
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {columns.map((col) => (
          <nav class="grid gap-3 content-start" aria-label={col.title}>
            <h2
              class="text-sm font-semibold text-integra-gray-900 uppercase tracking-wide mb-2"
            >
              {col.title}
            </h2>
            {col.links.map((link) => (
              <a
                href={link.href}
                {...(("external" in link && link.external) && { rel: "noopener noreferrer" })}
                class="text-sm text-integra-gray-700 hover:text-integra-red transition-colors w-fit"
              >
                {link.label}
              </a>
            ))}
          </nav>
        ))}
      </div>
    </div>
  </div>

  <!-- Mid: contact strip -->
  <div class="border-t border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-8 lg:py-10">
      <div class="grid gap-8 md:grid-cols-3">
        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            Contato comercial
          </h3>
          <EmailLink
            email={COMPANY.email}
            class="text-base font-medium text-integra-gray-900 hover:text-integra-red transition-colors block break-all"
          >
            {COMPANY.email}
          </EmailLink>
          <a
            href={`tel:${phoneCommercial.value.replace(/\s+/g, "")}`}
            class="mt-1 text-sm text-integra-gray-700 hover:text-integra-red transition-colors block"
          >
            {phoneCommercial.display}
          </a>
        </div>
        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            WhatsApp / Direto
          </h3>
          <a
            href={`https://wa.me/${phoneWhatsApp.value.replace(/[^\d]/g, "")}`}
            rel="noopener noreferrer"
            class="text-base font-medium text-integra-gray-900 hover:text-integra-red transition-colors block"
          >
            {phoneWhatsApp.display}
          </a>
          <p class="mt-1 text-xs font-mono text-integra-gray-500">
            Resposta em até 1 dia útil
          </p>
        </div>
        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            Endereço
          </h3>
          <address class="not-italic text-sm text-integra-gray-700 leading-relaxed">
            {COMPANY.address.street}<br />
            {COMPANY.address.city} - {COMPANY.address.state} · CEP {COMPANY.address.postalCode}
          </address>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom: copyright + legal links -->
  <div class="border-t border-integra-gray-200">
    <div
      class="container-fluid py-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between text-xs text-integra-gray-500"
    >
      <p>
        © {year} {COMPANY.legalName} · CNPJ {COMPANY.taxId}
      </p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        {legalLinks.map((link) => (
          <a
            href={link.href}
            class="hover:text-integra-gray-900 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
      <p class="font-mono uppercase tracking-wider">
        {SITE.tagline}
      </p>
    </div>
  </div>

  <!-- Brand strip, subtle red gradient at the very bottom -->
  <div
    class="h-1 w-full bg-gradient-to-r from-integra-red via-integra-red-700 to-integra-red"
    aria-hidden="true"
  ></div>
</footer>
