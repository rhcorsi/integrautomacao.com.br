---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { serviceSchema } from "@/utils/schema";
import SectionHeader from "@/components/SectionHeader.astro";
import DeliverableList from "@/components/DeliverableList.astro";
import StandardsBadges from "@/components/StandardsBadges.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";
import ManualReference from "@/components/ManualReference.astro";
import historianReference from "@/assets/manuals/factorytalk-historian-logical-diagram.jpg";
import datamosaixReference from "@/assets/manuals/factorytalk-datamosaix-data-flow.jpg";

const layers = [
  {
    title: "Coleta confiável",
    description:
      "Tags de PLC, SCADA e sistemas de processo entram por interfaces documentadas, com timestamp, buffer e validação de qualidade.",
  },
  {
    title: "Contexto de ativos",
    description:
      "AF Templates transformam tags soltas em equipamentos, áreas, linhas, malhas, bateladas e indicadores operacionais.",
  },
  {
    title: "Governança de tags",
    description:
      "Nome, unidade, escala, exceção, compressão e proprietário técnico são tratados como padrão de engenharia.",
  },
  {
    title: "Uso operacional",
    description:
      "Dashboards e análises só entram depois de garantir que o dado é confiável, auditável e útil para manutenção e produção.",
  },
];

const deliverables = [
  "Inventário de fontes de dados industriais e mapa de interfaces",
  "Padronização de nomenclatura, unidades, escala e qualidade de tags",
  "AF Templates por tipo de ativo, equipamento e área de processo",
  "Integração com PlantPAx, FactoryTalk Historian, OPC UA e bancos legados",
  "Integração com FactoryTalk Edge Gateway, ThingWorx, Kepware ou DataMosaix quando aplicável",
  "Cálculos de desempenho, eventos e indicadores operacionais documentados",
  "Estratégia de retenção, compressão, exceção e disponibilidade de dados",
  "Painéis técnicos para operação, manutenção e gestão de energia",
  "Data book de integração e roteiro de evolução para analytics",
];

const faq = [
  {
    q: "Vocês implantam PI System / AVEVA do zero?",
    a: "Sim, quando o projeto exige. Também atuamos em ambientes existentes com problemas de qualidade de dados, tags sem contexto, AF Templates incompletos ou integrações criadas sem padrão.",
  },
  {
    q: "Dá para integrar PlantPAx com PI System sem retrabalho?",
    a: "Dá, desde que a arquitetura de tags e objetos de processo seja pensada desde o DCS. PlantPAx Library, naming convention e AF Templates precisam conversar entre si.",
  },
  {
    q: "Dashboard resolve falta de governança de dados?",
    a: "Não. Dashboard bonito em cima de dado ruim só acelera decisão errada. Primeiro tratamos coleta, qualidade, contexto e responsabilidade técnica; visualização vem depois.",
  },
  {
    q: "PI System ou FactoryTalk Historian?",
    a: "PI System (AVEVA) é forte em volume massivo, AF Templates ricos, ambientes multi-site e analytics avançado. Historian SE atende bem ecossistemas 100% Rockwell de porte médio. O critério de escolha envolve volume de tags, número de sites, quem opera, e integração com ERP/MES.",
  },
  {
    q: "PI to PI replication é seguro pela IDMZ?",
    a: "Sim, é o padrão. PI servidor industrial replica para PI servidor corporativo na IDMZ usando port único, autenticação certificate-based, sem caminho direto enterprise→industrial. Modelo recomendado pela própria OSIsoft/AVEVA.",
  },
  {
    q: "Posso conectar Power BI direto ao PI?",
    a: "Sim, via PI Web API ou ODBC. Em planta multi-departamento, comum: planeamento usa Power BI, processo usa PI Vision, manutenção usa AssetWise. Mesma fonte, ferramentas diferentes.",
  },
  {
    q: "Como funciona o licenciamento PI System?",
    a: "Modelo AVEVA por contagem de pontos (PIPoints), conexão de cliente e módulos contratados (Asset Framework, Vision, Integrator, Connectors). A cotação é feita diretamente pelo canal AVEVA conforme volume, perfil de uso e contrato.",
  },
  {
    q: "Vale migrar de Historian para PI System?",
    a: "A decisão envolve volume de tags atual e projetado, número de sites a unificar e necessidade de AF Templates avançados. Para planta única e volume médio, manter Historian costuma fazer sentido. Para planta multi-site com analytics avançado, PI System é o caminho.",
  },
];
---

<BaseLayout
  title="PI System / AVEVA, Dados Industriais"
  description="Engenharia de dados industriais com PI System / AVEVA: tags, AF Templates, historian, qualidade de dados e integração com PlantPAx e FactoryTalk."
  jsonLd={[
    serviceSchema({
      name: "PI System / AVEVA, Dados Industriais",
      description:
        "Engenharia de dados industriais com PI System / AVEVA: tags, AF Templates, historian, qualidade de dados e integração com PlantPAx e FactoryTalk.",
      url: Astro.url.href,
    }),
  ]}
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-12 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:py-24">
      <div>
        <p class="mb-3 text-xs font-mono uppercase tracking-widest text-integra-red-700">
          Solução · Dados Industriais
        </p>
        <h1 class="max-w-3xl text-4xl font-semibold text-integra-gray-900 sm:text-5xl">
          PI System / AVEVA
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-integra-gray-700 lg:text-xl">
          Dados industriais não são apenas gráficos. São infraestrutura de
          decisão. Atuamos na arquitetura de coleta, historian, qualidade de
          tags, AF Templates e integração com PlantPAx/FactoryTalk para que a
          planta tenha informação confiável, contextualizada e manutenível.
        </p>
      </div>
      <ManualReference
        image={historianReference}
        alt="Diagrama lógico de arquitetura FactoryTalk Historian"
        title="Historian como infraestrutura de dados industriais"
        source="Rockwell Automation - FactoryTalk Historian SE Reference Architectures"
        caption="Referência visual pública para explicar coleta, retenção e consulta de dados industriais antes de dashboards e analytics."
        loading="eager"
      />
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Camadas de dados"
        title="Da tag ao contexto operacional"
        description="Um sistema de dados industrial só se sustenta quando cada camada tem dono, regra e documentação."
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {layers.map((item, i) => (
          <article class="rounded-lg border border-integra-gray-200 bg-integra-white p-6">
            <p class="mb-3 font-mono text-xs font-semibold text-integra-red-700">
              0{i + 1}
            </p>
            <h3 class="text-lg font-semibold text-integra-gray-900">
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">
              {item.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200">
    <div class="container-fluid max-w-4xl py-20">
      <SectionHeader
        eyebrow="Como atuamos"
        title="Governança de dados antes de analytics"
        description="A Integra organiza o dado industrial para que manutenção, produção, qualidade e gestão falem a mesma língua técnica."
        accent={true}
      />

      <TechnicalCallout variant="note" title="Dado industrial é ativo de engenharia">
        <p>
          Uma tag sem unidade, escala, qualidade e contexto vira passivo. O
          projeto precisa definir padrão de nomenclatura, responsável técnico,
          retenção e critério de confiabilidade antes de publicar indicadores.
        </p>
      </TechnicalCallout>

      <DeliverableList items={deliverables} twoColumn={true} />

      <div class="my-14 grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <ManualReference
          image={datamosaixReference}
          alt="Fluxo de dados em arquitetura FactoryTalk DataMosaix"
          title="DataMosaix, edge e contexto de dados"
          source="Rockwell Automation - FactoryTalk DataMosaix Reference Architectures"
          caption="Referência visual pública para mostrar como dados industriais podem ser contextualizados e publicados para camadas analíticas sem expor controle crítico."
        />
        <div>
          <h3 class="text-2xl font-semibold text-integra-gray-900">
            Dados industriais não terminam no historian
          </h3>
          <p class="mt-4 text-base leading-relaxed text-integra-gray-700">
            A camada de dados pode envolver FactoryTalk Historian, PI/AVEVA,
            ThingWorx, Kepware, FactoryTalk Edge Gateway e DataMosaix. A
            decisão depende de fonte, qualidade, contexto, segurança, retenção
            e uso operacional. A Integra organiza essa evolução por etapas.
          </p>
          <a
            href="/tecnologias/factorytalk-historian"
            class="mt-6 inline-flex rounded-md bg-integra-red px-4 py-2 text-sm font-semibold text-white hover:bg-integra-red-700"
          >
            Ver páginas técnicas de dados
          </a>
        </div>
      </div>

      <StandardsBadges
        title="Tecnologias e referências aplicadas"
        standards={[
          { code: "PI AF", description: "Asset Framework e templates" },
          { code: "OPC UA", description: "Integração industrial" },
          { code: "ISA-95", description: "Integração empresa-controle" },
          { code: "PlantPAx", description: "Objetos de processo e tags" },
          { code: "Historian", description: "Retenção e consulta" },
          { code: "IEC 62443", description: "Acesso e segmentação OT" },
        ]}
      />

      <FAQAccordion items={faq} />
    </div>
  </section>

  <CtaBlock
    title="Quer transformar dados industriais em infraestrutura confiável?"
    description="A conversa começa por inventário de fontes, qualidade de tags e objetivos operacionais. Dashboard vem depois."
    primaryCta={{ href: "/contato?assunto=pi-system", label: "Conversar sobre dados industriais" }}
    secondaryCta={{ href: "/solucoes/plantpax", label: "Ver PlantPAx" }}
  />
</BaseLayout>
