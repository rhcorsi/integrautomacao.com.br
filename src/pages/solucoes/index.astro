---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import SolutionCard from "@/components/SolutionCard.astro";
import LifecycleRail from "@/components/LifecycleRail.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import { Icon } from "astro-icon/components";

const desafios = [
  {
    icon: "lucide:replace",
    label: "Modernizar PLC legado",
    description:
      "PLC-5/SLC500 obsoleto, spare difícil, integração nova exigida. Migração planejada com janela de cutover e plano de rollback.",
    href: "/solucoes/migracao-plc",
    cta: "Ver migração PLC",
  },
  {
    icon: "lucide:shield-check",
    label: "Prevenir incidentes cyber",
    description:
      "Rede flat, sem IDMZ, acesso remoto improvisado. Implementar segmentação Purdue, IDMZ e governança de identidade OT.",
    href: "/solucoes/redes-iec-62443",
    cta: "Ver redes / IEC 62443",
  },
  {
    icon: "lucide:layers-3",
    label: "Padronizar engenharia plant-wide",
    description:
      "Cada área com padrão diferente, manutenção dependente de quem implantou. PlantPAx Library + AF Templates + governança comum.",
    href: "/solucoes/plantpax",
    cta: "Ver PlantPAx",
  },
  {
    icon: "lucide:clipboard-check",
    label: "Validar arquitetura existente",
    description:
      "Auditoria técnica do stack OT atual, gap analysis contra IEC 62443, roadmap progressivo priorizado por risco operacional.",
    href: "/tecnologias/auditoria-conformidade",
    cta: "Ver auditoria",
  },
  {
    icon: "lucide:wrench",
    label: "Reduzir paradas não planejadas",
    description:
      "Manutenção preventiva e evolutiva, monitoramento OT, analytics e procedimentos de recuperação documentados.",
    href: "/tecnologias/manutencao-corretiva-preventiva",
    cta: "Ver manutenção",
  },
  {
    icon: "lucide:database",
    label: "Integrar dados OT com sistemas corporativos",
    description:
      "Tags, AF Templates, OPC UA, deviceWISE, edge gateways — dado industrial chegando ao ERP, MES e BI sem improviso.",
    href: "/solucoes/pi-system",
    cta: "Ver PI System / AVEVA",
  },
];

const tecnologiasRelacionadas = [
  { href: "/tecnologias/iec-62443-nist-ot", label: "Diagnóstico IEC 62443 / NIST OT" },
  { href: "/tecnologias/hardening-industrial", label: "Hardening industrial" },
  { href: "/tecnologias/monitoramento-redes-industriais", label: "Monitoramento OT" },
  { href: "/tecnologias/virtualizacao-ot", label: "Virtualização OT" },
  { href: "/tecnologias/backup-recuperacao-desastres", label: "Backup e Disaster Recovery" },
  { href: "/tecnologias/active-directory-ot", label: "Active Directory industrial" },
  { href: "/tecnologias/intertravamentos-sequencias", label: "Intertravamentos e safety" },
  { href: "/tecnologias/edge-computing-industrial", label: "Edge computing industrial" },
];

const mvpSolutions = [
  {
    href: "/solucoes/plantpax",
    title: "PlantPAx",
    summary:
      "DCS moderno da Rockwell Automation. Arquitetura escalável, biblioteca de objetos de processo, integração plant-wide.",
    icon: "lucide:layers-3",
    tags: ["DCS", "ControlLogix", "PlantPAx 5.x", "FactoryTalk"],
  },
  {
    href: "/solucoes/factorytalk",
    title: "FactoryTalk Suite",
    summary:
      "View SE, Optix, Batch, Historian, AssetCentre, ThinManager — supervisão, gestão de ativos e dados industriais integrados.",
    icon: "lucide:gauge",
    tags: ["View SE", "Optix", "Batch", "Historian", "ThinManager"],
  },
  {
    href: "/solucoes/redes-iec-62443",
    title: "Redes Industriais e IEC 62443",
    summary:
      "Topologia, segmentação, switches Stratix/Cisco, OPC UA. Cibersegurança OT do projeto à operação.",
    icon: "lucide:shield-check",
    tags: ["CPwE", "IEC 62443", "Stratix", "OPC UA", "NIST SP 800-82"],
  },
  {
    href: "/solucoes/data-centers",
    title: "Data Centers Industriais (IDC)",
    summary:
      "Virtualização, redundância, alta disponibilidade para aplicações industriais críticas.",
    icon: "lucide:server",
    tags: ["VMware", "Redundância", "Backup", "ThinManager"],
  },
  {
    href: "/solucoes/pi-system",
    title: "PI System / AVEVA",
    summary:
      "Tags, AF Templates, historian, contexto de ativos e integração com PlantPAx/FactoryTalk.",
    icon: "lucide:database",
    tags: ["PI", "AVEVA", "AF Templates", "OPC UA"],
  },
  {
    href: "/solucoes/migracao-plc",
    title: "Migração PLC5 / SLC500 → ControlLogix",
    summary:
      "Modernização de controladores legados sem comprometer a operação.",
    icon: "lucide:replace",
    tags: ["PLC5", "SLC500", "ControlLogix", "Cutover"],
  },
];
---

<BaseLayout
  title="Soluções"
  description="Soluções de engenharia e integração industrial: PlantPAx, FactoryTalk Suite, redes industriais e cibersegurança OT, virtualização, PI System e migração de controladores legados."
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20 lg:py-24">
      <p class="text-xs font-mono uppercase tracking-widest text-integra-red mb-3">
        Soluções Integra
      </p>
      <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
        Tecnologias que entendemos por dentro.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
        Não atuamos como revenda nem como consultoria genérica. Cada solução é
        entregue com arquitetura, padronização, documentação e suporte
        contínuo — pelos mesmos engenheiros que projetaram o sistema.
      </p>
      <a
        href="/tecnologias"
        class="mt-8 inline-flex rounded-md border border-integra-gray-300 px-4 py-2 text-sm font-semibold text-integra-gray-900 transition-colors hover:border-integra-gray-900"
      >
        Ver catálogo completo de softwares, tecnologias e serviços
      </a>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Disponíveis hoje"
        title="Áreas com profundidade comprovada"
        description="Cada solução tem página dedicada com problemas que resolve, método de implementação, entregáveis, normas e decisões de arquitetura."
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {mvpSolutions.map((sol) => <SolutionCard {...sol} />)}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Por desafio"
        title="O que costuma trazer o cliente até nós"
        description="Cada solução acima resolve um problema. Aqui mostramos os desafios mais comuns e qual caminho técnico eles tendem a seguir."
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {desafios.map((d) => (
          <article class="rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-6 flex flex-col gap-3">
            <div class="inline-flex size-10 items-center justify-center rounded-md bg-integra-gray-900 text-integra-white">
              <Icon name={d.icon} class="size-5" aria-hidden="true" />
            </div>
            <h3 class="text-base font-semibold text-integra-gray-900 leading-snug">
              {d.label}
            </h3>
            <p class="text-sm leading-relaxed text-integra-gray-700">
              {d.description}
            </p>
            <a
              href={d.href}
              class="mt-auto inline-flex items-center gap-1.5 pt-2 text-sm font-semibold text-integra-red hover:text-integra-red-700"
            >
              {d.cta} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Tecnologias relacionadas"
        title="Quando a solução pede mais profundidade técnica"
        description="Cada solução tem páginas técnicas dedicadas. Estas são as mais consultadas em paralelo às soluções principais."
        accent={true}
      />
      <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
        {tecnologiasRelacionadas.map((t) => (
          <li>
            <a
              href={t.href}
              class="group block rounded-lg border border-integra-gray-200 bg-integra-white p-4 hover:border-integra-gray-900 transition-colors"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-medium text-integra-gray-900 group-hover:text-integra-red transition-colors">
                  {t.label}
                </span>
                <span
                  class="text-integra-gray-400 group-hover:text-integra-red transition-colors"
                  aria-hidden="true"
                >→</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-8">
        <a
          href="/tecnologias"
          class="inline-flex items-center gap-2 text-sm font-semibold text-integra-red hover:text-integra-red-700"
        >
          Ver catálogo técnico completo <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <LifecycleRail
    title="Como aplicamos cada solução"
    intro="Toda solução passa pelas mesmas cinco fases. Etapas críticas, validações e documentação de engenharia são tratadas com disciplina desde o início."
  />

  <CtaBlock
    title="Tem um caso técnico para conversar?"
    description="Independentemente da solução, começamos conversando sobre o problema, a planta e os riscos. A arquitetura vem depois."
    primaryCta={{ href: "/contato?assunto=diagnostico", label: "Solicitar diagnóstico" }}
    secondaryCta={{ href: "/setores", label: "Ver por setor industrial" }}
  />
</BaseLayout>
