---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import DeliverableList from "@/components/DeliverableList.astro";
import StandardsBadges from "@/components/StandardsBadges.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";
import ManualReference from "@/components/ManualReference.astro";
import securityReference from "@/assets/manuals/factorytalk-security-system.jpg";

const pillars = [
  {
    title: "Alta disponibilidade",
    description:
      "Redundância de hosts, storage, rede, energia e serviços críticos para reduzir pontos únicos de falha.",
  },
  {
    title: "Virtualização OT",
    description:
      "Ambientes para HMI, historian, AssetCentre, engenharia e domínio industrial com snapshots e rollback controlados.",
  },
  {
    title: "Backup e recuperação",
    description:
      "Política de backup testada, restore validado e documentação de RTO/RPO compatível com a criticidade da planta.",
  },
  {
    title: "Segurança operacional",
    description:
      "Acesso por função, hardening, logs, segmentação e atualização planejada sem tratar servidor industrial como TI comum.",
  },
];

const deliverables = [
  "Levantamento de aplicações OT, dependências, versões e criticidade",
  "Arquitetura de hosts, storage, rede, backup e domínio industrial",
  "Dimensionamento de CPU, memória, I/O de disco e crescimento futuro",
  "Projeto de VLANs, firewall, acesso remoto e integração com IDMZ",
  "Plano de backup, restore, snapshots e recuperação de desastres",
  "Migração de VMs industriais com compatibilidade, backup, rollback e validação funcional",
  "Active Directory industrial, grupos, políticas e segregação de identidade OT",
  "Procedimentos de atualização, patching e janela de manutenção",
  "Documentação de credenciais, licenças, owners e contratos de suporte",
  "Validação de disponibilidade e handover para manutenção",
];

const faq = [
  {
    q: "Data center industrial é igual a servidor de TI?",
    a: "Não. Aplicações OT têm restrições de versão, licenciamento, latência, janelas de parada e dependências com operação. A arquitetura precisa respeitar isso.",
  },
  {
    q: "Vocês trabalham com virtualização de FactoryTalk?",
    a: "Sim. HMI Server, Data Server, FactoryTalk Directory, Historian, AssetCentre e estações de engenharia podem ser organizados em arquitetura virtualizada quando o sizing e a disponibilidade justificam.",
  },
  {
    q: "Backup de VM substitui backup de aplicação?",
    a: "Não. Snapshot e backup de VM ajudam na recuperação, mas não substituem exportações, projetos, versões, licenças e procedimentos próprios de cada aplicação industrial.",
  },
];
---

<BaseLayout
  title="Data Centers Industriais — IDC e Virtualização OT"
  description="Projeto de data centers industriais, virtualização OT, alta disponibilidade, backup e recuperação para aplicações críticas de automação."
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-12 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:py-24">
      <div>
        <p class="mb-3 text-xs font-mono uppercase tracking-widest text-integra-red">
          Solução · Infraestrutura OT
        </p>
        <h1 class="max-w-3xl text-4xl font-semibold text-integra-gray-900 sm:text-5xl">
          Data Centers Industriais
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-integra-gray-700 lg:text-xl">
          Aplicações industriais críticas não podem depender de servidores
          improvisados. Projetamos infraestrutura OT para supervisão,
          historian, engenharia, gestão de ativos e thin clients com
          redundância, backup, recuperação e governança de ciclo de vida.
        </p>
      </div>
      <ManualReference
        image={securityReference}
        alt="Arquitetura FactoryTalk Security com servidores e clientes"
        title="Servidores industriais, identidade e aplicações críticas"
        source="Rockwell Automation - FactoryTalk Security System Design"
        caption="Print de manual público usado para contextualizar serviços FactoryTalk, clientes, diretório e dependências de infraestrutura OT."
        loading="eager"
      />
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="O que muda no IDC"
        title="Infraestrutura industrial com premissas de operação"
        description="O objetivo não é ter servidores bonitos: é manter aplicações críticas disponíveis, recuperáveis e documentadas."
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {pillars.map((item) => (
          <article class="rounded-lg border border-integra-gray-200 bg-integra-white p-6">
            <h3 class="text-lg font-semibold text-integra-gray-900">
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">
              {item.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200">
    <div class="container-fluid max-w-4xl py-20">
      <SectionHeader
        eyebrow="Como atuamos"
        title="Servidor também é entrega de engenharia"
        description="A Integra conecta infraestrutura, automação e cibersegurança OT para que a planta tenha sustentação técnica depois do startup."
        accent={true}
      />

      <TechnicalCallout variant="note" title="RTO e RPO precisam ser decididos no projeto">
        <p>
          Se ninguém define quanto tempo a planta pode ficar sem HMI,
          historian ou engenharia, a arquitetura nasce sem critério. O IDC
          industrial traduz criticidade operacional em desenho técnico.
        </p>
      </TechnicalCallout>

      <DeliverableList items={deliverables} twoColumn={true} />

      <div class="my-10 rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-6">
        <h3 class="text-xl font-semibold text-integra-gray-900">
          O IDC também cobre migração, identidade e recuperação
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">
          Nos projetos mais completos, a Integra inclui migração de VMs,
          compatibilidade com aplicações FactoryTalk, Active Directory
          industrial, políticas de grupo, backup de projetos PLC/HMI,
          configurações de rede, receitas de batelada, bancos históricos e
          testes reais de restore. Infraestrutura OT só é confiável quando a
          recuperação é validada antes da emergência.
        </p>
        <a
          href="/tecnologias/data-centers-industriais"
          class="mt-5 inline-flex rounded-md bg-integra-red px-4 py-2 text-sm font-semibold text-white hover:bg-integra-red-700"
        >
          Ver tecnologias de infraestrutura OT
        </a>
      </div>

      <StandardsBadges
        title="Referências e tecnologias relacionadas"
        standards={[
          { code: "FactoryTalk", description: "Servidores e serviços OT" },
          { code: "ThinManager", description: "Clientes industriais" },
          { code: "VMware / Hyper-V", description: "Virtualização" },
          { code: "IEC 62443", description: "Segurança por zona" },
          { code: "CPwE", description: "Rede industrial convergente" },
          { code: "Backup / DR", description: "Recuperação validada" },
        ]}
      />

      <FAQAccordion items={faq} />
    </div>
  </section>

  <CtaBlock
    title="Sua infraestrutura OT sustenta a operação ou só mantém sistemas ligados?"
    description="Avaliamos servidores, aplicações, licenças, backup, rede e riscos de disponibilidade com olhar de automação industrial."
    primaryCta={{ href: "/contato?assunto=data-centers-industriais", label: "Avaliar infraestrutura OT" }}
    secondaryCta={{ href: "/solucoes/factorytalk", label: "Ver FactoryTalk" }}
  />
</BaseLayout>
