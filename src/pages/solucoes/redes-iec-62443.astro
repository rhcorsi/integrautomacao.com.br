---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { serviceSchema } from "@/utils/schema";
import SectionHeader from "@/components/SectionHeader.astro";
import DeliverableList from "@/components/DeliverableList.astro";
import StandardsBadges from "@/components/StandardsBadges.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";
import ManualReference from "@/components/ManualReference.astro";
import cpweReference from "@/assets/manuals/cpwe-ot-it-bridging.jpg";
import controllogixReference from "@/assets/manuals/controllogix-dlr-converged.jpg";
import idmzUntrustedTrusted from "@/assets/manuals/idmz-untrusted-trusted-zones.jpg";

const layers = [
  {
    title: "Camada de Controle",
    description:
      "PLCs, IEDs IEC 61850, dispositivos EtherNet/IP. Comunicação determinística com latência controlada.",
  },
  {
    title: "Camada de Supervisão",
    description:
      "SCADA, servidores HMI, estações de operação. Segregada do controle por VLANs industriais.",
  },
  {
    title: "Camada de Informação",
    description:
      "Historian, AF Templates, dashboards. Saída estruturada para sistemas corporativos via DMZ.",
  },
  {
    title: "Camada de Segurança",
    description:
      "Firewalls industriais, controle de acesso, monitoramento de eventos OT, segmentação Purdue.",
  },
];

const controls = [
  {
    title: "Zonas e conduítes",
    description:
      "Cada área crítica recebe fronteiras lógicas, regras de comunicação e critérios de acesso alinhados ao risco operacional.",
  },
  {
    title: "IDMZ industrial",
    description:
      "A integração com TI, nuvem, historian corporativo e acesso remoto passa por uma zona intermediária, nunca por caminho direto.",
  },
  {
    title: "Alta disponibilidade",
    description:
      "DLR, PRP, redundância de uplinks e desenho de anel entram quando o custo de indisponibilidade justifica a complexidade.",
  },
];

const deliverables = [
  "Diagnóstico de rede industrial existente com análise de risco e maturidade",
  "Projeto de topologia (anel de fibra, DLR, PRP) com switches Cisco e Stratix",
  "Segmentação Purdue / CPwE com VLANs, ACLs e firewalls industriais",
  "Endurecimento de configuração de switches (port security, BPDU guard, storm control)",
  "Integração OPC UA com camada de supervisão e informação",
  "Roteiro de cibersegurança orientado à IEC 62443 SL-T por zona",
  "Programa de gestão de patches e atualizações (FactoryTalk AssetCentre)",
  "Diagnóstico de tráfego, loops, broadcast storms, latência e saúde de switches",
  "Hardening de servidores, estações de engenharia, HMIs e switches industriais",
  "Plano de monitoramento OT e resposta a incidentes com evidências operacionais",
  "Documentação de rede, plano de resposta a incidentes e treinamento OT",
];

const faq = [
  {
    q: "IEC 62443 é obrigatória no Brasil?",
    a: "Não há lei brasileira específica obrigando IEC 62443. Ela é referência internacional adotada como base de cibersegurança industrial, citada em auditorias corporativas e em requisitos de clientes finais em diversos setores. É o padrão técnico que recomendamos para projetos novos.",
  },
  {
    q: "Como vocês fazem segmentação sem parar a planta?",
    a: "Trabalhamos por fases: primeiro mapeamos tráfego real (port mirror + análise), desenhamos a segmentação alvo, validamos em ambiente de homologação ou laboratório, e fazemos o cutover em janela planejada com plano de rollback. Nunca cego, nunca improvisado.",
  },
  {
    q: "Vocês entregam o equipamento de rede também?",
    a: "Não fornecemos hardware diretamente. Somos integradores, não revenda. Trabalhamos com a especificação ideal (Stratix, Cisco IE) e indicamos canais de aquisição com a Rockwell ou parceiros, garantindo que o que chega na planta é o que foi projetado.",
  },
  {
    q: "Como CPwE se relaciona com IEC 62443?",
    a: "CPwE (Converged Plantwide Ethernet) é a arquitetura de referência conjunta da Rockwell e da Cisco para implementar os princípios de IEC 62443 em redes industriais: segmentação, defense-in-depth e zonas de segurança. Aplicamos os dois em conjunto.",
  },
  {
    q: "Por onde começar uma jornada IEC 62443 numa planta legada?",
    a: "Pelo diagnóstico: inventário de ativos, fluxos de comunicação, zonas implícitas e gaps contra SL-T desejado. Sem mapa, qualquer ação vira achismo. O diagnóstico orienta um roadmap progressivo, fasado por área crítica conforme prioridade de risco.",
  },
  {
    q: "Quanto tempo leva implementar IDMZ numa planta existente?",
    a: "Inclui análise de tráfego, desenho, aquisição de firewalls e servidores, migração de serviços replicados (PI-to-PI, RD Gateway, AD industrial, WSUS) e validação. O cronograma específico depende do escopo, das integrações existentes e das janelas operacionais disponíveis.",
  },
  {
    q: "Posso ter rede industrial sem IDMZ se a planta for isolada?",
    a: "Em planta totalmente isolada, é tecnicamente possível. Mas a maioria das plantas precisa integrar dados com TI corporativa (ERP, manutenção predictiva, dashboards executivos), e nesses casos a IDMZ é o controle estrutural recomendado pela CPwE e pela IEC 62443. Não há atalho seguro.",
  },
  {
    q: "Qual a diferença entre IEC 62443 SL-2 e SL-3?",
    a: "SL-2 protege contra ataques deliberados com recursos modestos (script kiddies, malware comum). SL-3 protege contra ataques sofisticados com habilidades específicas em ICS (engenharia social, recursos médios). SL-3 exige controles bem mais profundos: segmentação rigorosa, monitoramento ativo e MFA obrigatório.",
  },
  {
    q: "Patch management em OT atrasa a planta?",
    a: "Atrasa quando improvisado. Bem feito (homologação em ambiente espelho, janela planejada, plano de rollback), o patch management entra na rotina sem impactar produção. O risco é o oposto: não patchar e ser comprometido por CVE conhecido.",
  },
  {
    q: "Vocês fazem teste de penetração em rede OT?",
    a: "Não fazemos pentest invasivo em planta de processo. Risco operacional inaceitável. Trabalhamos com red team-as-a-service em parceiros especializados, sempre em ambiente espelho ou em janela controlada com plano de recuperação aprovado.",
  },
];
---

<BaseLayout
  title="Redes Industriais e IEC 62443"
  description="Projeto e implementação de redes industriais segundo CPwE, com segmentação, switches Stratix/Cisco e cibersegurança OT alinhada à IEC 62443 e NIST SP 800-82."
  jsonLd={[
    serviceSchema({
      name: "Redes Industriais e Cibersegurança OT (IEC 62443)",
      description:
        "Projeto e implementação de redes industriais segundo CPwE, com segmentação, switches Stratix/Cisco e cibersegurança OT alinhada à IEC 62443 e NIST SP 800-82.",
      url: Astro.url.href,
    }),
  ]}
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-12 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:py-24">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-integra-ot mb-3">
          Solução · Redes & Cibersegurança OT
        </p>
        <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
          Redes Industriais e <span class="text-integra-ot">IEC 62443</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
          Projetamos e implementamos redes industriais robustas, segmentadas e
          seguras, alinhadas ao modelo CPwE (Converged Plantwide Ethernet) e
          ao framework de cibersegurança IEC 62443. Defense in depth do
          chão de fábrica até a integração corporativa.
        </p>
      </div>
      <ManualReference
        image={cpweReference}
        alt="Arquitetura CPwE com integração OT e IT"
        title="CPwE como referência para segmentação OT/IT"
        source="Cisco + Rockwell Automation - CPwE Design and Implementation Guides"
        caption="Referência visual pública para explicar zonas, IDMZ, integração OT/IT e defesa em profundidade em redes industriais."
        theme="ot"
        loading="eager"
      />
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Arquitetura em camadas"
        title="Como segregamos o ambiente OT"
        description="Cada camada tem regras claras de quem fala com quem. Sem rede flat, sem caminho direto entre chão de fábrica e internet."
        accent={true}
      />
      <ol class="grid gap-px bg-integra-gray-200 rounded-lg overflow-hidden lg:grid-cols-4">
        {layers.map((layer, i) => (
          <li class="bg-integra-white p-6 flex flex-col gap-3">
            <span
              class="font-mono text-xs font-semibold text-integra-ot"
            >
              L{4 - i}
            </span>
            <h3 class="text-lg font-semibold text-integra-gray-900">
              {layer.title}
            </h3>
            <p class="text-sm leading-relaxed text-integra-gray-700">
              {layer.description}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-12 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <ManualReference
        image={idmzUntrustedTrusted}
        alt="Figura IDMZ High Level Concepts mostrando zona Untrusted (Enterprise) e Trusted (Industrial) separadas por firewall com regra No Direct IACS Traffic"
        title="A IDMZ é a fronteira inegociável entre Untrusted e Trusted"
        source="Cisco + Rockwell Automation · Securely Traversing IACS Data across the IDMZ (ENET-TD013A-EN-P)"
        caption="Print público do guia ENET-TD013A-EN-P: nenhum tráfego IACS atravessa direto. A IDMZ replica serviços, registra, inspeciona e desconecta, é o controle estrutural exigido pelo CPwE e pela IEC 62443."
        theme="ot"
      />
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-integra-ot mb-3">
          IDMZ · zona-pivô do CPwE
        </p>
        <h2 class="text-3xl font-semibold text-integra-gray-900 sm:text-4xl">
          Sem IDMZ, não existe IEC 62443 aplicada
        </h2>
        <p class="mt-5 text-base leading-relaxed text-integra-gray-700 lg:text-lg">
          A IDMZ é o ponto onde a segurança de processo deixa de ser teoria.
          Servidores replicados, gateways de transferência, RD Gateway,
          historian em PI-to-PI e WSUS vivem na IDMZ, nunca direto na
          camada de controle. É essa fronteira que permite manter a planta
          conectada à TI corporativa sem expor o IACS.
        </p>
        <ul class="mt-6 grid gap-2 text-sm text-integra-gray-700">
          <li class="flex gap-2"><span class="text-integra-ot mt-1">·</span><span>Firewalls redundantes em modo high-availability, com regras documentadas e revisadas por mudança.</span></li>
          <li class="flex gap-2"><span class="text-integra-ot mt-1">·</span><span>Serviços replicados (Historian, AD, WSUS, Antivírus) em vez de acesso direto enterprise→industrial.</span></li>
          <li class="flex gap-2"><span class="text-integra-ot mt-1">·</span><span>Acesso remoto sempre via Remote Desktop Gateway com MFA, jump host registrado e gravação de sessão.</span></li>
          <li class="flex gap-2"><span class="text-integra-ot mt-1">·</span><span>Pontos de desconexão (Disconnect) explícitos para isolar a planta em incidente de cibersegurança.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200">
    <div class="container-fluid py-20 max-w-4xl">
      <SectionHeader
        eyebrow="Como atuamos"
        title="Do diagnóstico ao plano de resposta"
        accent={true}
      />
      <p class="text-base leading-relaxed text-integra-gray-700 lg:text-lg max-w-3xl">
        Cibersegurança OT não é firewall na borda. É segmentação correta,
        endurecimento de configuração, gestão de identidades, auditoria de
        mudanças e plano de resposta. Aplicamos os controles da IEC 62443
        com base no nível de segurança (SL-T) definido por zona.
      </p>

      <TechnicalCallout variant="ot" title="Cybersecurity by design">
        <p>
          Não tratamos segurança como camada adicional. Ela está presente
          desde o desenho da arquitetura, autenticação, segmentação, logs
          centralizados e monitoramento entram no projeto, não no
          comissionamento.
        </p>
      </TechnicalCallout>

      <div class="my-12 grid gap-4 md:grid-cols-3">
        {controls.map((item) => (
          <article class="rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-5">
            <h3 class="text-base font-semibold text-integra-gray-900">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-integra-gray-700">
              {item.description}
            </p>
          </article>
        ))}
      </div>

      <DeliverableList items={deliverables} twoColumn={true} />

      <div class="my-14 grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <ManualReference
          image={controllogixReference}
          alt="Arquitetura ControlLogix com DLR convergente"
          title="DLR, topologia e disponibilidade em rede industrial"
          source="Rockwell Automation - ControlLogix High Availability Reference Architectures"
          caption="Referência visual pública para contextualizar topologias de alta disponibilidade, DLR e integração de controladores em redes industriais."
          theme="ot"
        />
        <div>
          <h3 class="text-2xl font-semibold text-integra-gray-900">
            Rede industrial não é cabeamento: é arquitetura operacional
          </h3>
          <p class="mt-4 text-base leading-relaxed text-integra-gray-700">
            A proposta técnica da Integra inclui EtherNet/IP, OPC UA, Modbus
            TCP/RTU, IEC 61850, Foundation Fieldbus, Profibus PA e HART quando
            o processo exige. O desenho define onde cada protocolo entra,
            quais dados cruza, qual zona protege e como a manutenção
            diagnostica falhas sem depender de tentativa e erro.
          </p>
          <a
            href="/tecnologias/ethernet-ip-cpwe"
            class="mt-6 inline-flex rounded-md bg-integra-red px-4 py-2 text-sm font-semibold text-white hover:bg-integra-red-700"
          >
            Ver tecnologias de redes e OT
          </a>
        </div>
      </div>

      <StandardsBadges
        title="Frameworks e referências aplicadas"
        standards={[
          { code: "ISA/IEC 62443", description: "Cibersegurança OT (zonas e SL)" },
          { code: "NIST SP 800-82", description: "Guia de segurança ICS/OT" },
          { code: "CPwE", description: "Arquitetura Rockwell + Cisco + Panduit" },
          { code: "IEC 61850", description: "Comunicação em subestações" },
          { code: "DLR / PRP", description: "Redes de alta disponibilidade" },
          { code: "OPC UA", description: "Comunicação segura entre sistemas" },
        ]}
      />

      <FAQAccordion items={faq} />
    </div>
  </section>

  <CtaBlock
    title="Sua planta precisa de uma análise de rede e cibersegurança OT?"
    description="Começamos com diagnóstico documentado: o que existe hoje, qual o risco operacional, qual o gap até IEC 62443 SL-T desejado. Sem alarmismo, sem checklist de produto."
    primaryCta={{ href: "/contato?assunto=redes-cyber", label: "Solicitar diagnóstico OT" }}
    secondaryCta={{ href: "/solucoes/plantpax", label: "Ver PlantPAx" }}
  />
</BaseLayout>
