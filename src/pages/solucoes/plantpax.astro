---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import DeliverableList from "@/components/DeliverableList.astro";
import StandardsBadges from "@/components/StandardsBadges.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";
import ManualReference from "@/components/ManualReference.astro";
import plantpaxReference from "@/assets/manuals/plantpax-reference-medium-pass.jpg";
import controllogixReference from "@/assets/manuals/controllogix-dlr-converged.jpg";
import plantpaxPasscSmall from "@/assets/manuals/plantpax-passc-small-1k-io.jpg";
import plantpaxRedundantPrp from "@/assets/manuals/plantpax-redundant-prp-topology.jpg";

const problems = [
  {
    title: "Sistemas legados sem padronização",
    description:
      "Plantas com múltiplas gerações de software, telas inconsistentes e dificuldade de manutenção por engenheiros diferentes do que implantou.",
  },
  {
    title: "Risco de parada por falhas sistêmicas",
    description:
      "Arquiteturas mal dimensionadas, redundância parcial e ausência de objetos de processo padronizados aumentam a superfície de falha.",
  },
  {
    title: "Falta de visibilidade plant-wide",
    description:
      "Dados isolados em ilhas, sem contexto, sem AF Templates e sem integração com sistemas de informação corporativos.",
  },
  {
    title: "Cibersegurança como afterthought",
    description:
      "Redes flat, autenticação compartilhada e ausência de governança alinhada à IEC 62443 expõem a operação a riscos crescentes.",
  },
];

const deliverables = [
  "Documento de arquitetura PlantPAx alinhado ao System Reference Manual",
  "Configuração de controladores ControlLogix (incluindo série P) e CompactLogix",
  "Programação de controle regulatório PID, intertravamentos, sequenciamento e diagnóstico embarcado",
  "Implementação da PlantPAx Library of Process Objects",
  "Telas de supervisão com governança de alarmes (ISA-18.2)",
  "Dashboards de alarmes, eventos, KPIs operacionais e saúde de rede",
  "Configuração de servidores virtualizados e domínio de aplicações",
  "Integração OPC UA e mapeamento de tags em AF Templates",
  "Integração de processo e energia com dispositivos industriais e IEDs",
  "Plano de testes (FAT/SAT), data book e as-built completos",
  "Treinamento operacional e de manutenção dos times do cliente",
];

const architectureNotes = [
  {
    title: "Tamanho da arquitetura",
    description:
      "Projetos pequenos, médios e grandes exigem decisões diferentes de PASS, OWS/EWS, redundância, virtualização e segregação de funções.",
  },
  {
    title: "Biblioteca e compatibilidade",
    description:
      "A versão do PlantPAx, firmware Logix, biblioteca de objetos e versões FactoryTalk precisam ser tratados como conjunto, não item isolado.",
  },
  {
    title: "Camada de informação",
    description:
      "Historian, AF Templates, OPC UA e relatórios precisam nascer no desenho do DCS para evitar retrabalho depois do startup.",
  },
];

const faq = [
  {
    q: "Vale a pena migrar de FactoryTalk View SE legado para PlantPAx?",
    a: "Depende do escopo de modernização e do horizonte de uso da planta. Avaliamos ROI, risco operacional e compatibilidade de hardware antes de recomendar uma estratégia — em alguns casos a migração faseada é melhor que o cutover total.",
  },
  {
    q: "PlantPAx 5.x exige troca completa do hardware?",
    a: "Não necessariamente. ControlLogix 5580 da série P é o ideal para PlantPAx 5.x, mas é possível operar com hardware existente desde que se respeitem os requisitos de firmware e de carga. O dimensionamento é parte do diagnóstico.",
  },
  {
    q: "Como vocês integram PlantPAx com PI System / AVEVA?",
    a: "Via OPC UA ou interface direta, com AF Templates pré-construídos para os objetos de processo. A integração é parte do projeto de engenharia, não um adendo posterior.",
  },
  {
    q: "Vocês trabalham com PlantPAx 3.x e 4.x ou só com 5.x?",
    a: "Atendemos todas as versões da plataforma, incluindo manutenção evolutiva em PlantPAx 3.5, 4.1 e 5.0. Cada versão tem particularidades de arquitetura que respeitamos.",
  },
  {
    q: "Qual a diferença entre PlantPAx e DeltaV/Experion?",
    a: "Todos são DCS modernos. PlantPAx é Rockwell, sob ControlLogix; DeltaV é Emerson; Experion é Honeywell. A escolha em cada planta é determinada pelo histórico instalado, ecossistema de instrumentação e formação da equipe — migrar entre eles é projeto grande.",
  },
  {
    q: "PlantPAx serve para planta pequena (até 500 I/O)?",
    a: "Funcionalmente sim, com PASS-C consolidando HMI/Data/Alarm em um servidor único. Mas o investimento de licenças, infra e engenharia pode ser desproporcional ao porte; em planta pequena, FactoryTalk View SE com ControlLogix tradicional costuma fazer mais sentido.",
  },
  {
    q: "Quais setores mais usam PlantPAx no Brasil?",
    a: "Açúcar e etanol, química, papel e celulose, alimentos e bebidas, mineração e siderurgia. Em cada um há particularidade de processo (batelada, contínuo, híbrido) que orienta o desenho de áreas, alarmes e redundância.",
  },
  {
    q: "Posso integrar PlantPAx com PI System / AVEVA?",
    a: "Sim, via OPC UA com AF Templates pré-mapeados aos objetos de processo PlantPAx. A integração transforma tags Logix em estrutura contextualizada para analytics e dashboards corporativos. É um dos caminhos mais comuns em planta integrada.",
  },
  {
    q: "Quanto custa um projeto PlantPAx típico?",
    a: "Para uma área média (500-1.500 I/O, 1 PASS, 2-4 controladores), o investimento típico de engenharia + licenças + comissionamento fica entre R$1 milhão e R$3 milhões. Plantas grandes ou multi-área evoluem proporcionalmente. Não publicamos faixas comerciais — o número exato depende de escopo e premissas.",
  },
];
---

<BaseLayout
  title="PlantPAx — Sistema de Controle Distribuído"
  description="Engenharia, implementação e suporte de PlantPAx (versões 3.x a 5.x) com arquitetura padronizada, biblioteca de objetos de processo e governança técnica."
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-12 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:py-24">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-integra-red mb-3">
          Solução · DCS Moderno
        </p>
        <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
          PlantPAx
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
          O PlantPAx é o sistema de controle distribuído moderno da Rockwell
          Automation. Integra controle de processo, energia, informação e
          segurança em uma única infraestrutura plant-wide. Nossa equipe atua
          em todas as versões da plataforma, com profundidade técnica
          comprovada em PlantPAx 3.x, 4.x e 5.x.
        </p>
      </div>
      <ManualReference
        image={plantpaxReference}
        alt="Arquitetura média PlantPAx com PASS, OWS, EWS, historian e controladores"
        title="Arquitetura média PlantPAx"
        source="Rockwell Automation · PlantPAx 5.40 Reference Architectures"
        caption="Referência visual pública para contextualizar sizing de servidores, clientes OWS/EWS, historian e controladores em uma arquitetura DCS."
        loading="eager"
      />
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Quando faz sentido"
        title="Problemas que esta solução resolve"
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2">
        {problems.map((p, i) => (
          <article class="rounded-lg border border-integra-gray-200 bg-integra-white p-7">
            <div class="flex items-start gap-4">
              <span
                class="font-mono text-xs font-semibold text-integra-red mt-1"
              >
                0{i + 1}
              </span>
              <div>
                <h3 class="text-lg font-semibold text-integra-gray-900 mb-2">
                  {p.title}
                </h3>
                <p class="text-sm leading-relaxed text-integra-gray-700">
                  {p.description}
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200">
    <div class="container-fluid py-20 max-w-4xl">
      <SectionHeader
        eyebrow="Como atuamos"
        title="Da arquitetura ao data book"
        description="Cada projeto PlantPAx segue o método Integra completo. Nada improvisado, nada deixado para depois."
        accent={true}
      />
      <div class="prose prose-lg max-w-none">
        <p class="text-base leading-relaxed text-integra-gray-700 lg:text-lg">
          Antes de qualquer linha de código, fazemos diagnóstico técnico da
          planta, levantamento de premissas e desenho de arquitetura de
          referência alinhada ao PlantPAx System Reference Manual e às
          práticas Rockwell. A engenharia detalhada vem depois, com revisão
          por pares e validação cruzada antes de subir em ambiente de
          produção.
        </p>
        <TechnicalCallout variant="note" title="Padrão de engenharia">
          <p>
            Todos os controladores são programados com a PlantPAx Library of
            Process Objects, alarmes seguem governança ISA-18.2 e o data
            book final inclui memorial técnico, narrativas de controle,
            plano de testes executado e as-built revisado.
          </p>
        </TechnicalCallout>
      </div>

      <DeliverableList items={deliverables} twoColumn={true} />

      <div class="my-14">
        <SectionHeader
          eyebrow="Referências públicas aplicadas"
          title="O que os manuais viram dentro do projeto"
          description="A arquitetura não é desenhada no olho. Usamos referências públicas do fabricante para validar versões, sizing, redundância, compatibilidade e premissas de lifecycle."
          accent={true}
        />
        <div class="grid gap-4 md:grid-cols-3">
          {architectureNotes.map((item) => (
            <article class="rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-5">
              <h3 class="text-base font-semibold text-integra-gray-900">
                {item.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-integra-gray-700">
                {item.description}
              </p>
            </article>
          ))}
        </div>
        <div class="mt-8 grid gap-8 lg:grid-cols-2">
          <ManualReference
            image={plantpaxPasscSmall}
            alt="Reference Architecture - Small PASS-C com até 10 clientes, 5 controladores e até 5000 tags Historian"
            title="Entry-tier: PASS-C consolidado para plantas até 1k I/O"
            source="Rockwell Automation · PlantPAx 5.20 Reference Architectures"
            caption="Print público da arquitetura Small: PASS-C reúne HMI, Data, Alarms e Batch em um único servidor consolidado — útil para projetos abaixo de 2.000 pontos de I/O."
          />
          <ManualReference
            image={plantpaxRedundantPrp}
            alt="Topologia PRP redundante com até 10 controladores em arquitetura PlantPAx"
            title="Mid/Large com redundância PRP: tolerância a falha de rede"
            source="Rockwell Automation · PlantPAx System Release 5.50 (PROCES-SG001W-EN-P)"
            caption="Print público da Reference Architecture: até 10 controladores com portas em grupos PRP alimentando LAN A e LAN B, mais a camada completa de servidores OWS, EWS e info repository."
          />
        </div>
        <div class="mt-8">
          <ManualReference
            image={controllogixReference}
            alt="Arquitetura ControlLogix High Availability mostrando topologia DLR convergente"
            title="Alta disponibilidade e topologias DLR"
            source="Rockwell Automation · ControlLogix High Availability Reference Architectures"
            caption="A escolha entre DLR, PRP, redundância e convergência de rede depende do risco operacional e da criticidade da área."
          />
        </div>
      </div>

      <StandardsBadges
        title="Normas e referências aplicadas neste tipo de projeto"
        standards={[
          { code: "ISA-95", description: "Integração empresa-controle" },
          { code: "ISA-88", description: "Controle de batelada" },
          { code: "ISA-18.2", description: "Gestão de alarmes" },
          { code: "ISA/IEC 62443", description: "Cibersegurança industrial" },
          { code: "PSRM", description: "PlantPAx System Reference Manual" },
          { code: "OPC UA", description: "Comunicação industrial" },
        ]}
      />

      <FAQAccordion items={faq} />
    </div>
  </section>

  <CtaBlock
    title="Tem um projeto PlantPAx para conversar?"
    description="Apresentamos arquitetura de referência, lista de entregáveis e cronograma com base no escopo da planta — antes de qualquer proposta comercial."
    primaryCta={{ href: "/contato?assunto=plantpax", label: "Falar com especialista" }}
    secondaryCta={{ href: "/solucoes/factorytalk", label: "Ver FactoryTalk Suite" }}
  />
</BaseLayout>
