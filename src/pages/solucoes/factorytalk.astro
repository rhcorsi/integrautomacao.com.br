---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { faqSchema, serviceSchema } from "@/utils/schema";
import SectionHeader from "@/components/SectionHeader.astro";
import DeliverableList from "@/components/DeliverableList.astro";
import StandardsBadges from "@/components/StandardsBadges.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import ManualReference from "@/components/ManualReference.astro";
import viewSeReference from "@/assets/manuals/factorytalk-view-se-distributed-small.jpg";
import historianReference from "@/assets/manuals/factorytalk-historian-logical-diagram.jpg";

const products = [
  {
    name: "FactoryTalk View SE",
    role: "Supervisão e SCADA distribuído com governança de alarmes e telas padronizadas.",
  },
  {
    name: "FactoryTalk Optix",
    role: "Visualização moderna baseada em web, ideal para integração com sistemas corporativos.",
  },
  {
    name: "FactoryTalk Batch",
    role: "Controle de bateladas conforme ISA-88, com receitas, fases e equipamentos padronizados.",
  },
  {
    name: "FactoryTalk Historian",
    role: "Coleta, contextualização e armazenamento de dados industriais em alta resolução.",
  },
  {
    name: "FactoryTalk AssetCentre",
    role: "Gestão de ativos, versionamento de software e auditoria de mudanças nos sistemas.",
  },
  {
    name: "ThinManager",
    role: "Gestão centralizada de thin clients industriais, segurança, mobilidade e disponibilidade.",
  },
  {
    name: "FactoryTalk Edge Gateway / DataMosaix",
    role: "Publicação e contextualização de dados industriais para camadas IIoT e analytics.",
  },
];

const deliverables = [
  "Padrão de telas de supervisão (style guide visual e de interação)",
  "Governança de alarmes alinhada à ISA-18.2",
  "Estrutura de áreas, equipamentos e tags padronizada",
  "Configuração de servidores redundantes (HMI/Data/Application)",
  "Integração com Historian e AF Templates do PI System / AVEVA",
  "Receitas e fases padronizadas (ISA-88) em FactoryTalk Batch",
  "Política de acesso por perfil e autenticação centralizada",
  "Gestão centralizada de terminais com ThinManager e publicação de aplicações",
  "Historiador, contextualização de tags e integração com camada de dados",
  "Backup, versionamento e auditoria com FactoryTalk AssetCentre",
  "Documentação operacional, treinamento e roadmap de evolução",
];

const architecturePatterns = [
  {
    title: "Local / Network Station",
    description:
      "Aplicações menores podem operar com estação local ou em rede, desde que a arquitetura de segurança, backup e manutenção esteja clara.",
  },
  {
    title: "Distributed",
    description:
      "Ambientes críticos pedem distribuição de HMI, Data Server, Directory, redundância e estações de operação por área.",
  },
  {
    title: "Operação + auditoria",
    description:
      "View/Optix, Historian, AssetCentre e ThinManager precisam compartilhar identidade, política de acesso e trilha de mudanças.",
  },
];

const faq = [
  {
    q: "Vocês mantêm sistemas FactoryTalk View SE antigos ou só implantam novos?",
    a: "Atuamos em ambos. Avaliamos sistemas existentes para identificar dívidas técnicas (alarmes mal configurados, telas inconsistentes, redundância parcial) e propomos roadmap de modernização sem parar a operação.",
  },
  {
    q: "FactoryTalk Optix é maduro o bastante para SCADA crítico?",
    a: "Sim, em casos específicos. Optix é excelente para visualização moderna, mobilidade e integração com sistemas corporativos. Para SCADA tradicional crítico, View SE ainda é a referência. Frequentemente fazemos arquiteturas híbridas com os dois.",
  },
  {
    q: "Como FactoryTalk se conecta com o PI System / AVEVA?",
    a: "Via FactoryTalk Historian para coleta de tags, e via OPC UA / AF Templates para contextualização no PI. A integração é parte do projeto de engenharia, com testes de tempo de resposta e consistência documentados.",
  },
  {
    q: "FactoryTalk Optix vai substituir o View SE?",
    a: "Hoje, não. Optix é interface moderna e complementar. Para SCADA crítico de planta, View SE continua padrão. A Rockwell já sinaliza convergência em médio prazo, mas não há cronograma público de descontinuação do View SE.",
  },
  {
    q: "Quantas licenças FactoryTalk preciso por planta?",
    a: "Depende do desenho. Em PlantPAx PASS único: 1 licença Server, 1 Directory, N clientes. Em arquitetura grande: múltiplos servidores, ThinManager para clientes, AssetCentre, Historian. O cálculo é parte do projeto, não de tabela genérica.",
  },
  {
    q: "FactoryTalk roda em VM (VMware/Hyper-V)?",
    a: "Sim, e é o modelo recomendado em arquitetura moderna. Rockwell publica matriz de compatibilidade VM por versão. Sizing de CPU, memória e I/O de disco precisa respeitar guia, senão aplicação degrada sob carga.",
  },
  {
    q: "FactoryTalk Historian é o mesmo que PI System?",
    a: "É a mesma base tecnológica, com escopo diferente. O FactoryTalk Historian SE é uma versão OEM do PI Server (OSIsoft, hoje AVEVA) integrada ao FactoryTalk: acompanha as versões do PI Server e usa os mesmos clientes e algoritmos (PI DataLink, compressão swinging-door). O PI System / AVEVA completo tem foco em volume massivo de tags, AF Templates ricos e ambientes multi-site. Para planta padrão Rockwell, o Historian SE atende a maior parte dos cenários. A escolha depende do escopo.",
  },
  {
    q: "Posso ter FactoryTalk e Wonderware/AVEVA na mesma planta?",
    a: "Sim. Em plantas multi-vendor, cada SCADA atende sua área e a integração de dados acontece na camada de informação (Historian, OPC UA, REST). Não recomendamos ter dois SCADAs na mesma área. A sobreposição gera confusão operacional e custo de manutenção dobrado.",
  },
];
---

<BaseLayout
  title="FactoryTalk Suite: supervisão e informação"
  description="Engenharia, implementação e suporte da suíte FactoryTalk: View SE, Optix, Batch, Historian, AssetCentre e ThinManager. Padronização e governança técnica."
  ogImage="/og/solucoes-factorytalk.png"
  jsonLd={[
    serviceSchema({
      name: "FactoryTalk Suite",
      description:
        "Engenharia, implementação e suporte da suíte FactoryTalk: View SE, Optix, Batch, Historian, AssetCentre e ThinManager. Padronização e governança técnica.",
      url: Astro.url.href,
    }),
    faqSchema(faq),
  ]}
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-12 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:py-24">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
          Solução · Supervisão e Informação
        </p>
        <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
          FactoryTalk Suite
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
          Trabalhamos com toda a suíte FactoryTalk para entregar supervisão,
          gestão de bateladas, historiação, gestão de ativos e thin clients
          industriais, com governança de alarmes, padronização de telas e
          auditoria de mudanças.
        </p>
      </div>
      <ManualReference
        image={viewSeReference}
        alt="Arquitetura distribuída FactoryTalk View SE"
        title="Arquitetura distribuída FactoryTalk View SE"
        source="Rockwell Automation - FactoryTalk View SE Reference Architectures"
        caption="Referência visual pública para explicar HMI Server, Data Server, clientes, diretório e serviços FactoryTalk."
        loading="eager"
      />
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Componentes da suíte"
        title="O que dominamos hoje"
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {products.map(({ name, role }) => (
          <article class="rounded-lg border border-integra-gray-200 bg-integra-white p-6">
            <code
              class="inline-block font-mono text-xs font-semibold text-integra-red-700 mb-3"
            >
              {name}
            </code>
            <p class="text-sm leading-relaxed text-integra-gray-700">{role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200">
    <div class="container-fluid py-20 max-w-4xl">
      <SectionHeader
        eyebrow="Como atuamos"
        title="Padronização visual + governança de alarmes + auditoria"
        description="Nossa entrega não é só configuração de telas. Cobre o ecossistema FactoryTalk com regras claras de operação, manutenção e evolução."
        accent={true}
      />

      <DeliverableList items={deliverables} twoColumn={true} />

      <div class="my-14">
        <SectionHeader
          eyebrow="Arquitetura de supervisão"
          title="Não é só escolher produtos FactoryTalk"
          description="A diferença está no desenho de aplicação: onde ficam os servidores, como as áreas são distribuídas, quem autentica, onde os dados são retidos e como as mudanças são auditadas."
          accent={true}
        />
        <div class="grid gap-4 md:grid-cols-3">
          {architecturePatterns.map((item) => (
            <article class="rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-5">
              <h3 class="text-base font-semibold text-integra-gray-900">
                {item.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-integra-gray-700">
                {item.description}
              </p>
            </article>
          ))}
        </div>
      </div>

      <div class="my-14 grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <ManualReference
          image={historianReference}
          alt="Diagrama lógico de arquitetura FactoryTalk Historian"
          title="Historian como camada de dados da suíte"
          source="Rockwell Automation - FactoryTalk Historian SE Reference Architectures"
          caption="Referência visual pública para contextualizar coleta, retenção e uso de dados históricos em arquitetura FactoryTalk."
        />
        <div>
          <h3 class="text-2xl font-semibold text-integra-gray-900">
            FactoryTalk não termina na tela
          </h3>
          <p class="mt-4 text-base leading-relaxed text-integra-gray-700">
            A suíte também cobre dados, ativos, terminais, bateladas e
            auditoria. Por isso a Integra trata FactoryTalk como ecossistema:
            View SE/Optix para operação, Batch para receitas, Historian para
            séries temporais, AssetCentre para gestão de mudanças, ThinManager
            para terminais e Edge/DataMosaix para evolução de dados.
          </p>
          <a
            href="/tecnologias/factorytalk-view-se/"
            class="mt-6 inline-flex rounded-md bg-integra-red px-4 py-2 text-sm font-semibold text-white hover:bg-integra-red-700"
          >
            Ver páginas técnicas FactoryTalk
          </a>
        </div>
      </div>

      <StandardsBadges
        standards={[
          { code: "ISA-88", description: "Bateladas em FactoryTalk Batch" },
          { code: "ISA-18.2", description: "Gestão de alarmes" },
          { code: "ISA-101", description: "Padrões de HMI" },
          { code: "ISA/IEC 62443", description: "Segurança em sistemas FactoryTalk" },
        ]}
      />

      <FAQAccordion items={faq} />
    </div>
  </section>

  <CtaBlock
    title="Quer modernizar sua supervisão sem parar a planta?"
    description="Avaliamos seu ambiente FactoryTalk atual e propomos roadmap faseado de modernização, preservando o que funciona, padronizando o que merece."
    primaryCta={{ href: "/contato/?assunto=factorytalk", label: "Pedir contato sobre FactoryTalk" }}
    secondaryCta={{ href: "/solucoes/plantpax/", label: "Ver PlantPAx" }}
  />
</BaseLayout>
