---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import ManualReference from "@/components/ManualReference.astro";
import cpwePlantwideZoning from "@/assets/manuals/cpwe-plantwide-zoning-levels.jpg";
import { Icon } from "astro-icon/components";

const sectors = [
  {
    icon: "lucide:wheat",
    name: "Açúcar e Etanol",
    description:
      "Setor onde os fundadores começaram suas carreiras. Conhecemos as particularidades de safra, paradas planejadas, intertravamentos NFPA e operação 24/7 de caldeira, moenda e fermentação.",
    pains: ["Janela de safra estreita", "Paradas têm custo altíssimo", "Sistemas heterogêneos legados"],
    href: "/setores/acucar-e-etanol/",
  },
  {
    icon: "lucide:droplet",
    name: "Etanol de Milho",
    description:
      "Plantas mais recentes, com tecnologia moderna e exigências de eficiência energética e rastreabilidade desde o projeto.",
    pains: ["Eficiência energética", "Rastreabilidade de receitas", "Modernização de controle de processo"],
    href: "/setores/etanol-de-milho/",
  },
  {
    icon: "lucide:tractor",
    name: "Agronegócio e Armazenagem de Grãos",
    description:
      "Silos, terminais, secadores. Sistemas com sazonalidade crítica e janelas de operação estreitas.",
    pains: ["Sazonalidade", "Confiabilidade em pico de safra", "Integração de múltiplos fornecedores"],
    href: "/setores/armazenagem-de-graos/",
  },
  {
    icon: "lucide:flask-conical",
    name: "Química e Fertilizantes",
    description:
      "Operações 24/7 com alta complexidade de processo, requisitos rigorosos de segurança e compliance.",
    pains: ["Cibersegurança OT crítica", "Sistemas redundantes", "Conformidade regulatória"],
    href: "/setores/quimica-e-fertilizantes/",
  },
  {
    icon: "lucide:utensils",
    name: "Alimentos e Bebidas",
    description:
      "Processos contínuos com exigências de segurança alimentar, rastreabilidade e integração de sistemas heterogêneos.",
    pains: ["Paradas de linha", "Rastreabilidade", "Integração de sistemas"],
    href: "/setores/alimentos-e-bebidas/",
  },
  {
    icon: "lucide:beef",
    name: "Frigoríficos",
    description:
      "Linhas com alta variabilidade, controle de receita por lote e exigências de rastreabilidade do animal ao produto final.",
    pains: ["Rastreabilidade", "Controle de receita por lote", "Auditoria de processo"],
    href: "/setores/frigorificos/",
  },
  {
    icon: "lucide:scale",
    name: "Fábricas de Ração",
    description:
      "Processos de dosagem e pesagem críticos, controle de receita preciso, automação de mistura.",
    pains: ["Precisão de dosagem", "Receitas e batelada", "Automação de mistura"],
    href: "/setores/fabricas-de-racao/",
  },
  {
    icon: "lucide:trees",
    name: "Papel e Celulose",
    description:
      "Processos contínuos de alta criticidade. Caldeiras, digestores, máquinas de papel.",
    pains: ["Continuidade operacional", "Controle multivariável", "Eficiência energética"],
    href: "/setores/papel-e-celulose/",
  },
  {
    icon: "lucide:droplets",
    name: "Saneamento e Tratamento de Efluentes",
    description:
      "Operação crítica de infraestrutura pública. Confiabilidade, monitoramento remoto, SCADA distribuído.",
    pains: ["SCADA distribuído", "Monitoramento remoto", "Confiabilidade 24/7"],
    href: "/setores/saneamento/",
  },
];

const decisionMatrix = [
  ["Safra / operação 24/7", "arquitetura redundante, janela de cutover e plano de rollback"],
  ["Rastreabilidade", "tags contextualizadas, historian, batelada e trilha de auditoria"],
  ["Segurança de processo", "intertravamentos, alarmes, teste funcional e documentação"],
  ["TI/OT e auditoria", "segmentação, IDMZ, IEC 62443 e gestão de acesso"],
];

const solucoesContexto = [
  {
    icon: "lucide:layers-3",
    title: "PlantPAx para indústria de processo",
    description:
      "Açúcar, química, papel, saneamento e farmacêutica operam DCS plant-wide com controle regulatório, batelada e governança de alarmes ISA-18.2.",
    href: "/solucoes/plantpax/",
    sectors: ["Açúcar e Etanol", "Química", "Papel e Celulose", "Saneamento"],
  },
  {
    icon: "lucide:gauge",
    title: "FactoryTalk para indústria discreta e híbrida",
    description:
      "Frigoríficos, ração, alimentos e linhas de produção exigem View SE, Optix, Batch e ThinManager com padronização visual e governança de mudanças.",
    href: "/solucoes/factorytalk/",
    sectors: ["Frigoríficos", "Fábricas de Ração", "Alimentos e Bebidas"],
  },
  {
    icon: "lucide:shield-check",
    title: "Cibersegurança OT em diferentes setores",
    description:
      "A análise de risco define zonas, conduítes e controles. Segmentação e IDMZ entram quando a arquitetura e os fluxos entre TI e OT exigem essa proteção.",
    href: "/solucoes/redes-iec-62443/",
    sectors: ["Aplicação transversal, conforme risco"],
  },
  {
    icon: "lucide:replace",
    title: "Modernização de legado",
    description:
      "PLC-5 e SLC 500 legados aparecem em diversos setores. A migração para Logix exige plano de cutover por área e estratégia de continuidade compatível com a planta.",
    href: "/solucoes/migracao-plc/",
    sectors: ["Aplicação transversal, conforme legado"],
  },
];
---

<BaseLayout
  title="Setores industriais atendidos"
  breadcrumbLeaf="Setores"
  description="Setores industriais que atendemos: açúcar e etanol, agronegócio, alimentos, química, frigoríficos, ração, papel e celulose, saneamento. Encontre o seu setor."
  ogImage="/og/setores.png"
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-12 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:py-24">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
          Setores
        </p>
        <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
          Setores onde já entregamos.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
          A Integra atua estritamente B2B, com foco em indústrias de médio e
          grande porte que operam processos críticos e contínuos. A escolha
          dos setores reflete onde nossa equipe acumula experiência real, não
          listas de marketing.
        </p>
      </div>
      <ManualReference
        image={cpwePlantwideZoning}
        alt="Plant-wide zoning em níveis 0-5 com Cell/Area, Site Operations e Data Center"
        title="Cada setor traduz para zonas, células e níveis funcionais"
        source="Cisco + Rockwell Automation - CPwE Deep Dive Architecture"
        caption="Referência pública CPwE mostra que cada setor é antes de tudo um conjunto de zonas funcionais, base para padronizar projeto, segurança e suporte."
        loading="eager"
      />
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Onde entregamos"
        title="Setores prioritários"
        description="Em cada setor reconhecemos dores específicas, normas aplicáveis e padrões de operação."
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {sectors.map((s) => (
          <article
            class="group rounded-lg border border-integra-gray-200 bg-integra-white p-6 flex flex-col gap-4 hover:-translate-y-1 hover:shadow-lg hover:shadow-integra-red/[0.02] hover:border-integra-red/60 transition-all duration-300 ease-out"
          >
            <div class="flex items-center gap-3">
              <div
                class="inline-flex size-10 items-center justify-center rounded-md bg-integra-gray-900 text-integra-white group-hover:bg-integra-red group-hover:scale-105 transition-all duration-300 ease-out"
              >
                <Icon name={s.icon} class="size-5" aria-hidden="true" />
              </div>
              <h3 class="text-base font-semibold text-integra-gray-900">
                {s.name}
              </h3>
            </div>
            <p class="text-sm leading-relaxed text-integra-gray-700">
              {s.description}
            </p>
            <ul class="mt-auto pt-3 border-t border-integra-gray-100 space-y-1.5 group-hover:border-integra-red/10 transition-colors duration-300">
              {s.pains.map((p) => (
                <li class="text-xs font-mono uppercase tracking-wider text-integra-gray-500 flex items-start gap-2">
                  <span class="text-integra-red-700 mt-0.5" aria-hidden="true">·</span>
                  {p}
                </li>
              ))}
            </ul>
            <a
              href={s.href}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-integra-red-700 hover:text-integra-red-700"
            >
              {s.href.startsWith("/setores/") ? `Ver página de ${s.name}` : `Conversar sobre ${s.name}`}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Critérios técnicos"
        title="O que muda de setor para setor"
        description="A tecnologia pode ser parecida, mas o risco operacional não é. Por isso cada conversa começa pelo processo, pela janela de parada e pelos requisitos de auditoria."
        accent={true}
      />
      <div class="grid gap-px overflow-hidden rounded-lg border border-integra-gray-200 bg-integra-gray-200 md:grid-cols-2">
        {decisionMatrix.map(([risk, response]) => (
          <article class="bg-integra-gray-50 p-6">
            <p class="mb-2 font-mono text-[11px] uppercase tracking-widest text-integra-red-700">
              Risco típico
            </p>
            <h3 class="text-lg font-semibold text-integra-gray-900">{risk}</h3>
            <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">
              Resposta Integra: {response}.
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Soluções por contexto setorial"
        title="Cada setor pede uma combinação diferente de tecnologias"
        description="A engenharia de processo contínuo difere da indústria discreta. Cibersegurança e modernização atravessam todos os setores."
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2">
        {solucoesContexto.map((s) => (
          <article class="group rounded-lg border border-integra-gray-200 bg-integra-white p-7 flex flex-col gap-4 hover:-translate-y-1 hover:shadow-xl hover:shadow-integra-red/[0.03] hover:border-integra-red/60 transition-all duration-300 ease-out">
            <div class="inline-flex size-10 items-center justify-center rounded-md bg-integra-gray-900 text-integra-white group-hover:bg-integra-red group-hover:scale-105 transition-all duration-300 ease-out">
              <Icon name={s.icon} class="size-5" aria-hidden="true" />
            </div>
            <h3 class="text-lg font-semibold text-integra-gray-900 leading-snug">
              {s.title}
            </h3>
            <p class="text-sm leading-relaxed text-integra-gray-700">
              {s.description}
            </p>
            <ul class="flex flex-wrap gap-2 pt-3 border-t border-integra-gray-100 group-hover:border-integra-red/10 transition-colors duration-300">
              {s.sectors.map((sec) => (
                <li class="text-[11px] font-mono uppercase tracking-wider text-integra-gray-500 px-2 py-1 bg-integra-gray-50 rounded-sm">
                  {sec}
                </li>
              ))}
            </ul>
            <a
              href={s.href}
              class="mt-auto inline-flex items-center gap-1.5 pt-2 text-sm font-semibold text-integra-red-700 hover:text-integra-red-700 group-hover:translate-x-0.5 transition-all duration-300"
            >
              Ver {s.title} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBlock
    title="Seu setor não está listado?"
    description="Atuamos em outras indústrias quando o desafio técnico se encaixa em nossa expertise (PlantPAx, FactoryTalk, redes industriais, IEC 62443). Conversamos para avaliar."
    primaryCta={{ href: "/contato/?assunto=diagnostico", label: "Conversar sobre meu setor" }}
    secondaryCta={{ href: "/cases/", label: "Ver cases publicados" }}
  />
</BaseLayout>
