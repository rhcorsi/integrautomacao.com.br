---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import { getPublishedCases } from "@/utils/collections";

const cases = await getPublishedCases();
---

<BaseLayout
  title="Cases de automação industrial"
  breadcrumbLeaf="Cases"
  description="Cases técnicos da Integra Automação Industrial: arquitetura, tecnologias aplicadas, problema, abordagem e resultados."
  ogImage="/og/cases.png"
>
  <PageHero
    eyebrow="Cases"
    title="Engenharia em campo, documentada."
    description="Publicamos contexto, restrições, abordagem, entregáveis e resultados que podem ser divulgados. Nomes de clientes e detalhes de arquitetura permanecem preservados quando o acordo de confidencialidade exige."
    breadcrumbLeaf="Cases"
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#cases-publicados"
        class="inline-flex items-center gap-2 rounded-md bg-integra-gray-900 px-5 py-3 text-sm font-semibold text-integra-white transition-colors hover:bg-integra-black"
      >
        Ver cases publicados <span aria-hidden="true">↓</span>
      </a>
      <a
        href="/contato/?assunto=portfolio"
        class="inline-flex items-center gap-2 rounded-md border border-integra-gray-300 px-5 py-3 text-sm font-semibold text-integra-gray-900 transition-colors hover:border-integra-gray-900"
      >
        Solicitar portfólio sob NDA
      </a>
    </div>
  </PageHero>

  <section id="cases-publicados" class="scroll-mt-32 border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      {cases.length === 0 ? (
        <div class="text-center py-16">
          <p class="text-base text-integra-gray-700 max-w-md mx-auto">
            Cases sendo publicados gradualmente. Para um portfólio detalhado
            sob NDA,
            <a href="/contato/" class="text-integra-red-700 hover:underline">
              entre em contato</a>.
          </p>
        </div>
      ) : (
        <div class="grid gap-8 md:grid-cols-2">
          {cases.map((c) => (
            <article class="group rounded-lg border border-integra-gray-200 bg-integra-white overflow-hidden hover:border-integra-gray-900 transition-colors">
              <a href={`/cases/${c.id}/`} class="block">
                {c.data.heroImage && (
                  <div class="relative aspect-[16/10] overflow-hidden bg-integra-gray-100">
                    <Image
                      src={c.data.heroImage}
                      alt={c.data.heroAlt ?? c.data.title}
                      widths={[400, 800, 1200]}
                      sizes="(min-width: 768px) 600px, 100vw"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    {c.data.heroIllustrative && (
                      <span class="absolute bottom-3 right-3 rounded-sm bg-integra-gray-950/85 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-integra-white">
                        Imagem ilustrativa
                      </span>
                    )}
                  </div>
                )}
                <div class="p-6">
                  <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-2">
                    {c.data.sector}
                  </p>
                  <h2 class="text-xl font-semibold text-integra-gray-900 mb-3 group-hover:text-integra-red-700 transition-colors">
                    {c.data.title}
                  </h2>
                  <p class="text-sm leading-relaxed text-integra-gray-700 mb-4">
                    {c.data.summary}
                  </p>
                  {c.data.tech.length > 0 && (
                    <ul class="flex flex-wrap gap-2 pt-3 border-t border-integra-gray-100">
                      {c.data.tech.slice(0, 5).map((t) => (
                        <li class="text-[11px] font-mono uppercase tracking-wider text-integra-gray-500 px-2 py-1 bg-integra-gray-50 rounded-sm">
                          {t}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <CtaBlock
    title="Quer detalhes de cases sob NDA?"
    description="Informe setor, desafio e tecnologia instalada. Selecionamos referências comparáveis para uma conversa e formalizamos NDA quando o nível de detalhe exigir."
    primaryCta={{ href: "/contato/?assunto=portfolio", label: "Solicitar portfólio sob NDA" }}
  />
</BaseLayout>
