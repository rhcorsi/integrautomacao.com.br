---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";

export async function getStaticPaths() {
  const cases = await getCollection("cases", ({ data }) => !data.draft);
  return cases.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = entry.data.pubDate.toLocaleDateString("pt-BR", {
  year: "numeric",
  month: "long",
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  ogType="article"
  ogImage={entry.data.heroImage ? "/og/case-default.png" : undefined}
>
  <article>
    <header class="border-b border-integra-gray-200 bg-integra-white">
      <div class="container-default py-16 lg:py-20">
        <a
          href="/cases/"
          class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-integra-gray-500 hover:text-integra-red-700 transition-colors mb-6"
        >
          <span aria-hidden="true">←</span> Cases
        </a>
        <p
          class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3"
        >
          {entry.data.sector} · {formattedDate}
        </p>
        <h1
          class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl mb-6"
        >
          {entry.data.title}
        </h1>
        <p class="text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
          {entry.data.summary}
        </p>
        {entry.data.tech.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2">
            {entry.data.tech.map((t) => (
              <li
                class="text-xs font-mono uppercase tracking-wider text-integra-gray-700 px-3 py-1.5 bg-integra-gray-100 rounded-sm border border-integra-gray-200"
              >
                {t}
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {entry.data.heroImage && (
      <div class="border-b border-integra-gray-200 bg-integra-gray-100">
        <div class="container-default py-8">
          <Image
            src={entry.data.heroImage}
            alt={entry.data.heroAlt ?? entry.data.title}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1024px) 1100px, 100vw"
            loading="eager"
            decoding="async"
            class="w-full rounded-lg shadow-sm"
          />
        </div>
      </div>
    )}

    <section class="border-b border-integra-gray-200">
      <div class="container-narrow py-16 lg:py-20">
        <div class="prose prose-lg max-w-none prose-headings:text-integra-gray-900 prose-a:text-integra-red-700 hover:prose-a:underline prose-strong:text-integra-gray-900 prose-code:bg-integra-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded-sm prose-code:text-sm">
          <Content components={{ aside: TechnicalCallout }} />
        </div>
      </div>
    </section>

    {entry.data.gallery.length > 0 && (
      <section class="border-b border-integra-gray-200 bg-integra-gray-50">
        <div class="container-default py-16">
          <h2 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-8">
            Imagens do projeto
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {entry.data.gallery.map((img) => (
              <Image
                src={img}
                alt=""
                widths={[400, 800]}
                sizes="(min-width: 1024px) 350px, 50vw"
                loading="lazy"
                decoding="async"
                class="rounded-md w-full h-auto"
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <CtaBlock
    title="Quer um caso técnico parecido com este?"
    description="Conversamos sobre arquitetura, escopo e premissas antes de qualquer proposta. Apresentamos referências detalhadas sob NDA."
  />
</BaseLayout>
