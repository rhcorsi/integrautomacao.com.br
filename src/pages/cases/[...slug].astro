---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";
import { COLLECTIVE_AUTHOR } from "@/data/authors";
import { CASE_SOLUTIONS, TECH_LINKS } from "@/data/caseRelations";
import { SITE } from "@/utils/site";
import { articleSchema } from "@/utils/schema";
import { getPublishedCases } from "@/utils/collections";
import { existsSync } from "node:fs";
import { join } from "node:path";

export async function getStaticPaths() {
  const cases = await getPublishedCases();
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = entry.data.pubDate.toLocaleDateString("pt-BR", {
  day: "numeric",
  year: "numeric",
  month: "long",
  timeZone: "UTC",
});
const publishedDateIso = entry.data.pubDate.toISOString().slice(0, 10);
const formattedUpdatedDate = entry.data.updatedDate?.toLocaleDateString("pt-BR", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const updatedDateIso = entry.data.updatedDate?.toISOString().slice(0, 10);

const caseUrl = new URL(Astro.url.pathname, SITE.url).toString();
// Convenção: o card social dedicado (public/og/case-<id>.png, 1200×630)
// tem prioridade sobre a hero bruta; se não existir, cai na hero com as
// dimensões reais — nunca quebra a imagem social silenciosamente.
const dedicatedOg = `/og/case-${entry.id}.png`;
const hasDedicatedOg = existsSync(
  join(process.cwd(), "public", "og", `case-${entry.id}.png`),
);
const socialImage = hasDedicatedOg
  ? dedicatedOg
  : (entry.data.heroImage?.src ?? dedicatedOg);
const socialImageSize = hasDedicatedOg
  ? { width: 1200, height: 630 }
  : entry.data.heroImage
    ? { width: entry.data.heroImage.width, height: entry.data.heroImage.height }
    : { width: 1200, height: 630 };
const caseLd = articleSchema({
  type: "Article",
  title: entry.data.title,
  description: entry.data.summary,
  url: caseUrl,
  datePublished: entry.data.pubDate,
  dateModified: entry.data.updatedDate ?? entry.data.pubDate,
  tags: entry.data.tech,
  image: new URL(socialImage, SITE.url).toString(),
});

const relatedTechnologies = entry.data.tech.flatMap((label) => {
  const link = TECH_LINKS[label];
  return link ? [{ label, ...link }] : [];
});
const relatedSolutions = CASE_SOLUTIONS[entry.id] ?? [];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  ogType="article"
  ogImage={socialImage}
  ogImageAlt={entry.data.heroAlt ?? entry.data.title}
  ogImageWidth={socialImageSize.width}
  ogImageHeight={socialImageSize.height}
  jsonLd={[caseLd]}
>
  <article>
    <header class="border-b border-integra-gray-200 bg-integra-white">
      <div class="container-default py-16 lg:py-20">
        <Breadcrumbs leaf={entry.data.title} />
        <p
          class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3"
        >
          {entry.data.sector} · <time datetime={publishedDateIso}>{formattedDate}</time>
          {formattedUpdatedDate && updatedDateIso && (
            <> · <span class="normal-case">Revisado em <time datetime={updatedDateIso}>{formattedUpdatedDate}</time> por <a href={COLLECTIVE_AUTHOR.href} class="underline underline-offset-2 hover:no-underline">{COLLECTIVE_AUTHOR.name}</a></span></>
          )}
        </p>
        <h1
          class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl mb-6"
        >
          {entry.data.title}
        </h1>
        <p class="text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
          {entry.data.summary}
        </p>
        {entry.data.tech.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2">
            {entry.data.tech.map((t) => (
              <li>
                {TECH_LINKS[t] ? (
                  <a
                    href={TECH_LINKS[t].href}
                    class="block rounded-sm border border-integra-gray-200 bg-integra-gray-100 px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-integra-gray-700 transition-colors hover:border-integra-gray-900"
                  >
                    {t}
                  </a>
                ) : (
                  <span class="block rounded-sm border border-integra-gray-200 bg-integra-gray-100 px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-integra-gray-700">
                    {t}
                  </span>
                )}
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {entry.data.heroImage && (
      <div class="border-b border-integra-gray-200 bg-integra-gray-100">
        <div class="container-default py-8">
          <figure>
            <div class="relative overflow-hidden rounded-lg shadow-sm">
              <Image
                src={entry.data.heroImage}
                alt={entry.data.heroAlt ?? entry.data.title}
                widths={[800, 1200, 1600]}
                sizes="(min-width: 1024px) 1100px, 100vw"
                loading="eager"
                decoding="async"
                class="w-full"
              />
              {entry.data.heroIllustrative && (
                <span class="absolute bottom-3 right-3 rounded-sm bg-integra-gray-950/85 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-integra-white">
                  Imagem ilustrativa
                </span>
              )}
            </div>
            {entry.data.heroIllustrative && (
              <figcaption class="mt-3 text-xs leading-relaxed text-integra-gray-500">
                Imagem de apoio. Não representa a instalação, a equipe ou o
                cliente deste case.
              </figcaption>
            )}
          </figure>
        </div>
      </div>
    )}

    <section class="border-b border-integra-gray-200">
      <div class="container-narrow py-16 lg:py-20">
        <div class="prose prose-lg max-w-none prose-headings:text-integra-gray-900 prose-a:text-integra-red-700 hover:prose-a:underline prose-strong:text-integra-gray-900 prose-code:bg-integra-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded-sm prose-code:text-sm">
          <Content components={{ aside: TechnicalCallout }} />
        </div>
      </div>
    </section>

    {(relatedTechnologies.length > 0 || relatedSolutions.length > 0) && (
      <section class="border-b border-integra-gray-200 bg-integra-gray-50">
        <div class="container-default py-16">
          <p class="mb-3 font-mono text-xs uppercase tracking-widest text-integra-red-700">
            Do case para a arquitetura
          </p>
          <h2 class="max-w-3xl text-3xl font-semibold text-integra-gray-900">
            Tecnologias e soluções relacionadas
          </h2>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-integra-gray-700">
            O case resume o relato técnico da execução. As páginas abaixo detalham os critérios técnicos e o escopo de contratação de cada frente.
          </p>
          <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {relatedTechnologies.map((technology) => (
              <a
                href={technology.href}
                class="rounded-lg border border-integra-gray-200 bg-integra-white p-6 transition-colors hover:border-integra-gray-900"
              >
                <p class="mb-3 font-mono text-xs uppercase tracking-widest text-integra-red-700">
                  Tecnologia
                </p>
                <h3 class="text-lg font-semibold text-integra-gray-900">{technology.label}</h3>
                <p class="mt-3 text-sm leading-relaxed text-integra-gray-600">{technology.description}</p>
              </a>
            ))}
            {relatedSolutions.map((solution) => (
              <a
                href={solution.href}
                class="rounded-lg border border-integra-gray-200 bg-integra-white p-6 transition-colors hover:border-integra-gray-900"
              >
                <p class="mb-3 font-mono text-xs uppercase tracking-widest text-integra-red-700">
                  Solução
                </p>
                <h3 class="text-lg font-semibold text-integra-gray-900">{solution.label}</h3>
                <p class="mt-3 text-sm leading-relaxed text-integra-gray-600">{solution.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {entry.data.gallery.length > 0 && (
      <section class="border-b border-integra-gray-200 bg-integra-gray-50">
        <div class="container-default py-16">
          <h2 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-8">
            Imagens do projeto
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {entry.data.gallery.map((img, i) => (
              <Image
                src={img}
                alt={`${entry.data.title}, registro ${i + 1} de ${entry.data.gallery.length}`}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 350px, 50vw"
                loading="lazy"
                decoding="async"
                class="rounded-md w-full h-auto"
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <CtaBlock
    title="Quer um caso técnico parecido com este?"
    description="Conversamos sobre arquitetura, escopo e premissas antes de qualquer proposta. Apresentamos referências detalhadas sob NDA."
  />
</BaseLayout>
