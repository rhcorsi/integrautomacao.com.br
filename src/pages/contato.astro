---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import EmailLink from "@/components/EmailLink.astro";
import { COMPANY } from "@/utils/site";

const phoneCommercial = COMPANY.phones[0];
const phoneWhatsApp = COMPANY.phones.find((p) => p.whatsapp)!;
---

<BaseLayout
  title="Contato"
  description="Fale com a Integra. Conversamos sobre arquitetura, método e referências antes de qualquer proposta. Maringá-PR, atuação nacional."
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-16 lg:py-20">
      <p class="text-xs font-mono uppercase tracking-widest text-integra-red mb-3">
        Contato
      </p>
      <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
        Conversa técnica direta.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl">
        Apresentamos arquitetura, método e referências antes de qualquer
        proposta comercial. Retornamos em até 1 dia útil.
      </p>
    </div>
  </section>

  <section class="border-b border-integra-gray-200">
    <div class="container-fluid py-16 lg:py-20 grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-3 order-2 lg:order-1">
        <h2 class="text-2xl font-semibold text-integra-gray-900 mb-2">
          Envie uma mensagem
        </h2>
        <p class="text-sm text-integra-gray-700 mb-8">
          Quanto mais detalhes do contexto, melhor a resposta inicial.
          Confidencialidade preservada (NDA disponível mediante solicitação).
        </p>
        <ContactForm />
      </div>

      <aside class="lg:col-span-2 order-1 lg:order-2 space-y-8 lg:pl-6 lg:border-l lg:border-integra-gray-200">
        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            Email
          </h3>
          <EmailLink
            email={COMPANY.email}
            class="text-base font-medium text-integra-gray-900 hover:text-integra-red transition-colors break-all"
          >
            {COMPANY.email}
          </EmailLink>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            Telefone
          </h3>
          <p class="space-y-1">
            <a
              href={`tel:${phoneCommercial.value.replace(/\s+/g, "")}`}
              class="block text-base font-medium text-integra-gray-900 hover:text-integra-red transition-colors"
            >
              {phoneCommercial.display} <span class="text-xs font-mono text-integra-gray-500 ml-1">{phoneCommercial.label}</span>
            </a>
            <a
              href={`https://wa.me/${phoneWhatsApp.value.replace(/[^\d]/g, "")}`}
              rel="noopener noreferrer"
              class="block text-base font-medium text-integra-gray-900 hover:text-integra-red transition-colors"
            >
              {phoneWhatsApp.display} <span class="text-xs font-mono text-integra-gray-500 ml-1">WhatsApp</span>
            </a>
          </p>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            Endereço
          </h3>
          <address class="not-italic text-base text-integra-gray-900 leading-relaxed">
            {COMPANY.address.street}<br />
            {COMPANY.address.city} - {COMPANY.address.state}<br />
            CEP {COMPANY.address.postalCode}
          </address>
          <p class="mt-3 text-xs font-mono uppercase tracking-wider text-integra-gray-500">
            Atuação em todo o Brasil
          </p>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            CNPJ
          </h3>
          <p class="text-base font-medium text-integra-gray-900">
            {COMPANY.taxId}
          </p>
          <p class="mt-1 text-sm text-integra-gray-700">
            {COMPANY.legalName}
          </p>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            LinkedIn
          </h3>
          <a
            href={COMPANY.social.linkedin}
            rel="noopener noreferrer"
            class="text-base font-medium text-integra-gray-900 hover:text-integra-red transition-colors"
          >
            /integra-automacao-industrial
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
