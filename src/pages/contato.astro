---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ContactForm from "@/components/ContactForm.astro";
import EmailLink from "@/components/EmailLink.astro";
import { COMPANY, PHONE_COMMERCIAL, PHONE_WHATSAPP } from "@/utils/site";

const phoneCommercial = PHONE_COMMERCIAL;
const phoneWhatsApp = PHONE_WHATSAPP;
---

<BaseLayout
  title="Contato técnico para automação industrial"
  breadcrumbLeaf="Contato"
  description="Solicite uma triagem técnica com a Integra: contexto, risco, base instalada e próximo passo. Maringá-PR, atuação nacional. Envie sua mensagem."
  ogImage="/og/contato.png"
>
  <PageHero
    eyebrow="Contato"
    title="Comece pela triagem técnica."
    description="A primeira conversa serve para entender o contexto, verificar aderência e definir o próximo passo. Ela não substitui levantamento de campo nem diagnóstico documentado. Nosso prazo-alvo de retorno inicial é de 1 dia útil."
    breadcrumbLeaf="Contato"
  />

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-12 lg:py-16">
      <div class="grid gap-px overflow-hidden rounded-lg border border-integra-gray-200 bg-integra-gray-200 md:grid-cols-3">
        <article class="bg-integra-white p-6">
          <p class="font-mono text-[11px] uppercase tracking-widest text-integra-red-700">01 · Primeiro contato</p>
          <h2 class="mt-3 text-lg font-semibold text-integra-gray-900">Triagem técnica</h2>
          <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">
            Conversa inicial para enquadrar problema, criticidade, tecnologia
            instalada e prazo. O resultado é uma orientação de próximo passo,
            não uma arquitetura específica.
          </p>
        </article>
        <article class="bg-integra-white p-6">
          <p class="font-mono text-[11px] uppercase tracking-widest text-integra-red-700">02 · Quando é necessário aprofundar</p>
          <h2 class="mt-3 text-lg font-semibold text-integra-gray-900">Diagnóstico de engenharia</h2>
          <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">
            Levantamento, inventário, leitura de risco e entregáveis definidos.
            Quando o caso exige diagnóstico formal, escopo e condição comercial
            são apresentados antes do início.
          </p>
        </article>
        <article class="bg-integra-white p-6">
          <p class="font-mono text-[11px] uppercase tracking-widest text-integra-red-700">03 · Validação de experiência</p>
          <h2 class="mt-3 text-lg font-semibold text-integra-gray-900">Portfólio sob NDA</h2>
          <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">
            Selecionamos referências comparáveis ao contexto informado. Cases
            confidenciais são apresentados em reunião e, quando necessário,
            mediante acordo de confidencialidade.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200">
    <div class="container-fluid py-16 lg:py-20 grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <h2 class="text-2xl font-semibold text-integra-gray-900 mb-2">
          Envie o contexto
        </h2>
        <p class="text-sm text-integra-gray-700 mb-8">
          Escolha o tipo de contato e compartilhe apenas as informações
          necessárias para a resposta inicial. Não envie backups, credenciais
          ou documentos confidenciais por este formulário.
        </p>
        <ContactForm />
      </div>

      <aside class="lg:col-span-2 space-y-8 lg:pl-6 lg:border-l lg:border-integra-gray-200">
        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            Email
          </h3>
          <EmailLink
            email={COMPANY.email}
            class="text-base font-medium text-integra-gray-900 hover:text-integra-red-700 transition-colors break-all"
          >
            {COMPANY.email}
          </EmailLink>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            Telefone
          </h3>
          <p class="space-y-1">
            <a
              href={`tel:${phoneCommercial.value.replace(/\s+/g, "")}`}
              class="block text-base font-medium text-integra-gray-900 hover:text-integra-red-700 transition-colors"
            >
              {phoneCommercial.display} <span class="text-xs font-mono text-integra-gray-500 ml-1">{phoneCommercial.label}</span>
            </a>
            <a
              href={`https://wa.me/${phoneWhatsApp.value.replace(/[^\d]/g, "")}`}
              rel="noopener noreferrer"
              class="block text-base font-medium text-integra-gray-900 hover:text-integra-red-700 transition-colors"
            >
              {phoneWhatsApp.display} <span class="text-xs font-mono text-integra-gray-500 ml-1">WhatsApp</span>
            </a>
          </p>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            Endereço
          </h3>
          <address class="not-italic text-base text-integra-gray-900 leading-relaxed">
            {COMPANY.address.street}<br />
            {COMPANY.address.city} - {COMPANY.address.state}<br />
            CEP {COMPANY.address.postalCode}
          </address>
          <p class="mt-3 text-xs font-mono uppercase tracking-wider text-integra-gray-500">
            Atuação em todo o Brasil
          </p>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            CNPJ
          </h3>
          <p class="text-base font-medium text-integra-gray-900">
            {COMPANY.taxId}
          </p>
          <p class="mt-1 text-sm text-integra-gray-700">
            {COMPANY.legalName}
          </p>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-3">
            LinkedIn
          </h3>
          {/* Texto do link deve refletir o destino real (slug /company/). */}
          <a
            href={COMPANY.social.linkedin}
            rel="noopener noreferrer"
            class="text-base font-medium text-integra-gray-900 hover:text-integra-red-700 transition-colors"
          >
            /company/integrautomacao
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
