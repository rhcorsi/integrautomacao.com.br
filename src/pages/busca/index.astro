---
/**
 * Busca interna — índice estático do Pagefind, gerado pós-build
 * (`npm run build` → `pagefind --site dist`). Em `astro dev` o índice não
 * existe; a página mostra o aviso de indisponibilidade em vez de quebrar.
 * noindex proposital: página de resultados não é destino de busca externa.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Buscar no site da Integra Automação Industrial"
  description="Busca interna do site da Integra Automação Industrial: soluções, tecnologias, guias, cases e artigos técnicos."
  breadcrumbLeaf="Busca"
  noindex={true}
>
  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-narrow py-10 lg:py-14">
      {/* A região interativa não entra no próprio índice. */}
      <div data-pagefind-ignore>
        <p class="mb-3 font-mono text-xs uppercase tracking-widest text-integra-red-700">Busca</p>
        <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-integra-gray-900 lg:text-5xl">
          Encontre soluções, tecnologias e guias.
        </h1>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-integra-gray-700 lg:text-lg">
          Consulte soluções, catálogo técnico, setores, guias, cases e artigos do blog.
        </p>
        <div class="relative mt-7">
          <svg
            class="pointer-events-none absolute left-5 top-1/2 size-5 -translate-y-1/2 text-integra-gray-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
          <input
            id="site-search"
            type="search"
            enterkeyhint="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Buscar por tecnologia, norma, setor… (ex.: PlantPAx, IEC 62443, migração PLC-5)"
            aria-label="Buscar no site"
            class="w-full rounded-lg border border-integra-gray-300 bg-integra-white py-4 pl-14 pr-5 text-base text-integra-gray-900 shadow-sm focus:border-integra-gray-900 focus:outline-none focus:ring-2 focus:ring-integra-red/40"
          />
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <label for="search-kind" class="text-sm font-semibold text-integra-gray-800">Tipo de conteúdo</label>
          <select id="search-kind" class="rounded-md border border-integra-gray-300 bg-integra-white px-3 py-2 text-sm text-integra-gray-900 focus:border-integra-gray-900 focus:outline-none focus:ring-2 focus:ring-integra-red/40">
            <option value="">Todos</option>
            <option value="technology">Tecnologia</option>
            <option value="solution">Solução</option>
            <option value="guide-article">Guia/artigo</option>
            <option value="sector">Setor</option>
            <option value="case">Case</option>
            <option value="event">Evento</option>
          </select>
        </div>

        <p
          id="search-status"
          role="status"
          aria-live="polite"
          class="mt-4 min-h-[1.25rem] font-mono text-xs uppercase tracking-wider text-integra-gray-500"
        >
          Digite para buscar — o índice é carregado sob demanda.
        </p>

        <ol id="search-results" class="mt-6 grid gap-4"></ol>
        <button id="search-more" type="button" hidden class="mt-6 rounded-md border border-integra-gray-900 bg-integra-white px-5 py-3 text-sm font-semibold text-integra-gray-900 transition-colors hover:bg-integra-gray-900 hover:text-integra-white">
          Carregar mais resultados
        </button>

        <noscript>
          <p class="mt-6 rounded-md border border-integra-gray-300 bg-integra-white p-4 text-sm text-integra-gray-800">
            A busca interna exige JavaScript. Navegue pelo menu ou escreva para
            <a href="mailto:comercial@integrautomacao.com.br" class="font-semibold text-integra-red-700 underline underline-offset-2">comercial@integrautomacao.com.br</a>.
          </p>
        </noscript>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Destaque dos termos encontrados (o Pagefind envolve matches em <mark>). */
  #search-results mark {
    background: rgba(227, 6, 19, 0.12);
    color: inherit;
    padding-inline: 0.1em;
    border-radius: 2px;
  }
</style>

<script>
  import { initSearchPage } from "@/scripts/searchPage";
  initSearchPage();
</script>
