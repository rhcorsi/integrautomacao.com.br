---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ValueCard from "@/components/ValueCard.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import { Image } from "astro:assets";
import empresaHero from "@/assets/hero/empresa-hero.png";
import liderancaIntegra from "@/assets/eventos/ena-2025-belo-horizonte/foto-01.jpg";

const valores = [
  {
    icon: "lucide:medal",
    title: "Excelência Técnica",
    description:
      "Premissas, decisões e critérios de aceite são registrados para que a qualidade possa ser verificada.",
  },
  {
    icon: "lucide:list-checks",
    title: "Padronização e Método",
    description:
      "Acreditamos que organização e documentação são tão importantes quanto o código que roda no controlador.",
  },
  {
    icon: "lucide:scale",
    title: "Integridade e Transparência",
    description:
      "Prazos, escopo, riscos e limitações são tratados com clareza desde a qualificação do projeto.",
  },
  {
    icon: "lucide:handshake",
    title: "Responsabilidade com o Cliente",
    description:
      "A continuidade técnica é planejada do projeto à estabilização e às evoluções futuras do sistema.",
  },
  {
    icon: "lucide:trending-up",
    title: "Evolução Contínua",
    description:
      "Fome por aprendizado e atualização constante nas tecnologias e normas que regem nosso campo.",
  },
];

const timeline = [
  {
    year: 1996,
    title: "Início da carreira de Joldmar Oliveira",
    description:
      "Joldmar inicia sua atuação em automação industrial em uma usina de açúcar e etanol.",
  },
  {
    year: 2010,
    title: "Início da carreira de Rafhael Corsi",
    description:
      "Rafhael começa em automação na Conapi, desenvolvendo sólida experiência no setor.",
  },
  {
    year: 2010,
    title: "Joldmar Oliveira passa a atuar na Conapi",
    description:
      "Depois da experiência iniciada em usina de açúcar e etanol, Joldmar amplia sua atuação em integração e automação industrial.",
  },
  {
    year: 2016,
    title: "Fundação da Integra Automação Industrial",
    description:
      "Joldmar e Rafhael fundam a empresa com o objetivo de oferecer soluções estruturadas em automação para diversos setores.",
  },
  {
    year: 2018,
    title: "Especialização em Rockwell Automation",
    description:
      "Consolidação como integradora especialista, primeiros projetos de maior complexidade na plataforma Rockwell.",
  },
  {
    year: 2022,
    title: "Integradora Bronze Rockwell",
    description:
      "Conquista do título Bronze no programa Partner Network da Rockwell Automation.",
  },
  {
    year: 2023,
    title: "Integradora Silver Rockwell",
    description:
      "Promoção para o nível Silver, que exige comprovação contínua de competência técnica e aderência aos padrões de projeto da Rockwell.",
  },
  {
    year: 2024,
    title: "Expansão da equipe e dos setores atendidos",
    description:
      "Diversificação de setores e aumento da capacidade de atendimento simultâneo a múltiplos projetos.",
  },
  {
    year: 2026,
    title: "Sistematização da marca",
    description:
      "Reformulação completa da identidade institucional para refletir a maturidade técnica e o posicionamento de Engenharia com Integridade.",
  },
];
---

<BaseLayout
  title="Integra Automação Industrial: empresa"
  description="Empresa brasileira de engenharia e integração de sistemas industriais, fundada em 2016 em Maringá-PR. Arquitetura, padronização e governança técnica."
  ogImage="/og/empresa.png"
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-12 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:py-24">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
          Sobre a Integra
        </p>
        <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
          Engenharia para acompanhar o sistema do projeto à sustentação.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
          A Integra Automação Industrial é uma empresa de engenharia e integração
          tecnológica para o setor industrial, fundada em 2016 em Maringá-PR.
          Atuamos como parceiros de longo prazo na entrega de arquiteturas
          dimensionadas, seguras e documentadas, com foco em confiabilidade
          operacional e governança técnica do projeto à operação.
        </p>
      </div>
      <div class="relative">
        <div class="relative overflow-hidden rounded-lg shadow-2xl ring-1 ring-integra-gray-900/10 bg-integra-white">
          <Image
            src={empresaHero}
            alt="Imagem ilustrativa de centro de engenharia com controladores e telas de supervisão industrial"
            widths={[400, 800, 1200]}
            sizes="(min-width: 1024px) 600px, 100vw"
            loading="eager"
            decoding="async"
            class="w-full aspect-[16/10] object-cover object-center"
          />
          <p class="absolute bottom-3 right-3 rounded-sm bg-integra-gray-950/85 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-integra-white">
            Imagem ilustrativa
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <figure>
          <Image
            src={liderancaIntegra}
            alt="Rafhael Henrique Corsi Feitosa e Joldmar Oliveira diante do estande da Rockwell Automation no ENA 2025"
            widths={[500, 900, 1300]}
            sizes="(min-width: 1024px) 560px, 100vw"
            loading="lazy"
            decoding="async"
            class="w-full rounded-lg border border-integra-gray-200 object-cover shadow-lg"
          />
          <figcaption class="mt-3 text-xs leading-relaxed text-integra-gray-500">
            Rafhael Henrique Corsi Feitosa e Joldmar Oliveira, fundadores e
            diretores da Integra, no ENA 2025 em Belo Horizonte.
          </figcaption>
        </figure>
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700">
            Liderança
          </p>
          <h2 class="mt-3 text-3xl font-semibold text-integra-gray-900 sm:text-4xl">
            Experiência anterior à empresa, incorporada ao método de trabalho.
          </h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            <article class="rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-6">
              <h3 class="text-lg font-semibold text-integra-gray-900">Joldmar Oliveira</h3>
              <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-integra-red-700">
                Diretor e cofundador
              </p>
              <p class="mt-4 text-sm leading-relaxed text-integra-gray-700">
                Iniciou a carreira em automação em 1996, em uma usina de açúcar
                e etanol. Passou a atuar na Conapi em 2010 e cofundou a Integra
                em 2016.
              </p>
            </article>
            <article class="rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-6">
              <h3 class="text-lg font-semibold text-integra-gray-900">Rafhael Henrique Corsi Feitosa</h3>
              <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-integra-red-700">
                Diretor e cofundador
              </p>
              <p class="mt-4 text-sm leading-relaxed text-integra-gray-700">
                Iniciou a atuação em automação industrial na Conapi em 2010 e
                cofundou a Integra com Joldmar em 2016.
              </p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p
            class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3"
          >
            Propósito
          </p>
          <h2 class="text-3xl font-semibold text-integra-gray-900 mb-4">
            Por que a Integra existe
          </h2>
          <p class="text-base leading-relaxed text-integra-gray-700 lg:text-lg">
            Elevar o padrão técnico, a segurança e a governança das indústrias
            por meio de sistemas de automação dimensionados, documentados e
            mantidos no longo prazo, construindo relações de confiança com
            clientes e parceiros baseadas em honestidade, ética e compromisso.
          </p>
        </div>
        <div>
          <p
            class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3"
          >
            Visão
          </p>
          <h2 class="text-3xl font-semibold text-integra-gray-900 mb-4">
            Onde queremos chegar
          </h2>
          <p class="text-base leading-relaxed text-integra-gray-700 lg:text-lg">
            Ser reconhecida como referência em engenharia de sistemas
            industriais e integração tecnológica no Brasil, sinônimo de
            governança técnica, segurança operacional e parceria estratégica
            de longo prazo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Valores inegociáveis"
        title="Cinco regras de conduta que não mudam com o mercado"
        description="Nossos valores não são flexibilizados por pressão comercial. São extraídos diretamente da cultura dos fundadores e validados em cada projeto."
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {valores.map((v, i) => (
          <ValueCard
            icon={v.icon}
            title={v.title}
            description={v.description}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section id="timeline" class="scroll-mt-32 border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="História"
        title="Uma trajetória de respeito e excelência"
        description="Trajetórias iniciadas em 1996 e 2010, com a Integra fundada em 2016. A linha do tempo registra os marcos públicos dessa história."
        accent={true}
      />
      <ol class="relative border-l-2 border-integra-gray-200 ml-2 space-y-10">
        {timeline.map((item) => (
          <li class="pl-8 relative">
            <span
              class="absolute -left-[9px] top-1 size-4 rounded-full bg-integra-red ring-4 ring-integra-gray-50"
              aria-hidden="true"
            />
            <div class="font-mono text-sm font-semibold text-integra-red-700 mb-1">
              {item.year}
            </div>
            <h3 class="text-lg font-semibold text-integra-gray-900 mb-1">
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-integra-gray-700 max-w-2xl">
              {item.description}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBlock
    variant="dark"
    title="Quer verificar se a Integra é aderente ao seu contexto?"
    description="Na triagem inicial, enquadramos planta, risco, base instalada e prazo. Diagnóstico documentado e arquitetura específica só começam depois de escopo definido."
    primaryCta={{ href: "/contato/?assunto=triagem", label: "Solicitar triagem técnica" }}
  />
</BaseLayout>
