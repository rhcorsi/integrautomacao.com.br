---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";
import { SITE } from "@/utils/site";
import { articleSchema } from "@/utils/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateFmt = entry.data.pubDate.toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});

const postUrl = new URL(Astro.url.pathname, SITE.url).toString();
// Arte social: dedicada (frontmatter ogImage) > hero do post > padrão do site.
const socialImage = entry.data.ogImage ?? entry.data.heroImage?.src;
const articleLd = articleSchema({
  title: entry.data.title,
  description: entry.data.description,
  url: postUrl,
  datePublished: entry.data.pubDate,
  dateModified: entry.data.updatedDate,
  author: entry.data.author,
  tags: entry.data.tags,
  image: socialImage ? new URL(socialImage, SITE.url).toString() : undefined,
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  ogImage={socialImage}
  jsonLd={[articleLd]}
>
  <article>
    <header class="border-b border-integra-gray-200 bg-integra-white">
      <div class="container-narrow py-16 lg:py-20">
        <Breadcrumbs leaf={entry.data.title} />
        <p
          class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3"
        >
          {dateFmt}
          {entry.data.tags.length > 0 && (
            <span> · {entry.data.tags.join(" · ")}</span>
          )}
        </p>
        <h1
          class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl mb-6"
        >
          {entry.data.title}
        </h1>
        <p class="text-lg leading-relaxed text-integra-gray-700 lg:text-xl">
          {entry.data.description}
        </p>
        <p class="mt-8 text-xs font-mono uppercase tracking-wider text-integra-gray-500">
          {entry.data.author}
        </p>
      </div>
    </header>

    {entry.data.heroImage && (
      <div class="border-b border-integra-gray-200 bg-integra-gray-100">
        <div class="container-default py-8">
          <Image
            src={entry.data.heroImage}
            alt={entry.data.heroAlt ?? entry.data.title}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1024px) 1100px, 100vw"
            loading="eager"
            decoding="async"
            class="w-full rounded-lg"
          />
        </div>
      </div>
    )}

    <section class="border-b border-integra-gray-200">
      <div class="container-narrow py-16 lg:py-20">
        <div
          class="prose prose-lg max-w-none prose-headings:text-integra-gray-900 prose-a:text-integra-red-700 hover:prose-a:underline prose-strong:text-integra-gray-900 prose-code:bg-integra-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded-sm prose-code:text-sm prose-blockquote:border-l-integra-red prose-blockquote:bg-integra-gray-50 prose-blockquote:p-4 prose-blockquote:rounded-md prose-blockquote:not-italic"
        >
          <Content components={{ aside: TechnicalCallout }} />
        </div>
      </div>
    </section>
  </article>

  <CtaBlock
    title="Quer aplicar isso na sua operação?"
    description="Quando a teoria encontra a planta, surgem as perguntas certas. Conversamos sobre arquitetura, normas e decisões técnicas em qualquer estágio do projeto."
    variant="dark"
  />
</BaseLayout>
