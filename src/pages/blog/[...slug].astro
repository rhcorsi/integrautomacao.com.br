---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";
import { COLLECTIVE_AUTHOR } from "@/data/authors";
import { SITE } from "@/utils/site";
import { articleSchema } from "@/utils/schema";
import { getPublishedPosts } from "@/utils/collections";
import { existsSync } from "node:fs";
import { join } from "node:path";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formatDate = (date: Date) =>
  date.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

const publishedDate = formatDate(entry.data.pubDate);
const publishedDateIso = entry.data.pubDate.toISOString().slice(0, 10);
const reviewedDate = entry.data.updatedDate
  ? formatDate(entry.data.updatedDate)
  : undefined;
const reviewedDateIso = entry.data.updatedDate?.toISOString().slice(0, 10);

const postUrl = new URL(Astro.url.pathname, SITE.url).toString();
// Arte social: frontmatter ogImage > hero > card dedicado gerado > padrão
// da seção. O card dedicado só entra se o arquivo EXISTIR em public/og/ —
// um post novo sem arte nunca quebra a imagem social silenciosamente.
const dedicatedOg = `/og/blog-${entry.id}.png`;
const dedicatedOgExists = existsSync(
  join(process.cwd(), "public", "og", `blog-${entry.id}.png`),
);
const social = entry.data.ogImage
  ? { src: entry.data.ogImage, width: 1200, height: 630 }
  : entry.data.heroImage
    ? {
        src: entry.data.heroImage.src,
        width: entry.data.heroImage.width,
        height: entry.data.heroImage.height,
      }
    : dedicatedOgExists
      ? { src: dedicatedOg, width: 1200, height: 630 }
      : { src: "/og/blog.png", width: 1200, height: 630 };
const articleLd = articleSchema({
  title: entry.data.title,
  description: entry.data.description,
  url: postUrl,
  datePublished: entry.data.pubDate,
  dateModified: entry.data.updatedDate,
  tags: entry.data.tags,
  image: new URL(social.src, SITE.url).toString(),
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  ogImage={social.src}
  ogImageAlt={entry.data.heroAlt ?? entry.data.title}
  ogImageWidth={social.width}
  ogImageHeight={social.height}
  jsonLd={[articleLd]}
>
  <article>
    <header class="border-b border-integra-gray-200 bg-integra-white">
      <div class="container-narrow py-16 lg:py-20">
        <Breadcrumbs leaf={entry.data.title} />
        <p
          class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3"
        >
          Artigo técnico
          {entry.data.tags.length > 0 && (
            <span> · {entry.data.tags.join(" · ")}</span>
          )}
        </p>
        <h1
          class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl mb-6"
        >
          {entry.data.title}
        </h1>
        <p class="text-lg leading-relaxed text-integra-gray-700 lg:text-xl">
          {entry.data.description}
        </p>
        <div class="mt-8 border-t border-integra-gray-200 pt-5 text-sm leading-relaxed text-integra-gray-600">
          <p>
            Por{" "}
            <a
              href={COLLECTIVE_AUTHOR.href}
              rel="author"
              class="font-semibold text-integra-gray-900 transition-colors hover:text-integra-red-700"
            >
              {entry.data.author}
            </a>
          </p>
          <p class="mt-1">
            Publicado em <time datetime={publishedDateIso}>{publishedDate}</time>
            {reviewedDate && reviewedDateIso && (
              <>
                <span aria-hidden="true"> · </span>
                Revisado em <time datetime={reviewedDateIso}>{reviewedDate}</time>
              </>
            )}
            <span aria-hidden="true"> · </span>
            <a
              href="/politica-editorial/"
              class="font-medium text-integra-red-700 hover:underline"
            >
              Política editorial
            </a>
          </p>
        </div>
      </div>
    </header>

    {entry.data.heroImage && (
      <div class="border-b border-integra-gray-200 bg-integra-gray-100">
        <div class="container-default py-8">
          <Image
            src={entry.data.heroImage}
            alt={entry.data.heroAlt ?? entry.data.title}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1024px) 1100px, 100vw"
            loading="eager"
            decoding="async"
            class="w-full rounded-lg"
          />
        </div>
      </div>
    )}

    <section class="border-b border-integra-gray-200">
      <div class="container-narrow py-16 lg:py-20">
        <div
          class="prose prose-lg max-w-none prose-headings:text-integra-gray-900 prose-a:text-integra-red-700 hover:prose-a:underline prose-strong:text-integra-gray-900 prose-code:bg-integra-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded-sm prose-code:text-sm prose-blockquote:border-l-integra-red prose-blockquote:bg-integra-gray-50 prose-blockquote:p-4 prose-blockquote:rounded-md prose-blockquote:not-italic"
        >
          <Content components={{ aside: TechnicalCallout }} />
        </div>
      </div>
    </section>
  </article>

  <CtaBlock
    title="Quer aplicar isso na sua operação?"
    description="Quando a teoria encontra a planta, surgem as perguntas certas. Conversamos sobre arquitetura, normas e decisões técnicas em qualquer estágio do projeto."
    variant="dark"
  />
</BaseLayout>
