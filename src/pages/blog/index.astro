---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import { Icon } from "astro-icon/components";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const recentEventos = (await getCollection("eventos", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });

const integraAcaoFormatos = [
  {
    icon: "lucide:mail",
    eyebrow: "Newsletter técnica",
    title: "Curadoria técnica na caixa de entrada",
    href: "/integra-acao/newsletter/",
    cta: "Inscrever-se",
  },
  {
    icon: "lucide:video",
    eyebrow: "Webinars técnicos",
    title: "Sessões em preparação, com agenda confirmada",
    href: "/integra-acao/webinar/",
    cta: "Ver formato",
  },
  {
    icon: "lucide:calendar-days",
    eyebrow: "Eventos presenciais",
    title: "Onde a equipe Integra esteve recentemente",
    href: "/eventos/",
    cta: "Ver eventos",
  },
];
---

<BaseLayout
  title="Blog técnico de automação industrial"
  description="Artigos técnicos sobre PlantPAx, FactoryTalk, redes industriais, IEC 62443, migração de PLC e governança de engenharia industrial."
  ogImage="/og/blog.png"
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20 lg:py-24">
      <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
        Blog técnico
      </p>
      <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
        Blog de automação industrial.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
        Publicamos análises para esclarecer arquiteturas, normas e decisões que
        aparecem no dia a dia das plantas industriais. O conteúdo é educativo,
        baseado em fontes e produzido por uma empresa que também presta os
        serviços relacionados — vínculo que tratamos com transparência.
      </p>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      {posts.length === 0 ? (
        <p class="text-base text-integra-gray-700 text-center py-12">
          Artigos sendo publicados em breve.
        </p>
      ) : (
        <ul class="grid gap-px bg-integra-gray-200 rounded-lg overflow-hidden">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}/`}
                class="group block bg-integra-white p-7 lg:p-8 hover:bg-integra-gray-50 transition-colors"
              >
                <div class="grid gap-4 lg:grid-cols-[1fr_auto] lg:items-center">
                  <div>
                    <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-2">
                      {dateFmt(post.data.pubDate)}
                      {post.data.tags.length > 0 && (
                        <>
                          {" · "}
                          {post.data.tags.slice(0, 3).join(" · ")}
                        </>
                      )}
                    </p>
                    <h2 class="text-xl font-semibold text-integra-gray-900 group-hover:text-integra-red-700 transition-colors mb-2 max-w-2xl">
                      {post.data.title}
                    </h2>
                    <p class="text-sm leading-relaxed text-integra-gray-700 max-w-2xl">
                      {post.data.description}
                    </p>
                  </div>
                  <span
                    class="text-integra-gray-400 group-hover:text-integra-red-700 transition-colors lg:self-center"
                    aria-hidden="true"
                  >
                    <svg
                      class="size-6"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7 17L17 7M17 7H8M17 7v9"
                      />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
      <p class="mt-8 text-xs font-mono uppercase tracking-wider text-integra-gray-500">
        <a href="/rss.xml" class="hover:text-integra-red-700 transition-colors">
          RSS Feed →
        </a>
      </p>
    </div>
  </section>

  <!-- Integra Ação umbrella brand -->
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20">
      <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
            Marca de conteúdo · Integra Ação
          </p>
          <h2 class="text-3xl font-semibold text-integra-gray-900 sm:text-4xl mb-6">
            Conteúdo técnico em três formatos.
          </h2>
          <p class="text-base leading-relaxed text-integra-gray-700 lg:text-lg mb-6">
            Integra Ação é a marca guarda-chuva da Integra Automação para
            conteúdo educativo. Mesma profundidade técnica do nosso trabalho
            de engenharia, em formato escrito, em vídeo e em encontros
            presenciais.
          </p>
          <a
            href="/integra-acao/"
            class="inline-flex items-center gap-2 text-sm font-semibold text-integra-red-700 hover:text-integra-red-700"
          >
            Conhecer Integra Ação <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="grid gap-4">
          {integraAcaoFormatos.map((f) => (
            <a
              href={f.href}
              class="group rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-5 flex items-start gap-4 hover:border-integra-gray-900 transition-colors"
            >
              <div class="inline-flex size-10 shrink-0 items-center justify-center rounded-md bg-integra-gray-900 text-integra-white group-hover:bg-integra-red transition-colors">
                <Icon name={f.icon} class="size-5" aria-hidden="true" />
              </div>
              <div class="flex-1">
                <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-1">
                  {f.eyebrow}
                </p>
                <p class="text-base font-semibold text-integra-gray-900 group-hover:text-integra-red-700 transition-colors leading-snug">
                  {f.title}
                </p>
              </div>
              <span
                class="text-integra-gray-400 group-hover:text-integra-red-700 transition-colors mt-1"
                aria-hidden="true"
              >→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {recentEventos.length > 0 && (
    <section class="border-b border-integra-gray-200 bg-integra-gray-50">
      <div class="container-fluid py-20">
        <div class="flex items-end justify-between gap-6 mb-10 flex-wrap">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
              Eventos recentes
            </p>
            <h2 class="text-3xl font-semibold text-integra-gray-900 sm:text-4xl max-w-2xl">
              Onde a equipe Integra esteve.
            </h2>
          </div>
          <a
            href="/eventos/"
            class="inline-flex items-center gap-2 text-sm font-semibold text-integra-red-700 hover:text-integra-red-700"
          >
            Ver todos os eventos <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {recentEventos.map((e) => (
            <a
              href={`/eventos/${e.id}/`}
              class="group rounded-lg border border-integra-gray-200 bg-integra-white overflow-hidden hover:border-integra-gray-900 transition-colors"
            >
              <div class="aspect-[16/10] overflow-hidden bg-integra-gray-100">
                <Image
                  src={e.data.coverImage}
                  alt={e.data.coverAlt}
                  widths={[300, 600]}
                  sizes="(min-width: 1024px) 280px, (min-width: 768px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-5">
                <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-2">
                  {e.data.dateLabel}
                </p>
                <h3 class="text-sm font-semibold text-integra-gray-900 group-hover:text-integra-red-700 transition-colors leading-snug mb-1">
                  {e.data.title}
                </h3>
                <p class="text-xs text-integra-gray-500">
                  {e.data.location}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBlock
    title="Tem um tema técnico que gostaria de ver aqui?"
    description="Sugestões de artigos são bem-vindas, especialmente quando vêm de quem está em planta lidando com o problema diariamente."
    primaryCta={{ href: "/contato/?assunto=blog", label: "Sugerir tema" }}
    secondaryCta={{ href: "/integra-acao/newsletter/", label: "Inscrever-se na newsletter" }}
  />
</BaseLayout>
