---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";
import EventDate from "@/components/EventDate.astro";
import { SITE } from "@/utils/site";
import { eventSchema } from "@/utils/schema";

export async function getStaticPaths() {
  const eventos = await getCollection("eventos", ({ data }) => !data.draft);
  return eventos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const eventUrl = new URL(Astro.url.pathname, SITE.url).toString();
const eventLd = eventSchema({
  name: entry.data.title,
  description: entry.data.summary,
  url: eventUrl,
  startDate: entry.data.startDate,
  endDate: entry.data.endDate,
  status: entry.data.eventStatus,
  location: entry.data.location,
  organizer: entry.data.organizer,
  image: new URL(entry.data.coverImage.src, SITE.url).toString(),
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  ogType="article"
  ogImage={entry.data.coverImage.src}
  ogImageAlt={entry.data.coverAlt}
  jsonLd={[eventLd]}
>
  <article>
    <header class="border-b border-integra-gray-200 bg-integra-white">
      <div class="container-default py-16 lg:py-20">
        <Breadcrumbs leaf={entry.data.title} />
        <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
          <EventDate startDate={entry.data.startDate} endDate={entry.data.endDate} /> · {entry.data.location}
        </p>
        <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl mb-6">
          {entry.data.title}
        </h1>
        <p class="text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
          {entry.data.summary}
        </p>
        <p class="mt-6 text-sm text-integra-gray-600">
          <span class="font-mono uppercase tracking-wider text-xs text-integra-gray-500">Realização: </span>
          {entry.data.organizer}
        </p>
        {entry.data.tags.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2">
            {entry.data.tags.map((t) => (
              <li class="text-xs font-mono uppercase tracking-wider text-integra-gray-700 px-3 py-1.5 bg-integra-gray-100 rounded-sm border border-integra-gray-200">
                {t}
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="border-b border-integra-gray-200 bg-integra-gray-100">
      <div class="container-default py-8">
        <Image
          src={entry.data.coverImage}
          alt={entry.data.coverAlt}
          widths={[800, 1200, 1600]}
          sizes="(min-width: 1024px) 1100px, 100vw"
          loading="eager"
          decoding="async"
          class="w-full rounded-lg shadow-sm"
        />
      </div>
    </div>

    <section class="border-b border-integra-gray-200">
      <div class="container-narrow py-16 lg:py-20">
        <div class="prose prose-lg max-w-none prose-headings:text-integra-gray-900 prose-a:text-integra-red-700 hover:prose-a:underline prose-strong:text-integra-gray-900">
          <Content components={{ aside: TechnicalCallout }} />
        </div>
      </div>
    </section>

    {entry.data.gallery.length > 0 && (
      <section class="border-b border-integra-gray-200 bg-integra-gray-50">
        <div class="container-default py-16">
          <h2 class="text-xs font-mono uppercase tracking-widest text-integra-gray-500 mb-8">
            Galeria do evento
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {entry.data.gallery.map((img, i) => (
              <Image
                src={img}
                alt={`Registro ${i + 1} do ${entry.data.title}, em ${entry.data.location}`}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 350px, 50vw"
                loading="lazy"
                decoding="async"
                class="rounded-md w-full h-auto"
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <CtaBlock
    title="Capacitação contínua é parte do método"
    description="A Integra investe em treinamento e atualização técnica como rotina. Quer saber como isso reflete na engenharia entregue ao cliente?"
    primaryCta={{ href: "/contato/", label: "Falar com a Integra" }}
    secondaryCta={{ href: "/eventos/", label: "Ver outros eventos" }}
  />
</BaseLayout>
