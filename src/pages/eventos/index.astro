---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBlock from "@/components/CtaBlock.astro";

const eventos = (await getCollection("eventos", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
  title="Eventos"
  description="Eventos, treinamentos e conferências em que a Integra Automação Industrial participou, registro técnico de capacitação, parcerias e evolução do ecossistema industrial."
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20 lg:py-24">
      <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
        Eventos · Treinamentos · Conferências
      </p>
      <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
        Onde estivemos, o que aprendemos.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
        Capacitação contínua é parte do método. Aqui registramos os eventos
        e treinamentos em que a equipe Integra esteve presente, para que o
        cliente saiba que cada projeto entregue tem por trás um time atualizado
        nas tecnologias, fabricantes e normas que importam.
      </p>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      {eventos.length === 0 ? (
        <div class="text-center py-16">
          <p class="text-base text-integra-gray-700 max-w-md mx-auto">
            Eventos sendo publicados gradualmente. Acompanhe nosso
            <a href="https://www.linkedin.com/company/integrautomacao" rel="noopener noreferrer" class="text-integra-red-700 hover:underline">
              LinkedIn
            </a>
            para registros em tempo real.
          </p>
        </div>
      ) : (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {eventos.map((e) => (
            <article class="group rounded-lg border border-integra-gray-200 bg-integra-white overflow-hidden hover:border-integra-gray-900 transition-colors">
              <a href={`/eventos/${e.slug}/`} class="block">
                <div class="aspect-[16/10] overflow-hidden bg-integra-gray-100">
                  <Image
                    src={e.data.coverImage}
                    alt={e.data.coverAlt}
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
                <div class="p-6">
                  <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-2">
                    {e.data.dateLabel}
                  </p>
                  <h2 class="text-lg font-semibold text-integra-gray-900 mb-2 group-hover:text-integra-red-700 transition-colors leading-snug">
                    {e.data.title}
                  </h2>
                  <p class="text-xs font-mono uppercase tracking-wider text-integra-gray-500 mb-3">
                    {e.data.location}
                  </p>
                  <p class="text-sm leading-relaxed text-integra-gray-700 mb-4">
                    {e.data.summary}
                  </p>
                  {e.data.tags.length > 0 && (
                    <ul class="flex flex-wrap gap-2 pt-3 border-t border-integra-gray-100">
                      {e.data.tags.slice(0, 4).map((t) => (
                        <li class="text-[11px] font-mono uppercase tracking-wider text-integra-gray-500 px-2 py-1 bg-integra-gray-50 rounded-sm">
                          {t}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <CtaBlock
    title="Quer encontrar a equipe Integra em algum evento?"
    description="Acompanhamos as principais agendas técnicas brasileiras e da América Latina. Se vamos cruzar caminho em alguma conferência, fale conosco."
    primaryCta={{ href: "/contato", label: "Falar com a Integra" }}
    secondaryCta={{ href: "/blog", label: "Ver blog técnico" }}
  />
</BaseLayout>
