---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import TechnicalCallout from "@/components/TechnicalCallout.astro";
import { Image } from "astro:assets";
import integratorManifestoPost from "@/assets/manuals/integra-system-integrator-linkedin.jpg";
import telitPartnerPost from "@/assets/manuals/telit-devicewise-partner-linkedin.jpg";

const programs = [
  {
    id: "rockwell",
    title: "Rockwell Automation Partner Network",
    summary:
      "Programa oficial da Rockwell para integradores qualificados. É o eixo principal da Integra em automação industrial, com acesso a treinamentos, suporte técnico de produto e canais de coordenação técnica direta.",
    items: [
      "Silver System Integrator",
      "PlantPAx DCS Certified Partner",
      "Disciplinas: Control · Visualization · Process · Power",
    ],
    note: "Status atual e nível verificáveis no Rockwell PartnerLocator.",
    cta: {
      href: "/certificacoes/silver-system-integrator",
      label: "Conhecer Silver System Integrator",
    },
  },
  {
    id: "plantpax-dcs",
    title: "PlantPAx DCS Certified Partner",
    summary:
      "Certificação adicional reservada a integradoras com domínio completo da plataforma de controle distribuído moderna da Rockwell Automation.",
    items: [
      "Acesso direto à engenharia de produto PlantPAx",
      "Atualização contínua nas versões 3.x, 4.x e 5.x",
      "Participação em laboratórios oficiais",
    ],
    cta: {
      href: "/solucoes/plantpax",
      label: "Ver atuação em PlantPAx",
    },
  },
  {
    id: "telit-devicewise",
    title: "Telit Cinterion, integrador TC deviceWISE",
    summary:
      "Parceria formal para aplicação da plataforma TC deviceWISE em projetos IIoT, edge gateways e integração OT/IT. É a segunda frente formal da Integra, complementar ao foco Rockwell.",
    items: [
      "TC deviceWISE para integração industrial e IIoT",
      "Edge + cloud, drivers industriais e fluxos no-code",
      "Conectividade multi-vendor: PLCs, sensores, bancos, APIs e MQTT",
    ],
    note: "Parceria pública divulgada pela Telit Cinterion e pela Integra. Escopo técnico deve sempre ser aplicado por diagnóstico de arquitetura.",
    cta: {
      href: "/tecnologias/tc-devicewise",
      label: "Ver tecnologia deviceWISE",
    },
  },
  {
    id: "cisco",
    title: "Cisco Networking Academy",
    summary:
      "Capacitação reconhecida em redes, infraestrutura e segurança de redes industriais. Aplicada nos projetos de CPwE e cibersegurança OT.",
    items: [
      "Industrial Networking Essentials",
      "Industrial IoT and Control Systems in Manufacturing",
      "CCNA Routing & Switching (membros da equipe)",
    ],
  },
  {
    id: "siemens",
    title: "Siemens, capacitação e tecnologias atendidas",
    summary:
      "Experiência e capacitação técnica em ferramentas Siemens usadas em plantas industriais. Não representa programa formal de integrador certificado Siemens.",
    items: [
      "TIA Portal, SIMATIC Manager / STEP 7 Classic e WinCC",
      "Treinamento em SIMATIC PCS 7 V9",
      "Industrial Networks Certification (CPIN-Level)",
    ],
    cta: {
      href: "/tecnologias/tia-portal",
      label: "Ver tecnologias Siemens",
    },
  },
  {
    id: "isa",
    title: "ISA (International Society of Automation)",
    summary:
      "Participação ativa na ISA, sociedade internacional de automação que mantém os padrões ISA-95, ISA-88, ISA-101, ISA-18.2 e ISA/IEC 62443.",
    items: ["ISA Senior Member", "Standards Committee (participação)"],
  },
];
---

<BaseLayout
  title="Certificações e Parcerias"
  description="Parcerias, certificações e capacitações da Integra: Rockwell Automation Partner Network, PlantPAx DCS, Telit Cinterion TC deviceWISE, Cisco, Siemens e ISA."
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20 lg:py-24">
      <p class="text-xs font-mono uppercase tracking-widest text-integra-red mb-3">
        Certificações e parcerias
      </p>
      <h1 class="text-4xl font-semibold text-integra-gray-900 sm:text-5xl max-w-3xl">
        Credibilidade verificável, sem misturar selo com experiência.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-integra-gray-700 max-w-3xl lg:text-xl">
        A Integra separa parcerias formais, certificações, capacitações e
        tecnologias atendidas. Rockwell Automation continua no centro do
        posicionamento; Telit Cinterion deviceWISE entra como parceria formal
        de IIoT; Siemens, Elipse e Schneider aparecem no catálogo técnico como
        tecnologias multi-vendor atendidas com responsabilidade.
      </p>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Base verificável"
        title="Parcerias formais, certificações e capacitações"
        description="Cada item abaixo indica o que é programa formal, certificação, capacitação ou tecnologia atendida. A transparência evita prometer mais do que a engenharia consegue sustentar."
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2">
        {programs.map((p) => (
          <article
            id={p.id}
            class="rounded-lg border border-integra-gray-200 bg-integra-white p-7 scroll-mt-24"
          >
            <h3 class="text-xl font-semibold text-integra-gray-900 mb-3">
              {p.title}
            </h3>
            <p class="text-sm leading-relaxed text-integra-gray-700 mb-5">
              {p.summary}
            </p>
            <ul class="space-y-2 border-t border-integra-gray-100 pt-4">
              {p.items.map((item) => (
                <li class="flex items-start gap-2 text-sm text-integra-gray-900">
                  <span class="text-integra-red mt-1" aria-hidden="true">›</span>
                  {item}
                </li>
              ))}
            </ul>
            {p.note && (
              <p class="mt-4 text-xs italic text-integra-gray-500">
                {p.note}
              </p>
            )}
            {p.cta && (
              <a
                href={p.cta.href}
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-integra-red hover:text-integra-red-700"
              >
                {p.cta.label}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Bandeira Integra"
        title="Integrador de sistemas é quem transforma tecnologia em planta funcionando"
        description="O valor da Integra não está em repetir brochure de fabricante. Está em guiar o cliente por um ecossistema complexo, escolher o caminho técnico correto, integrar equipamentos diferentes e deixar o sistema operável, documentado e sustentável."
        accent={true}
      />

      <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
        <article class="rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-7">
          <p class="mb-3 font-mono text-xs uppercase tracking-widest text-integra-red">
            Orgulho de ser integrador
          </p>
          <h2 class="text-2xl font-semibold text-integra-gray-900">
            A Integra conecta fabricantes, softwares, redes e pessoas.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-integra-gray-700">
            Em uma planta real, raramente existe uma única tecnologia. Há CLPs
            Rockwell e Siemens, supervisórios FactoryTalk, Elipse ou Schneider,
            gateways IIoT, redes industriais, bancos, servidores, painéis e
            equipes de operação e manutenção. O integrador organiza esse
            conjunto para que ele funcione com segurança e possa ser mantido.
          </p>
          <ul class="mt-6 space-y-3 border-t border-integra-gray-200 pt-5">
            {[
              "Traduzir necessidade de produção em arquitetura técnica.",
              "Escolher tecnologia pelo contexto da planta, não por preferência de catálogo.",
              "Garantir testes, documentação, backup, handover e suporte.",
              "Preservar confidencialidade quando o projeto exige NDA.",
            ].map((item) => (
              <li class="flex gap-2 text-sm leading-relaxed text-integra-gray-900">
                <span class="mt-0.5 text-integra-red" aria-hidden="true">›</span>
                {item}
              </li>
            ))}
          </ul>
        </article>

        <div class="grid gap-6 md:grid-cols-2">
          <figure class="overflow-hidden rounded-lg border border-integra-gray-200 bg-integra-white shadow-lg">
            <Image
              src={integratorManifestoPost}
              alt="Publicação da Integra sobre o orgulho de ser integrador de sistemas"
              widths={[420, 640, 900]}
              sizes="(min-width: 1024px) 340px, 100vw"
              class="h-auto max-h-[30rem] w-full object-contain"
            />
            <figcaption class="border-t border-integra-gray-200 p-4 text-xs leading-relaxed text-integra-gray-600">
              Publicação institucional usada como base editorial para reforçar
              a bandeira de integrador de sistemas.
            </figcaption>
          </figure>

          <figure class="overflow-hidden rounded-lg border border-integra-gray-200 bg-integra-white shadow-lg">
            <Image
              src={telitPartnerPost}
              alt="Publicação sobre a Integra como parceira Telit Cinterion deviceWISE"
              widths={[420, 640, 900]}
              sizes="(min-width: 1024px) 340px, 100vw"
              class="h-auto max-h-[30rem] w-full object-contain"
            />
            <figcaption class="border-t border-integra-gray-200 p-4 text-xs leading-relaxed text-integra-gray-600">
              Registro público da parceria Telit Cinterion/deviceWISE,
              aplicada a projetos IIoT e integração OT/IT.
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200">
    <div class="container-fluid py-20 max-w-4xl">
      <TechnicalCallout variant="note" title="Política de transparência">
        <p>
          Listamos como certificação ou parceria formal apenas o que pode ser
          comprovado em programa oficial, documento público ou comunicação
          validável do fabricante. Siemens, Elipse e Schneider aparecem como
          tecnologias atendidas, não como selo de integrador certificado.
          Não usamos logos como decoração: cada claim precisa ter escopo,
          nível e contexto corretos.
        </p>
      </TechnicalCallout>
    </div>
  </section>

  <CtaBlock
    variant="dark"
    title="Quer validar uma parceria ou tecnologia atendida?"
    description="Encaminhamos comprovantes oficiais quando aplicável e explicamos o escopo técnico real de cada frente antes de qualquer qualificação."
    primaryCta={{ href: "/contato?assunto=certificacoes", label: "Solicitar comprovação" }}
  />
</BaseLayout>
