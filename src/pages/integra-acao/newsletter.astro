---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import NewsletterForm from "@/components/NewsletterForm.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import { faqSchema } from "@/utils/schema";

const temas = [
  {
    code: "01",
    titulo: "PlantPAx 5.x, arquitetura DCS moderna",
    desc: "Quando faz sentido migrar de View SE legado, recursos que exigem controladores process compatíveis, biblioteca de objetos e dimensionamento de PASS-C e PASS distribuído.",
  },
  {
    code: "02",
    titulo: "CPwE / IEC 62443, redes industriais seguras",
    desc: "Zonas e conduítes na prática, análise de risco, arquiteturas com IDMZ quando aplicáveis e critérios para definir SL-T por zona.",
  },
  {
    code: "03",
    titulo: "Migração PLC-5 / SLC 500, modernização sem improviso",
    desc: "Translation Tool vs reescrita de lógica, reaproveitamento de fiação 1492, janelas de cutover por área, plano de rollback e ambiente espelho.",
  },
  {
    code: "04",
    titulo: "FactoryTalk View SE, supervisão crítica",
    desc: "Servidores Site Edition, redundância de Directory e HMI Server, governança de alarmes ISA-18.2, padrão de telas e estados de equipamento.",
  },
  {
    code: "05",
    titulo: "O papel do integrador, engenharia que sustenta a planta",
    desc: "Por que método importa mais que ferramenta, como cobrar isso de quem entrega, e o que muda quando a documentação é tratada como entrega de engenharia.",
  },
];

const faq = [
  {
    q: "Qual a periodicidade da newsletter?",
    a: "Periódica. Enviamos quando houver uma curadoria técnica consistente, sem preencher sua caixa de entrada apenas para cumprir calendário.",
  },
  {
    q: "Vou receber e-mail comercial além da newsletter?",
    a: "A inscrição é usada para a Integra Ação e comunicações diretamente relacionadas ao conteúdo. Não aciona follow-up comercial automático; uma conversa comercial só começa se você solicitar contato.",
  },
  {
    q: "Posso cancelar a inscrição?",
    a: "Sim. Cada edição inclui um link de descadastro. Os envios são interrompidos e podemos manter apenas o registro mínimo de opt-out necessário para evitar reenvios indevidos.",
  },
  {
    q: "Vocês compartilham meu e-mail com terceiros?",
    a: "Não vendemos nem cedemos a base para marketing de terceiros. O endereço é processado pelo Resend, operador usado para gerenciar contatos e envios, conforme a Política de Privacidade.",
  },
  {
    q: "Como funciona a confirmação da inscrição?",
    a: "Depois da submissão, o Resend pode processar o endereço para entregar o e-mail transacional. A inscrição só fica ativa após abrir esse e-mail e clicar em Confirmar inscrição. Antes da confirmação, o contato não é ativado na lista, no Segmento nem no Tópico configurado da newsletter. Link expirado exige uma nova submissão para gerar outra confirmação.",
  },
  {
    q: "É só para clientes da Integra?",
    a: "Não. Engenheiros, técnicos, gestores industriais e estudantes são bem-vindos. O conteúdo é educativo e deixa explícito quando uma análise parte do ecossistema Rockwell ou de outro fabricante.",
  },
];
---

<BaseLayout
  title="Newsletter Integra Ação"
  breadcrumbLeaf="Newsletter"
  description="Inscreva-se na newsletter Integra Ação: curadoria periódica sobre PlantPAx, redes industriais, IEC 62443 e engenharia."
  ogImage="/og/integra-acao-newsletter.png"
  jsonLd={[faqSchema(faq)]}
>
  <PageHero
    eyebrow="Integra Ação · Newsletter técnica"
    title="Conteúdo técnico quando houver algo que valha o envio."
    breadcrumbLeaf="Newsletter"
  >
    <p class="mt-6 mb-8 max-w-3xl text-lg leading-relaxed text-integra-gray-700 lg:text-xl">
      Inscreva-se para receber uma curadoria periódica sobre arquitetura
      industrial, redes, cibersegurança OT e governança de engenharia. A
      prioridade é conteúdo educativo, com vínculo comercial e recorte de
      fabricante indicados com transparência.
    </p>
    <ul class="space-y-3 text-sm text-integra-gray-700">
      <li class="flex items-start gap-2">
        <span class="text-integra-red-700 mt-0.5">·</span>
        Envios periódicos, somente quando a curadoria estiver pronta.
      </li>
      <li class="flex items-start gap-2">
        <span class="text-integra-red-700 mt-0.5">·</span>
        Conteúdo técnico em português, com referências validadas.
      </li>
      <li class="flex items-start gap-2">
        <span class="text-integra-red-700 mt-0.5">·</span>
        Cancelamento com um clique a qualquer momento.
      </li>
      <li class="flex items-start gap-2">
        <span class="text-integra-red-700 mt-0.5">·</span>
        Dados tratados apenas pela Integra e pelos operadores descritos na política.
      </li>
    </ul>
    <div slot="aside" class="rounded-lg border border-integra-gray-200 bg-integra-gray-50 p-7 lg:p-8 shadow-sm">
      <NewsletterForm />
    </div>
  </PageHero>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
        Cinco eixos editoriais
      </p>
      <h2 class="text-3xl font-semibold text-integra-gray-900 sm:text-4xl max-w-3xl mb-12">
        O que esperar nas primeiras edições.
      </h2>
      <ol class="grid gap-px overflow-hidden rounded-lg border border-integra-gray-200 bg-integra-gray-200 md:grid-cols-2">
        {temas.map((t) => (
          <li class="bg-integra-white p-7 flex gap-4">
            <span class="font-mono text-xs font-semibold text-integra-red-700 mt-1">
              {t.code}
            </span>
            <div>
              <h3 class="text-lg font-semibold text-integra-gray-900">
                {t.titulo}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-integra-gray-700">
                {t.desc}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20 max-w-3xl">
      <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-3">
        Perguntas frequentes
      </p>
      <h2 class="text-3xl font-semibold text-integra-gray-900 sm:text-4xl mb-10">
        O que costumam perguntar antes de inscrever.
      </h2>
      <div class="grid gap-px overflow-hidden rounded-lg border border-integra-gray-200 bg-integra-gray-200">
        {faq.map((f) => (
          <article class="bg-integra-white p-6">
            <h3 class="text-base font-semibold text-integra-gray-900 mb-2">
              {f.q}
            </h3>
            <p class="text-sm leading-relaxed text-integra-gray-700">
              {f.a}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBlock
    title="Prefere acompanhar pelo blog?"
    description="O blog é o repositório técnico aberto. A newsletter Integra Ação faz uma curadoria periódica das publicações mais relevantes."
    primaryCta={{ href: "/blog/", label: "Ir para o blog" }}
    secondaryCta={{ href: "/integra-acao/", label: "Voltar à Integra Ação" }}
  />
</BaseLayout>
