---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroIntegridade from "@/components/HeroIntegridade.astro";
import CredentialStrip from "@/components/CredentialStrip.astro";
import LifecycleRail from "@/components/LifecycleRail.astro";
import FeatureBlock from "@/components/FeatureBlock.astro";
import ManualReference from "@/components/ManualReference.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import rockwellSilver from "@/assets/logos/rockwell-si-silver.png";
import plantpaxReference from "@/assets/manuals/plantpax-reference-medium-pass.jpg";
import factorytalkReference from "@/assets/manuals/factorytalk-view-se-distributed-small.jpg";
import cpweReference from "@/assets/manuals/cpwe-ot-it-bridging.jpg";
import historianReference from "@/assets/manuals/factorytalk-historian-logical-diagram.jpg";
import devicewiseReference from "@/assets/manuals/devicewise-eletronor-architecture.jpg";

const values = [
  {
    icon: "lucide:shield",
    title: "Segurança Estrutural",
    description:
      "Arquiteturas dimensionadas segundo as melhores práticas do fabricante e normas internacionais. A garantia de que a planta não vai parar por falhas sistêmicas evitáveis.",
  },
  {
    icon: "lucide:file-cog",
    title: "Governança Técnica",
    description:
      "Sistemas que qualquer engenheiro qualificado pode manter no futuro, graças à padronização e à documentação criteriosa de cada entrega.",
  },
  {
    icon: "lucide:heart-handshake",
    title: "Paz de Espírito",
    description:
      "Para o gerente de manutenção e o gerente de produção: a segurança de saber que o sistema é confiável, documentado e suportado por especialistas sérios.",
  },
];

const evidence = [
  {
    label: "Arquitetura",
    title: "Dimensionamento antes da programação",
    text: "Cada projeto nasce com mapa de servidores, controladores, redes, estações, historian e responsabilidades de suporte.",
  },
  {
    label: "Padrão",
    title: "Objetos, telas e alarmes com governança",
    text: "PlantPAx Library, padrões HMI, ISA-18.2 e nomenclatura de tags entram como premissas de engenharia, não como ajuste final.",
  },
  {
    label: "Segurança",
    title: "OT segmentado por zonas e conduítes",
    text: "CPwE, Purdue, IDMZ, VLANs, ACLs, firewall industrial e práticas IEC 62443 para reduzir risco de parada e acesso indevido.",
  },
  {
    label: "Dados & IIoT",
    title: "Historian, borda e contexto operacional",
    text: "FactoryTalk Historian, ThingWorx, Kepware, DataMosaix e gateways industriais entram quando a planta precisa transformar dados em decisão.",
  },
  {
    label: "Batch",
    title: "Receitas, fases e rastreabilidade",
    text: "FactoryTalk Batch, ISA-88, PhaseManager, logs de execução e integração MES/ERP sustentam repetibilidade e rastreabilidade de processos em batelada.",
  },
  {
    label: "Handover",
    title: "Entrega que a planta consegue manter",
    text: "Data book, as-built, FAT/SAT, treinamento e critérios de aceite deixam o conhecimento explícito para operação e manutenção.",
  },
];
---

<BaseLayout
  title="Tecnologia e Engenharia de Sistemas Industriais"
  description="Engenharia e integração de sistemas industriais para plantas críticas: PlantPAx, FactoryTalk, redes industriais e cibersegurança OT, com método e documentação."
>
  <HeroIntegridade
    eyebrow="Engenharia com Integridade"
    title="Sistemas industriais"
    highlight="seguros, estruturados e mantíveis."
    description="A Integra não vende apenas programação ou telas de supervisão. Entregamos arquitetura, governança de engenharia e responsabilidade técnica do projeto ao handover, do start-up ao suporte contínuo."
    primaryCta={{ href: "/contato", label: "Falar com especialista" }}
    secondaryCta={{ href: "/solucoes", label: "Ver soluções" }}
    heroImage={plantpaxReference}
    heroAlt="Arquitetura de referência PlantPAx para sistema DCS"
  />

  <!-- Rockwell Silver System Integrator highlight -->
  <section class="border-y border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-12 lg:py-14">
      <a
        href="/certificacoes/silver-system-integrator"
        class="group grid gap-8 items-center lg:grid-cols-[auto_1fr_auto]"
      >
        <div class="flex justify-center lg:justify-start">
          <Image
            src={rockwellSilver}
            alt="Silver System Integrator, A Rockwell Automation Partner"
            class="h-20 lg:h-24 w-auto"
            widths={[200, 320, 480]}
            sizes="(min-width: 1024px) 320px, 240px"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="text-center lg:text-left">
          <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-2">
            Parceria Estratégica · Rockwell Automation
          </p>
          <h2 class="text-xl font-semibold text-integra-gray-900 lg:text-2xl">
            Certificação Silver System Integrator com especialidade PlantPAx DCS Certified
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-integra-gray-700 lg:text-base max-w-2xl">
            Membro oficial do programa Rockwell Automation Partner Network
            com disciplinas Control, Visualization, Process e Power.
          </p>
        </div>
        <span class="hidden lg:inline-flex items-center gap-2 text-sm font-semibold text-integra-red-700 group-hover:text-integra-red-700 transition-colors shrink-0">
          Conhecer parceria
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <CredentialStrip />

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-10 py-16 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:py-20">
      <div>
        <p class="mb-3 text-xs font-mono uppercase tracking-widest text-integra-red-700">
          Integrador de sistemas
        </p>
        <h2 class="text-3xl font-semibold text-integra-gray-900 sm:text-4xl">
          Rockwell no centro. deviceWISE e multi-vendor onde a planta exige.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-integra-gray-700 lg:text-lg">
          A Integra carrega com orgulho a bandeira de integradora de sistemas:
          guiar o cliente entre fabricantes, redes, softwares, versões legadas
          e novas plataformas sem perder segurança, documentação e manutenção.
          Além da parceria Rockwell, atuamos com TC deviceWISE em IIoT e
          atendemos tecnologias Siemens, Elipse E3 e Schneider quando a base da
          planta pede integração multi-vendor.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          {[
            { href: "/tecnologias/tc-devicewise", label: "TC deviceWISE" },
            { href: "/tecnologias/tia-portal", label: "Siemens" },
            { href: "/tecnologias/elipse-e3", label: "Elipse E3" },
            { href: "/tecnologias/schneider-control-expert", label: "Schneider" },
          ].map((item) => (
            <a
              href={item.href}
              class="inline-flex items-center rounded-md border border-integra-gray-300 px-4 py-2 text-sm font-semibold text-integra-gray-900 transition-colors hover:border-integra-red hover:text-integra-red-700"
            >
              {item.label}
              <span class="ml-1.5" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
      <ManualReference
        image={devicewiseReference}
        alt="Plataforma IIoT deviceWISE: dispositivos de produção, deviceWISE VIEW, dashboards em nuvem (Azure, GCP, AWS) e integração com sistemas empresariais (SAP, Oracle, MES, ERP)"
        title="Arquitetura deviceWISE: do chão de fábrica aos sistemas empresariais"
        source="Telit Cinterion + Eletronor · Eletroday (apresentação institucional)"
        caption="Referência pública usada para explicar gateway industrial, conectividade multi-vendor, edge, cloud e integração de dados com sistemas externos."
      />
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-16 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.4fr] lg:items-start">
        <div>
          <p class="mb-4 text-xs font-mono uppercase tracking-widest text-integra-red-700">
            Dos manuais para a planta
          </p>
          <h2 class="text-3xl font-semibold text-integra-gray-900 sm:text-4xl">
            Conteúdo técnico visível, sem parecer brochure de fabricante.
          </h2>
          <p class="mt-5 text-base leading-relaxed text-integra-gray-700 lg:text-lg">
            Os materiais públicos de Rockwell, Cisco e AVEVA são usados como
            base de validação técnica. No site, eles viram linguagem própria:
            diagramas limpos, entregáveis claros e explicações que conectam
            arquitetura à responsabilidade operacional da Integra.
          </p>
        </div>
        <div class="grid gap-px overflow-hidden rounded-lg border border-integra-gray-200 bg-integra-gray-200 sm:grid-cols-2 lg:grid-cols-3">
          {evidence.map((item) => (
            <article class="bg-integra-gray-50 p-6">
              <p class="mb-3 font-mono text-[11px] uppercase tracking-widest text-integra-red-700">
                {item.label}
              </p>
              <h3 class="text-lg font-semibold text-integra-gray-900">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">
                {item.text}
              </p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-16 lg:py-20">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-mono uppercase tracking-widest text-integra-red-700">
          Referências visuais públicas
        </p>
        <h2 class="text-3xl font-semibold text-integra-gray-900 sm:text-4xl">
          Referências visuais públicas conectadas ao que entregamos.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-integra-gray-700 lg:text-lg">
          Em vez de ilustrações genéricas, o site passa a mostrar arquiteturas,
          fluxos e diagramas públicos dos fabricantes, sempre
          com contexto técnico e sem expor propostas, clientes ou informações
          comerciais.
        </p>
      </div>
      <div class="grid gap-6 lg:grid-cols-3">
        <ManualReference
          image={plantpaxReference}
          alt="Arquitetura média PlantPAx com PASS, servidores, estações e controladores"
          title="PlantPAx Reference Architecture"
          source="Rockwell Automation · PlantPAx 5.40 Reference Architectures"
          caption="Usado como referência visual para explicar sizing de PASS, servidores, estações de operação, historian e controladores."
        />
        <ManualReference
          image={factorytalkReference}
          alt="Arquitetura FactoryTalk View SE distribuída"
          title="FactoryTalk View SE distribuído"
          source="Rockwell Automation · FactoryTalk View SE Reference Architectures"
          caption="Ajuda a demonstrar como supervisão, servidores HMI, data servers e clientes devem ser organizados por arquitetura."
        />
        <ManualReference
          image={cpweReference}
          alt="Arquitetura CPwE mostrando ponte entre OT e IT"
          title="CPwE e segmentação OT/IT"
          source="Cisco + Rockwell Automation · CPwE Deep Dive"
          caption="Referência visual para falar de Purdue, IDMZ, zonas industriais, infraestrutura gerenciada e defense-in-depth."
          theme="ot"
        />
      </div>
    </div>
  </section>

  <section class="bg-premium-dark text-integra-white">
    <div class="container-fluid py-20 lg:py-28">
      <div class="max-w-3xl mb-14">
        <p class="text-xs font-mono uppercase tracking-widest text-integra-red-300 mb-4">
          O que entregamos
        </p>
        <h2 class="text-4xl font-semibold sm:text-5xl">
          Três ativos intangíveis de alto valor
        </h2>
        <p class="mt-6 text-base lg:text-lg text-integra-gray-300 leading-relaxed">
          Quando uma planta industrial madura contrata um integrador, não está
          comprando horas técnicas. Está comprando a certeza de que o sistema
          entregue vai funcionar com estabilidade por anos, com documentação
          clara e parceiro presente quando a planta precisar.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {values.map((value, i) => (
          <article
            class="group relative h-full rounded-lg border border-integra-gray-800 bg-premium-dark-card p-7 hover:-translate-y-1 hover:border-integra-red/60 hover:shadow-2xl hover:shadow-integra-red/[0.04] transition-all duration-300 ease-out"
          >
            <span
              class="absolute -top-3 -right-3 inline-flex size-7 items-center justify-center rounded-full border border-integra-gray-700 bg-integra-gray-950 text-xs font-mono font-semibold text-integra-gray-400 group-hover:border-integra-red/40 group-hover:text-integra-red-700 transition-all duration-300"
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="inline-flex size-12 items-center justify-center rounded-md bg-integra-red text-integra-white mb-5 group-hover:scale-105 transition-transform duration-300">
              <svg
                class="size-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                {i === 0 && (
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                )}
                {i === 1 && (
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                )}
                {i === 2 && (
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                )}
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-integra-white mb-3">
              {value.title}
            </h3>
            <p class="text-sm leading-relaxed text-integra-gray-300">
              {value.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FeatureBlock
    eyebrow="Plataforma · DCS Moderno"
    title="PlantPAx: arquitetura plant-wide com biblioteca padronizada"
    description="O sistema de controle distribuído moderno da Rockwell Automation. Atuamos em todas as versões da plataforma, com profundidade técnica em PlantPAx 3.x, 4.x e 5.x, sempre alinhados ao System Reference Manual."
    bullets={[
      "Biblioteca de objetos de processo (PlantPAx Library) padronizada",
      "Controladores ControlLogix (incluindo série P) e CompactLogix",
      "Servidores virtualizados com redundância opcional por camada",
      "Integração OPC UA + AF Templates para PI System / AVEVA",
    ]}
    image={plantpaxReference}
    imageAlt="Arquitetura média PlantPAx com PASS e estações"
    imagePosition="right"
    primaryCta={{ href: "/solucoes/plantpax", label: "Conhecer PlantPAx" }}
    secondaryCta={{ href: "/contato?assunto=plantpax", label: "Falar sobre projeto" }}
    variant="light"
  />

  <FeatureBlock
    eyebrow="Suíte · Supervisão e Informação"
    title="FactoryTalk: do chão de fábrica ao dashboard executivo"
    description="View SE, Optix, Batch, Historian, AssetCentre e ThinManager configurados como suíte coesa. Governança de alarmes ISA-18.2, padronização de telas e auditoria de mudanças."
    bullets={[
      "<strong>FactoryTalk View SE</strong> e <strong>Optix</strong> para supervisão",
      "<strong>Batch</strong> conforme ISA-88 com receitas padronizadas",
      "<strong>Historian</strong> + <strong>AssetCentre</strong> com auditoria de mudanças",
      "<strong>ThinManager</strong> para gestão de thin clients industriais",
    ]}
    image={factorytalkReference}
    imageAlt="Arquitetura distribuída FactoryTalk View SE"
    imagePosition="left"
    primaryCta={{ href: "/solucoes/factorytalk", label: "Conhecer FactoryTalk" }}
    variant="light"
  />

  <FeatureBlock
    eyebrow="Cibersegurança OT · IEC 62443"
    title="Redes industriais que protegem a operação por design"
    description="Topologia, segmentação, switches Stratix/Cisco e arquiteturas alinhadas ao CPwE. Cibersegurança OT do projeto à operação, com defense-in-depth e zonas de segurança IEC 62443."
    bullets={[
      "Arquitetura CPwE (Converged Plantwide Ethernet)",
      "Segmentação Purdue + IDMZ entre IT e OT",
      "Anel DLR/PRP para alta disponibilidade",
      "Arquitetura orientada à IEC 62443 SL-T por zona + NIST SP 800-82",
    ]}
    image={cpweReference}
    imageAlt="Arquitetura CPwE mostrando integração OT e IT"
    imagePosition="right"
    primaryCta={{ href: "/solucoes/redes-iec-62443", label: "Ver cibersegurança OT" }}
    secondaryCta={{ href: "/contato?assunto=redes-cyber", label: "Solicitar diagnóstico" }}
    variant="ot"
  />

  <LifecycleRail />

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-10 py-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <p class="mb-3 text-xs font-mono uppercase tracking-widest text-integra-red-700">
          Dados e melhoria contínua
        </p>
        <h2 class="text-3xl font-semibold text-integra-gray-900 sm:text-4xl">
          Historian, borda, IIoT e rastreabilidade como parte da arquitetura.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-integra-gray-700 lg:text-lg">
          A Integra não atua só no controle. O escopo cobre FactoryTalk
          Historian, ThingWorx, Kepware, FactoryTalk Edge Gateway, DataMosaix,
          Batch, integração com MES/ERP, backup, virtualização e governança OT.
        </p>
        <a
          href="/solucoes/pi-system"
          class="mt-7 inline-flex items-center gap-2 rounded-md bg-integra-gray-900 px-6 py-3 text-sm font-semibold text-integra-white transition-colors hover:bg-integra-black"
        >
          Ver dados industriais
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <ManualReference
        image={historianReference}
        alt="Diagrama lógico FactoryTalk Historian com fontes de dados, coleta, servidor e apresentação"
        title="FactoryTalk Historian Logical Diagram"
        source="Rockwell Automation · FactoryTalk Historian Reference Architectures"
        caption="Referência visual para conectar coleta, armazenamento, apresentação, clientes e fontes de dados industriais."
      />
    </div>
  </section>

  <section class="border-y border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20 lg:py-28">
      <div class="max-w-3xl mb-14">
        <p class="text-xs font-mono uppercase tracking-widest text-integra-red-700 mb-4">
          Manifesto
        </p>
        <p class="text-3xl leading-snug text-integra-gray-900 sm:text-4xl lg:text-5xl">
          Acreditamos que por trás de toda grande indústria existe uma
          fundação invisível, feita de
          <span class="text-integra-red">rigor</span>,
          <span class="text-integra-red">disciplina</span> e pessoas que se
          importam de verdade com o que constroem.
        </p>
        <p class="mt-8 text-base leading-relaxed text-integra-gray-700 lg:text-lg max-w-2xl">
          Não trabalhamos apenas para resolver. Trabalhamos para transformar.
          Para que cada operação seja mais segura, mais previsível e pronta
          para crescer.
        </p>
        <p class="mt-8 font-mono text-xs uppercase tracking-widest text-integra-gray-500">
          Integra · Engenharia em Automação Industrial
        </p>
      </div>
    </div>
  </section>

  <CtaBlock variant="dark" />
</BaseLayout>
