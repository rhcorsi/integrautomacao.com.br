---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { itemListSchema, serviceSchema } from "@/utils/schema";
import { SITE } from "@/utils/site";
import { Icon } from "astro-icon/components";

const services = [
  {
    icon: "lucide:braces",
    name: "Programação de CLP e PLC",
    description: "Desenvolvimento, revisão e modernização de lógica com padrões de software, testes, versionamento e documentação para manutenção.",
    href: "/servicos/programacao-clp/",
  },
  {
    icon: "lucide:clipboard-check",
    name: "Comissionamento industrial",
    description: "Planejamento e execução de FAT, pré-comissionamento, SAT, startup, estabilização e handover com critérios de aceite rastreáveis.",
    href: "/servicos/comissionamento-industrial/",
  },
  {
    icon: "lucide:network",
    name: "Diagnóstico de redes industriais",
    description: "Inventário, topologia, coleta de evidências e análise de comunicação para separar sintomas de rede, aplicação, campo e infraestrutura.",
    href: "/tecnologias/monitoramento-redes-industriais/",
  },
  {
    icon: "lucide:refresh-cw",
    name: "Migração de controladores legados",
    description: "Inventário, conversão ou reengenharia, simulação, plano de cutover e rollback para modernizar PLC-5, SLC 500 e outras bases instaladas.",
    href: "/solucoes/migracao-plc/",
  },
  {
    icon: "lucide:file-check-2",
    name: "Auditoria técnica e conformidade",
    description: "Avaliação documentada de arquitetura, software, redes, backups, acessos, ciclo de vida e aderência às referências definidas no escopo.",
    href: "/tecnologias/auditoria-conformidade/",
  },
  {
    icon: "lucide:life-buoy",
    name: "Manutenção e suporte de automação",
    description: "Atuação corretiva, preventiva e evolutiva com priorização por criticidade, gestão de mudanças e transferência de conhecimento.",
    href: "/tecnologias/manutencao-corretiva-preventiva/",
  },
];

const selectionQuestions = [
  ["Qual problema precisa ser resolvido?", "Descrever sintomas, impacto operacional e comportamento esperado evita contratar uma ferramenta quando o problema ainda não foi diagnosticado."],
  ["Qual é a fronteira do sistema?", "Controlador, I/O, rede, HMI, servidores, historian, MES, painéis, instrumentação e processo podem pertencer a responsáveis diferentes."],
  ["Como o aceite será comprovado?", "Casos de teste, evidências, tolerâncias, documentos e responsáveis devem existir antes da partida, não apenas no encerramento."],
  ["Como a planta volta ao estado seguro?", "Intervenções brownfield exigem contingência, backup verificado, critérios de interrupção e plano de rollback proporcional ao risco."],
];

const pageUrl = new URL("/servicos/", SITE.url).toString();
---

<BaseLayout
  title="Serviços de Automação Industrial"
  description="Serviços de automação industrial: programação de CLP, comissionamento, redes, migração e documentação para plantas críticas. Comece pela triagem técnica."
  breadcrumbLeaf="Serviços de automação industrial"
  jsonLd={[
    serviceSchema({
      name: "Serviços de automação industrial",
      description: "Engenharia, programação, comissionamento, diagnóstico, modernização e sustentação de sistemas de automação industrial.",
      url: pageUrl,
    }),
    itemListSchema({
      // A lista é o catálogo de FRENTES de serviço: quatro delas têm sua
      // página de detalhe nas seções /tecnologias/ e /solucoes/ (a arquitetura
      // de informação do site documenta o serviço lá). O nome reflete isso
      // para o ItemList não prometer URLs exclusivas de /servicos/.
      name: "Catálogo de frentes de serviço de automação industrial",
      url: pageUrl,
      items: services.map((service) => ({
        name: service.name,
        description: service.description,
        url: new URL(service.href, SITE.url).toString(),
      })),
    }),
  ]}
>
  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid grid gap-10 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-end lg:py-24">
      <div>
        <p class="mb-3 text-xs font-mono uppercase tracking-widest text-integra-red-700">
          Serviços · engenharia de campo e software
        </p>
        <h1 class="max-w-4xl text-4xl font-semibold text-integra-gray-900 sm:text-5xl">
          Serviços de automação industrial para executar, validar e sustentar sistemas.
        </h1>
      </div>
      <p class="max-w-2xl text-lg leading-relaxed text-integra-gray-700">
        A Integra atua do diagnóstico ao pós-partida em sistemas Rockwell e
        ambientes multivendor. Cada serviço começa pela fronteira técnica,
        pelas responsabilidades e pelo critério de aceite — a base para que
        programação, campo e operação terminem falando sobre o mesmo sistema.
      </p>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-gray-50">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Escopo comercial"
        title="Encontre o serviço pelo trabalho que precisa ser feito"
        description="As páginas abaixo detalham atividades, insumos, entregáveis e interfaces. Soluções combinam vários serviços; tecnologias explicam as plataformas usadas na execução."
        accent={true}
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <article class="flex h-full flex-col rounded-lg border border-integra-gray-200 bg-integra-white p-7">
            <div class="inline-flex size-11 items-center justify-center rounded-md bg-integra-gray-900 text-integra-white">
              <Icon name={service.icon} class="size-5" aria-hidden="true" />
            </div>
            <h3 class="mt-5 text-xl font-semibold text-integra-gray-900">{service.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">{service.description}</p>
            <a href={service.href} class="mt-auto pt-6 text-sm font-semibold text-integra-red-700 hover:underline">
              Ver escopo e entregáveis →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-integra-gray-200 bg-integra-white">
    <div class="container-fluid py-20">
      <SectionHeader
        eyebrow="Contratação técnica"
        title="Quatro perguntas que tornam propostas comparáveis"
        description="Preço, prazo e plataforma só fazem sentido quando as premissas de engenharia e operação estão explícitas."
        accent={true}
      />
      <div class="grid gap-px overflow-hidden rounded-lg border border-integra-gray-200 bg-integra-gray-200 md:grid-cols-2">
        {selectionQuestions.map(([question, answer], index) => (
          <article class="bg-integra-gray-50 p-7">
            <p class="font-mono text-xs font-semibold text-integra-red-700">0{index + 1}</p>
            <h3 class="mt-3 text-xl font-semibold text-integra-gray-900">{question}</h3>
            <p class="mt-3 text-sm leading-relaxed text-integra-gray-700">{answer}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/automacao-industrial/" class="text-sm font-semibold text-integra-red-700 hover:underline">Entender a arquitetura completa →</a>
        <a href="/solucoes/" class="text-sm font-semibold text-integra-red-700 hover:underline">Ver soluções integradas →</a>
        <a href="/tecnologias/" class="text-sm font-semibold text-integra-red-700 hover:underline">Consultar o catálogo técnico →</a>
      </div>
    </div>
  </section>

  <CtaBlock
    title="Precisa transformar um problema de planta em escopo técnico?"
    description="A triagem identifica criticidade, base instalada, fronteira do sistema e evidências disponíveis. Quando é necessário levantamento documentado, o diagnóstico é proposto antes da execução."
    primaryCta={{ href: "/contato/?assunto=servicos-automacao", label: "Solicitar triagem técnica" }}
    secondaryCta={{ href: "/cases/", label: "Ver cases publicados" }}
  />
</BaseLayout>
