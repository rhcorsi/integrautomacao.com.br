---
import "@/styles/global.css";
import interLatinWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/utils/site";
import { organizationSchema, breadcrumbSchema } from "@/utils/schema";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  canonical?: string;
  bodyClass?: string;
  /** Schema.org blocks específicos da página (Article, Service, etc.). */
  jsonLd?: Record<string, unknown>[];
  /** Nome do nó-folha no breadcrumb (default: title). */
  breadcrumbLeaf?: string;
}

const {
  title,
  description = SITE.defaultDescription,
  ogImage: requestedOgImage,
  ogImageAlt,
  ogType = "website",
  noindex = false,
  canonical,
  bodyClass = "",
  jsonLd = [],
  breadcrumbLeaf,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.shortName}` : SITE.defaultTitle;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, SITE.url);
const ogImageBySection: Record<string, string> = {
  blog: "/og/blog.png",
  "automacao-industrial": "/og/solucoes.png",
  cases: "/og/cases.png",
  certificacoes: "/og/certificacoes.png",
  contato: "/og/contato.png",
  empresa: "/og/empresa.png",
  equipe: "/og/empresa.png",
  eventos: "/og/eventos.png",
  "integra-acao": "/og/integra-acao.png",
  setores: "/og/setores.png",
  servicos: "/og/solucoes.png",
  solucoes: "/og/solucoes.png",
  tecnologias: "/og/tecnologias.png",
};
const firstPathSegment = Astro.url.pathname.split("/").filter(Boolean)[0] ?? "";
const ogImage = requestedOgImage ?? ogImageBySection[firstPathSegment] ?? "/og/default.png";
const ogImageURL = new URL(ogImage, SITE.url);
const socialImageAlt = ogImageAlt ?? title ?? SITE.name;

// JSON-LD: Organization (sempre) + breadcrumb (automático, exceto na home) +
// schema específico da página. Data blocks (application/ld+json) não executam
// e não são afetados pelo script-src da CSP — dispensam nonce/hash.
const breadcrumb = noindex
  ? null
  : breadcrumbSchema(Astro.url.pathname, breadcrumbLeaf ?? title);
const jsonLdBlocks = [organizationSchema(), breadcrumb, ...jsonLd].filter(
  (b): b is Record<string, unknown> => Boolean(b),
);
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content={SITE.themeColor} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL.toString()} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Blog técnico ${SITE.name}`}
      href={new URL("/rss.xml", SITE.url).toString()}
    />

    {/* Fonte do texto LCP: preload do subset latin da Inter variável. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interLatinWoff2}
      crossorigin
    />

    {/* Performance hints: dns-prefetch barato e sitewide. O preconnect do
        Turnstile fica nos formulários que realmente o carregam. */}
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />

    {/* Resource hints, let the browser parallelize the layout/critical CSS fetch. */}
    <meta http-equiv="x-dns-prefetch-control" content="on" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex,nofollow" : "max-image-preview:large"}
    />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={ogImageURL.toString()} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.toString()} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- JSON-LD: Organization + breadcrumb + schema específico da página -->
    {jsonLdBlocks.map((block) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(block)}
      />
    ))}

    <slot name="head" />
  </head>

  <body
    class:list={[
      "min-h-screen flex flex-col bg-integra-white text-integra-gray-900 antialiased",
      bodyClass,
    ]}
  >
    <a class="skip-link" href="#main">Pular para o conteúdo</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/scripts/contact-context.js" defer></script>
  </body>
</html>
