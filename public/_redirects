# Path-based 301 redirects from the old WordPress site.
# Query-string redirects (?p=N, ?page_id=N, ?post_type=...) are handled
# by functions/_middleware.ts because CF Pages `_redirects` does not match
# against the query string.
#
# IMPORTANT: static rules must come BEFORE splat (*) rules, or wrangler
# warns about reduced performance.

# WP exact paths
/home-2                /                                    301
/home-2/               /                                    301
/wp-admin              /                                    301
/wp-login.php          /                                    301
/xmlrpc.php            /                                    301
/wp-json               /                                    301
/feed                  /rss.xml                             301
/feed/                 /rss.xml                             301
/comments/feed         /rss.xml                             301
/comments/feed/        /rss.xml                             301

# WP splats (taxonomies, archives, admin subpaths)
/category/*            /blog                                301
/tag/*                 /blog                                301
/author/*              /blog                                301
/20*/*                 /blog                                301
/portfolio-item/*      /cases                               301
/portfolio/*           /cases                               301
/wp-admin/*            /                                    301
/wp-login.php*         /                                    301
/wp-includes/*         /                                    301
/wp-content/uploads/*  /                                    301
/wp-json/*             /                                    301
