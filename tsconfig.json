{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["src/*"]
    },
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "types": ["astro/client", "@cloudflare/workers-types"]
  }
}
